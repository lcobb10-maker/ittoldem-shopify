<section class="itt-v3" id="IttV3-{{ section.id }}">
  <style>
    #IttV3-{{ section.id }}{--ink:#080808;--paper:#eee5d5;--white:#f7f2e8;background:var(--ink);color:var(--white);overflow:hidden}.itt-v3 *{box-sizing:border-box}.itt-v3 a{color:inherit;text-decoration:none}.itt-v3__kicker{font-size:.64rem;letter-spacing:.24em;text-transform:uppercase;opacity:.68}.itt-v3__title{margin:0;font-weight:500;letter-spacing:-.06em;line-height:.86;text-transform:uppercase;font-size:clamp(3.2rem,7vw,7.4rem)}
    .itt-v3__hero{position:relative;min-height:82svh;overflow:hidden;background:#111}.itt-v3__hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}.itt-v3__hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.78) 0%,rgba(0,0,0,.30) 48%,rgba(0,0,0,.04) 76%)}.itt-v3__hero-copy{position:relative;z-index:2;min-height:82svh;display:flex;flex-direction:column;justify-content:flex-end;padding:clamp(2rem,5vw,5rem);max-width:920px}.itt-v3__hero h1{margin:.8rem 0 1rem;font-size:clamp(4rem,10vw,9.5rem);font-weight:500;letter-spacing:-.06em;line-height:.82;text-transform:uppercase}.itt-v3__hero p{max-width:620px;margin:0 0 .5rem;font-size:clamp(.95rem,1.4vw,1.18rem);line-height:1.5;color:rgba(247,242,232,.8)}.itt-v3__cta{display:inline-flex;align-items:center;gap:.6rem;border:1px solid rgba(247,242,232,.55);padding:.8rem 1rem;margin:.7rem .45rem 0 0;font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;background:rgba(0,0,0,.28);backdrop-filter:blur(10px);transition:.25s}.itt-v3__cta:hover{background:var(--paper);color:#111}
    .itt-v3__edit{background:var(--paper);color:#111;padding:clamp(2.8rem,5vw,5rem)}.itt-v3__edit-head{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:1.6rem}.itt-v3__products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.itt-v3__product{display:block}.itt-v3__product-media{overflow:hidden;background:#d8d0c2}.itt-v3__product img{width:100%;aspect-ratio:4/5;display:block;object-fit:cover;transition:transform .5s ease}.itt-v3__product:hover img{transform:scale(1.035)}.itt-v3__product-meta{display:flex;justify-content:space-between;gap:1rem;padding-top:.72rem;font-size:.66rem;line-height:1.25;letter-spacing:.035em;text-transform:uppercase}.itt-v3__product-meta span:first-child{max-width:76%}
    .itt-v3__cinema{padding:clamp(3rem,6vw,6rem) clamp(1rem,4vw,4rem);border-top:1px solid rgba(255,255,255,.08)}.itt-v3__cinema-head{display:grid;grid-template-columns:1.15fr .85fr;align-items:end;gap:2rem;margin-bottom:2rem}.itt-v3__cinema-head p{max-width:34rem;margin:0 0 .2rem auto;color:rgba(247,242,232,.68);line-height:1.55}.itt-v3__reel{display:grid;grid-template-columns:1.25fr .85fr .85fr;gap:1rem}.itt-v3__film{position:relative;min-height:clamp(500px,60vw,780px);overflow:hidden;background:#151515;border:1px solid rgba(255,255,255,.12);isolation:isolate}.itt-v3__film video,.itt-v3__film img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.itt-v3__film:after{content:'';position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(0,0,0,.02) 35%,rgba(0,0,0,.84) 100%);pointer-events:none}.itt-v3__film-ui{position:absolute;z-index:2;left:1rem;right:1rem;bottom:1rem}.itt-v3__badge{display:inline-block;border:1px solid rgba(255,255,255,.5);padding:.4rem .58rem;font-size:.55rem;letter-spacing:.16em;text-transform:uppercase;background:rgba(0,0,0,.34)}.itt-v3__film-ui h3,.itt-v3__proof-ui h3{margin:.7rem 0 .35rem;text-transform:uppercase;line-height:.92;font-size:clamp(1.6rem,2.5vw,3rem)}.itt-v3__film-ui p,.itt-v3__proof-ui p{margin:0;color:rgba(247,242,232,.72);font-size:.78rem;line-height:1.45}.itt-v3__controls{display:flex;gap:.5rem;margin-top:.85rem}.itt-v3__control{border:1px solid rgba(255,255,255,.48);background:rgba(0,0,0,.35);color:#fff;padding:.5rem .7rem;font:inherit;font-size:.56rem;letter-spacing:.13em;text-transform:uppercase}.itt-v3__status{position:absolute;z-index:2;top:1rem;left:1rem;font-size:.55rem;letter-spacing:.14em;text-transform:uppercase;opacity:.7}.itt-v3__film.is-playing .itt-v3__status:after,.itt-v3__proof.is-playing .itt-v3__status:after{content:'PLAYING'}.itt-v3__film:not(.is-playing) .itt-v3__status:after,.itt-v3__proof:not(.is-playing) .itt-v3__status:after{content:'READY'}
    .itt-v3__archive{padding:clamp(3rem,7vw,7rem) clamp(1rem,4vw,4rem);background:#0b0b0b;border-top:1px solid rgba(255,255,255,.08)}.itt-v3__archive-head{display:grid;grid-template-columns:1.1fr .9fr;gap:2rem;align-items:end;margin-bottom:2rem}.itt-v3__archive-head p{max-width:38rem;margin:0 0 .2rem auto;color:rgba(247,242,232,.66);line-height:1.55}.itt-v3__archive-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1rem}.itt-v3__proof{grid-column:span 3;position:relative;min-height:430px;overflow:hidden;background:#151515;border:1px solid rgba(255,255,255,.1);isolation:isolate}.itt-v3__proof--feature{grid-column:span 6;min-height:640px;border-color:rgba(238,229,213,.34)}.itt-v3__proof:nth-child(6){grid-column:span 6;min-height:560px}.itt-v3__proof video,.itt-v3__proof img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.itt-v3__proof:after{content:'';position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(0,0,0,.02) 30%,rgba(0,0,0,.86) 100%);pointer-events:none}.itt-v3__proof-ui{position:absolute;z-index:2;left:1rem;right:1rem;bottom:1rem}.itt-v3__proof-num{position:absolute;z-index:2;top:1rem;right:1rem;font-size:.55rem;letter-spacing:.16em;opacity:.7}.itt-v3__proof--feature .itt-v3__badge{background:var(--paper);color:#111;border-color:var(--paper)}
    .itt-v3__worlds{padding:clamp(3rem,6vw,6rem) clamp(1rem,4vw,4rem);border-top:1px solid rgba(255,255,255,.08)}.itt-v3__world-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:1.5rem}.itt-v3__world{position:relative;min-height:470px;overflow:hidden;border:1px solid rgba(255,255,255,.12);background:#151515}.itt-v3__world img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .55s ease,filter .55s ease}.itt-v3__world:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.06),rgba(0,0,0,.84))}.itt-v3__world:hover img{transform:scale(1.045);filter:saturate(1.08)}.itt-v3__world-copy{position:absolute;z-index:2;left:1rem;right:1rem;bottom:1rem}.itt-v3__world-copy h3{margin:0;font-size:clamp(1.5rem,2.2vw,2.6rem);text-transform:uppercase}.itt-v3__world-copy span{font-size:.55rem;letter-spacing:.15em;text-transform:uppercase;opacity:.68}.itt-v3__manifesto{padding:clamp(3rem,7vw,7rem) clamp(1rem,4vw,4rem);font-size:clamp(3rem,7vw,7.5rem);line-height:.88;letter-spacing:-.055em;text-transform:uppercase;border-top:1px solid rgba(255,255,255,.08)}.itt-v3__manifesto em{font-family:serif;font-weight:400}.itt-v3__letter{background:var(--paper);color:#111;padding:clamp(2.8rem,5vw,5rem);display:grid;grid-template-columns:1.2fr .8fr;gap:2rem;align-items:end}.itt-v3__letter h2{margin:.5rem 0 0;font-size:clamp(3rem,6vw,6rem);line-height:.88;letter-spacing:-.055em;text-transform:uppercase}.itt-v3__form{display:flex}.itt-v3__form input{flex:1;background:transparent;border:1px solid #111;padding:1rem}.itt-v3__form button{border:0;background:#111;color:#fff;padding:0 1.2rem;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase}
    @media(max-width:900px){.itt-v3__products{grid-template-columns:repeat(2,1fr)}.itt-v3__cinema-head,.itt-v3__archive-head,.itt-v3__letter{grid-template-columns:1fr}.itt-v3__reel,.itt-v3__archive-grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:.5rem}.itt-v3__film,.itt-v3__proof,.itt-v3__proof--feature,.itt-v3__proof:nth-child(6){flex:0 0 82vw;min-height:66svh;scroll-snap-align:center}.itt-v3__world-grid{grid-template-columns:repeat(2,1fr)}.itt-v3__hero,.itt-v3__hero-copy{min-height:74svh}}
    @media(max-width:560px){.itt-v3__edit-head{align-items:start;flex-direction:column}.itt-v3__products{grid-template-columns:1fr 1fr;gap:.65rem}.itt-v3__world-grid{grid-template-columns:1fr 1fr}.itt-v3__world{min-height:300px}.itt-v3__form{flex-direction:column}.itt-v3__form button{padding:1rem}.itt-v3__hero h1{font-size:clamp(3.5rem,18vw,6rem)}}
  </style>

  <div class="itt-v3__hero">
    {% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_alt }}{% endif %}
    <div class="itt-v3__hero-copy"><div class="itt-v3__kicker">{{ section.settings.hero_kicker | escape }}</div><h1>{{ section.settings.hero_heading | escape | newline_to_br }}</h1><p>{{ section.settings.hero_copy | escape }}</p><div><a class="itt-v3__cta" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}">{{ section.settings.hero_primary_label | escape }} →</a><a class="itt-v3__cta" href="#IttEdit-{{ section.id }}">{{ section.settings.hero_secondary_label | escape }} ↓</a></div></div>
  </div>

  <section class="itt-v3__edit" id="IttEdit-{{ section.id }}"><div class="itt-v3__edit-head"><div><div class="itt-v3__kicker">CURRENT RELEASE</div><h2 class="itt-v3__title">THE HOUSE EDIT</h2></div><a href="{{ section.settings.featured_collection.url | default: routes.all_products_collection_url }}">VIEW THE COLLECTION →</a></div><div class="itt-v3__products">{% assign featured = section.settings.featured_collection %}{% if featured != blank %}{% for product in featured.products limit: 4 %}{% if product.featured_image != blank %}<a class="itt-v3__product" href="{{ product.url }}"><div class="itt-v3__product-media">{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}</div><div class="itt-v3__product-meta"><span>{{ product.title }}</span><span>{{ product.price | money }}</span></div></a>{% endif %}{% endfor %}{% endif %}</div></section>

  <section class="itt-v3__cinema"><div class="itt-v3__cinema-head"><div><div class="itt-v3__kicker">THE MAKERS FLOOR · DETROIT</div><h2 class="itt-v3__title">WATCH IT<br>BECOME REAL.</h2></div><p>Campaign imagery builds the world. This is the counterweight: actual garments, actual hands, actual surfaces and actual movement.</p></div><div class="itt-v3__reel">
    <article class="itt-v3__film"><span class="itt-v3__status"></span><video muted loop playsinline preload="metadata" src="https://cdn.shopify.com/videos/c/o/v/87040c4ea6db4c80927dc1f729b4444f.mov"></video><div class="itt-v3__film-ui"><span class="itt-v3__badge">REAL FIT</span><h3>ON BODY. IN MOTION.</h3><p>Real pants, shown from every angle.</p><div class="itt-v3__controls"><button class="itt-v3__control js-play" type="button">PLAY / PAUSE</button><button class="itt-v3__control js-sound" type="button">SOUND ON</button></div></div></article>
    <article class="itt-v3__film"><span class="itt-v3__status"></span><video muted loop playsinline preload="metadata" src="https://cdn.shopify.com/videos/c/o/v/829da22df9ae4c89ad7479a2440de5fe.mov"></video><div class="itt-v3__film-ui"><span class="itt-v3__badge">PUFF PRINT</span><h3>TOUCH THE SURFACE.</h3><p>Raised print shown close-up by hand.</p><div class="itt-v3__controls"><button class="itt-v3__control js-play" type="button">PLAY / PAUSE</button><button class="itt-v3__control js-sound" type="button">SOUND ON</button></div></div></article>
    <article class="itt-v3__film"><img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/IMG_3515.jpg?v=1789008514" loading="lazy" alt="Crochet work held up in hand"><div class="itt-v3__film-ui"><span class="itt-v3__badge">HANDWORK</span><h3>CROCHET, HELD UP CLOSE.</h3><p>Material and construction without campaign styling.</p></div></article>
  </div></section>

  <section class="itt-v3__archive"><div class="itt-v3__archive-head"><div><div class="itt-v3__kicker">PROCESS / PROOF / PRODUCT</div><h2 class="itt-v3__title">THE PROOF<br>ARCHIVE.</h2></div><p>Only the video nearest the center of the screen plays automatically. That keeps mobile Safari from trying to decode a wall of videos at once and gives each process a moment to be seen.</p></div><div class="itt-v3__archive-grid">
    <article class="itt-v3__proof itt-v3__proof--feature"><span class="itt-v3__status"></span><span class="itt-v3__proof-num">00 / LASER</span><video muted loop playsinline preload="metadata" src="{{ section.settings.laser_video_url | escape }}"></video><div class="itt-v3__proof-ui"><span class="itt-v3__badge">LASER CUTTING</span><h3>PATTERN TO PANEL.</h3><p>The cut itself becomes part of the garment language.</p><div class="itt-v3__controls"><button class="itt-v3__control js-play" type="button">PLAY / PAUSE</button><button class="itt-v3__control js-sound" type="button">SOUND ON</button></div></div></article>
    <article class="itt-v3__proof"><span class="itt-v3__status"></span><span class="itt-v3__proof-num">01</span><video muted loop playsinline preload="metadata" src="https://cdn.shopify.com/videos/c/o/v/3fc17ed4da83432f86079c82c790ddbb.mov"></video><div class="itt-v3__proof-ui"><span class="itt-v3__badge">RICH FRIENDS</span><h3>JOGGERS, IN MOTION.</h3><p>Cut, proportion and finish shown as a real garment.</p><div class="itt-v3__controls"><button class="itt-v3__control js-play" type="button">PLAY / PAUSE</button></div></div></article>
    <article class="itt-v3__proof"><span class="itt-v3__status"></span><span class="itt-v3__proof-num">02</span><video muted loop playsinline preload="metadata" src="https://cdn.shopify.com/videos/c/o/v/5a0eb69fcd12494198769e4ac27c6b28.mov"></video><div class="itt-v3__proof-ui"><span class="itt-v3__badge">SCARY FAST</span><h3>SPEED BUILT IN.</h3><p>Joggers documented on body with the graphic language intact.</p><div class="itt-v3__controls"><button class="itt-v3__control js-play" type="button">PLAY / PAUSE</button></div></div></article>
    <article class="itt-v3__proof"><span class="itt-v3__status"></span><span class="itt-v3__proof-num">03</span><video muted loop playsinline preload="metadata" src="https://cdn.shopify.com/videos/c/o/v/ccf55ce803e54a2ea550225b2635dfab.mov"></video><div class="itt-v3__proof-ui"><span class="itt-v3__badge">PAY ME</span><h3>TEE + JOGGER SYSTEM.</h3><p>A complete look, shown together.</p><div class="itt-v3__controls"><button class="itt-v3__control js-play" type="button">PLAY / PAUSE</button></div></div></article>
    <article class="itt-v3__proof"><span class="itt-v3__status"></span><span class="itt-v3__proof-num">04</span><video muted loop playsinline preload="metadata" src="https://cdn.shopify.com/videos/c/o/v/8e9ff79d37c24680bda11cf1127b3d90.mov"></video><div class="itt-v3__proof-ui"><span class="itt-v3__badge">SCREEN PRINT</span><h3>GLITTER / HOLOGRAPHIC.</h3><p>Light-reactive surface treatment shown under movement.</p><div class="itt-v3__controls"><button class="itt-v3__control js-play" type="button">PLAY / PAUSE</button></div></div></article>
    <article class="itt-v3__proof"><span class="itt-v3__status"></span><span class="itt-v3__proof-num">05</span><video muted loop playsinline preload="metadata" src="https://cdn.shopify.com/videos/c/o/v/1bd09a1ef5f744eda9810900e1342454.mov"></video><div class="itt-v3__proof-ui"><span class="itt-v3__badge">REFLECTIVE FLOOD</span><h3>LIGHT CHANGES THE SHIRT.</h3><p>The reflective field shifts as the light moves.</p><div class="itt-v3__controls"><button class="itt-v3__control js-play" type="button">PLAY / PAUSE</button></div></div></article>
    <article class="itt-v3__proof"><span class="itt-v3__status"></span><span class="itt-v3__proof-num">06</span><video muted loop playsinline preload="metadata" src="https://cdn.shopify.com/videos/c/o/v/2fa9a87404b045b99f16c71b80f30c33.mov"></video><div class="itt-v3__proof-ui"><span class="itt-v3__badge">GLITTER PRINT</span><h3>SURFACE WITH DEPTH.</h3><p>Texture and sparkle shown at working distance.</p><div class="itt-v3__controls"><button class="itt-v3__control js-play" type="button">PLAY / PAUSE</button></div></div></article>
    <article class="itt-v3__proof"><span class="itt-v3__status"></span><span class="itt-v3__proof-num">07</span><video muted loop playsinline preload="metadata" src="https://cdn.shopify.com/videos/c/o/v/368c8cc4c7eb48e1bdb4b97bd675a6d7.mov"></video><div class="itt-v3__proof-ui"><span class="itt-v3__badge">DTF</span><h3>TRANSFER, CLEANLY DONE.</h3><p>A direct look at one of the house production methods.</p><div class="itt-v3__controls"><button class="itt-v3__control js-play" type="button">PLAY / PAUSE</button></div></div></article>
    <article class="itt-v3__proof"><span class="itt-v3__proof-num">08</span><img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/IMG_2528_25dee8c6-1d6b-42dd-8c25-353b55adcf1f.jpg?v=1789002866" loading="lazy" alt="Rich Friends shirt"><div class="itt-v3__proof-ui"><span class="itt-v3__badge">RICH FRIENDS</span><h3>HOUSE GRAPHIC.</h3><p>Finished shirt, photographed as produced.</p></div></article>
    <article class="itt-v3__proof"><span class="itt-v3__proof-num">09</span><img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/IMG_2507.jpg?v=1789002851" loading="lazy" alt="Rich Friends hoodie"><div class="itt-v3__proof-ui"><span class="itt-v3__badge">RICH FRIENDS</span><h3>THE HOODIE PEOPLE REMEMBER.</h3><p>A strong repeatable house piece.</p></div></article>
    <article class="itt-v3__proof"><span class="itt-v3__proof-num">10</span><img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/IMG_2506_07026f67-25a4-4aff-a6db-9b3d1069a8d8.jpg?v=1789002849" loading="lazy" alt="Rich Friends hoodie detail"><div class="itt-v3__proof-ui"><span class="itt-v3__badge">RICH FRIENDS</span><h3>SECOND ANGLE.</h3><p>Shape, print placement and scale.</p></div></article>
    <article class="itt-v3__proof"><span class="itt-v3__proof-num">11</span><img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/D44880D0-7B60-4458-AA3E-6383EE1C8E3E.png?v=1789002841" loading="lazy" alt="Lions Stronghold shirt"><div class="itt-v3__proof-ui"><span class="itt-v3__badge">TEAM CULTURE</span><h3>LIONS STRONGHOLD.</h3><p>Sports culture filtered through the house.</p></div></article>
  </div></section>

  <section class="itt-v3__worlds"><div class="itt-v3__kicker">HOUSE WORLDS</div><h2 class="itt-v3__title">ENTER THE HOUSE.</h2><div class="itt-v3__world-grid">
    <a class="itt-v3__world" href="{{ routes.all_products_collection_url }}">{% if section.settings.apparel_image != blank %}{{ section.settings.apparel_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: 'La Maison' }}{% else %}<img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/IMG_2507.jpg?v=1789002851" loading="lazy" alt="La Maison">{% endif %}<div class="itt-v3__world-copy"><h3>LA MAISON</h3><span>LIMITED EDITIONS · HOUSE SIGNATURES</span></div></a>
    <a class="itt-v3__world" href="{{ routes.all_products_collection_url }}">{% if section.settings.denim_image != blank %}{{ section.settings.denim_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: 'L’Atelier' }}{% else %}<img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/IMG_2528_25dee8c6-1d6b-42dd-8c25-353b55adcf1f.jpg?v=1789002866" loading="lazy" alt="L’Atelier">{% endif %}<div class="itt-v3__world-copy"><h3>L’ATELIER</h3><span>ENGRAVED · RECONSTRUCTED · ONE OF ONE</span></div></a>
    <a class="itt-v3__world" href="{{ routes.all_products_collection_url }}">{% if section.settings.flagline_image != blank %}{{ section.settings.flagline_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: 'Flagline' }}{% else %}<img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/D44880D0-7B60-4458-AA3E-6383EE1C8E3E.png?v=1789002841" loading="lazy" alt="Flagline">{% endif %}<div class="itt-v3__world-copy"><h3>FLAGLINE</h3><span>SPORT · TEAM CULTURE · GVO</span></div></a>
    <a class="itt-v3__world" href="{{ routes.all_products_collection_url }}">{% if section.settings.lab_image != blank %}{{ section.settings.lab_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: 'Le Laboratoire' }}{% else %}<img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/IMG_3515.jpg?v=1789008514" loading="lazy" alt="Le Laboratoire">{% endif %}<div class="itt-v3__world-copy"><h3>LE LABORATOIRE</h3><span>CROCHET · PROTOTYPES · LIMITED</span></div></a>
  </div></section>

  <div class="itt-v3__manifesto">ONE OF ONE, OR ONE OF FEW. NOT MERCH. <em>WEARABLE ART.</em></div>
  <section class="itt-v3__letter"><div><div class="itt-v3__kicker">INVITATION PRIVÉE</div><h2>RECEIVE THE<br>HOUSE LETTER.</h2></div>{% form 'customer', class: 'itt-v3__form' %}<input type="hidden" name="contact[tags]" value="newsletter,ittoldem-house"><input type="email" name="contact[email]" placeholder="EMAIL ADDRESS" required autocomplete="email"><button type="submit">ENTER LA MAISON →</button>{% endform %}</section>

  <script>
    (()=>{
      const root=document.getElementById('IttV3-{{ section.id }}'); if(!root)return;
      const cards=[...root.querySelectorAll('.itt-v3__film,.itt-v3__proof')].filter(c=>c.querySelector('video'));
      const videos=cards.map(c=>c.querySelector('video'));
      const stopOthers=(keep)=>videos.forEach(v=>{if(v!==keep&&!v.paused){v.pause();v.closest('.itt-v3__film,.itt-v3__proof')?.classList.remove('is-playing')}});
      const play=(v)=>{if(!v)return;stopOthers(v);v.muted=true;v.play().then(()=>v.closest('.itt-v3__film,.itt-v3__proof')?.classList.add('is-playing')).catch(()=>{});};
      cards.forEach(card=>{
        const v=card.querySelector('video'); const pb=card.querySelector('.js-play'); const sb=card.querySelector('.js-sound');
        pb?.addEventListener('click',(e)=>{e.stopPropagation();if(v.paused)play(v);else{v.pause();card.classList.remove('is-playing')}});
        sb?.addEventListener('click',(e)=>{e.stopPropagation();v.muted=!v.muted;sb.textContent=v.muted?'SOUND ON':'SOUND OFF';if(v.paused)play(v)});
        card.addEventListener('click',(e)=>{if(e.target.closest('button'))return;if(v.paused)play(v);else{v.pause();card.classList.remove('is-playing')}});
      });
      let current=null;
      const io=new IntersectionObserver(entries=>{
        const visible=entries.filter(e=>e.isIntersecting&&e.intersectionRatio>.55).sort((a,b)=>b.intersectionRatio-a.intersectionRatio);
        if(visible[0]&&visible[0].target!==current){current=visible[0].target;play(current.querySelector('video'));}
        entries.filter(e=>!e.isIntersecting||e.intersectionRatio<.18).forEach(e=>{const v=e.target.querySelector('video');if(v&&!v.paused){v.pause();e.target.classList.remove('is-playing')}});
      },{threshold:[0,.18,.55,.75]});
      cards.forEach(c=>io.observe(c));
      document.addEventListener('visibilitychange',()=>{if(document.hidden)videos.forEach(v=>v.pause())});
    })();
  </script>
</section>

