{{ 'ittoldem-house.css' | asset_url | stylesheet_tag }}
<style>.itt-media-placeholder{display:block;background:linear-gradient(180deg,#ece8df 0%,#d7d1c7 100%);width:100%;height:100%;}</style>

{% assign motion_disabled = section.settings.disable_motion_media %}

<section class="itt-house">
  <div class="itt-announcement" aria-label="House benefits">
    <span>MAISON · DÉTROIT — EAST SIDE</span><span>ONE OF ONE · ONE OF FEW</span><span>COMMISSIONS AVAILABLE</span>
  </div>

  <div class="itt-hero">
    {% unless motion_disabled %}
      <video class="itt-hero__media" data-itt-motion autoplay muted loop playsinline preload="metadata" poster="{{ 'itt-house-hero-desktop.webp' | asset_url }}" aria-hidden="true">
        <source src="{{ 'itt-house-hero-mobile.mp4' | asset_url }}" media="(max-width: 749px)" type="video/mp4">
        <source src="{{ 'itt-house-hero-desktop.mp4' | asset_url }}" type="video/mp4">
      </video>
    {% elsif section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'itt-hero__media', loading: 'eager', fetchpriority: 'high', alt: "ITT TOLD’EM Detroit campaign" }}
    {% else %}
      {{ 'itt-house-hero-desktop.webp' | asset_url | image_tag: class: 'itt-hero__media', loading: 'eager', fetchpriority: 'high', alt: "ITT TOLD’EM Detroit campaign" }}
    {% endunless %}
    <div class="itt-hero__content"><div class="itt-kicker">DENIM STUDY 001 · MAISON DÉTROIT</div><h1 class="itt-display itt-hero__title">ONE OF ONE.<br>ENGRAVED<br>IN DETROIT.</h1><p class="itt-hero__sub">Individually marked, reconstructed and numbered by the house. One of one, or one of few.</p><div class="itt-hero__actions"><a class="itt-btn itt-btn--solid" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}">VIEW THE STUDY <span class="itt-arrow">→</span></a><a class="itt-textlink" href="#itt-house-edit">DISCOVER THE RELEASE <span class="itt-arrow">↓</span></a></div></div>
    <div class="itt-script">I told ’em.<small>JE VOUS L’AVAIS DIT.</small></div><div class="itt-hero__index">ÉDITION 001 · DETROIT</div>
  </div>

  <div class="itt-products" id="itt-house-edit">
    <div class="itt-products__head"><div><div class="itt-kicker itt-kicker--dark">ÉDITION EN COURS · CURRENT RELEASE</div><h2 class="itt-display itt-products__title">THE HOUSE EDIT</h2></div><a class="itt-products__all" href="{{ section.settings.featured_collection.url | default: routes.all_products_collection_url }}">VIEW THE COLLECTION <span class="itt-arrow">→</span></a></div>
    {% assign featured = section.settings.featured_collection %}
    {% assign visible_products = 0 %}
    <div class="itt-products__grid">
      {% if featured != blank and featured.products_count > 0 %}
        {% for product in featured.products %}
          {% if product.featured_image != blank %}
            <article class="itt-product"><a class="itt-product__link" href="{{ product.url }}"><div class="itt-product__image">{{ product.featured_image | image_url: width: 900 | image_tag: class: 'itt-product__primary', loading: 'lazy', alt: product.title }}{% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 900 | image_tag: class: 'itt-product__secondary', loading: 'lazy', alt: product.title }}{% endif %}<div class="itt-product__badges">{% unless product.available %}<span>ÉPUISÉ</span>{% endunless %}{% if visible_products < 2 and product.available %}<span>MAISON SELECT</span>{% endif %}</div><div class="itt-product__shop">VIEW PIECE <span>→</span></div></div><div class="itt-product__meta"><div class="itt-product__name">{{ product.title }}</div><div class="itt-product__price">{% if product.price_varies %}<span class="itt-product__from">FROM</span> {% endif %}{{ product.price | money }}</div></div></a></article>
            {% assign visible_products = visible_products | plus: 1 %}
            {% if visible_products >= 4 %}{% break %}{% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
    {% if visible_products == 0 %}<div class="itt-products__empty"><span>LA PROCHAINE ÉDITION</span><p>The next house edit is being prepared. Join the private list for first access.</p></div>{% endif %}
  </div>

  <div class="itt-atelier-proof">
    <div><div class="itt-kicker">L’ATELIER · DETROIT</div><h2 class="itt-display">MARKED BY HAND.<br>KEPT FOR YEARS.</h2></div>
    <div class="itt-atelier-proof__copy"><p>Laser engraving, reconstruction and small-run fabrication. Each commission begins with the material, the placement and the person who will wear it.</p><a class="itt-btn" href="{{ section.settings.category_link_4 | default: routes.all_products_collection_url }}">REQUEST A COMMISSION <span class="itt-arrow">→</span></a></div>
    <div class="itt-atelier-proof__facts"><span>ONE OF ONE</span><span>HAND-FINISHED</span><span>MADE TO ORDER</span><span>DETROIT DESIGN HOUSE</span></div>
  </div>

  <div class="itt-house-worlds"><div class="itt-kicker">LES MONDES DE LA MAISON · HOUSE WORLDS</div><h2 class="itt-display">ENTER THE HOUSE.</h2></div>
  <div class="itt-categories">
    <a class="itt-card" href="{{ section.settings.category_link_1 | default: routes.all_products_collection_url }}">{% unless motion_disabled %}<video class="itt-card__media" data-itt-motion autoplay muted loop playsinline preload="none" poster="{{ 'itt-menu-apparel.webp' | asset_url }}" aria-hidden="true"><source src="{{ 'itt-menu-apparel.mp4' | asset_url }}" type="video/mp4"></video>{% elsif section.settings.apparel_image != blank %}{{ section.settings.apparel_image | image_url: width: 1200 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM Maison collection" }}{% else %}{{ 'itt-menu-apparel.webp' | asset_url | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM Maison collection" }}{% endunless %}<div class="itt-card__number">01</div><div class="itt-card__content"><h2 class="itt-card__title">LA MAISON</h2><div class="itt-card__meta">LIMITED EDITIONS · HOUSE SIGNATURES</div><div class="itt-card__link">DISCOVER <span class="itt-arrow">→</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.category_link_4 | default: routes.all_products_collection_url }}">{% unless motion_disabled %}<video class="itt-card__media" data-itt-motion autoplay muted loop playsinline preload="none" poster="{{ 'itt-menu-custom-denim.webp' | asset_url }}" aria-hidden="true"><source src="{{ 'itt-menu-custom-denim.mp4' | asset_url }}" type="video/mp4"></video>{% elsif section.settings.denim_image != blank %}{{ section.settings.denim_image | image_url: width: 1200 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM atelier custom denim" }}{% else %}{{ 'itt-menu-custom-denim.webp' | asset_url | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM atelier custom denim" }}{% endunless %}<div class="itt-card__number">02</div><div class="itt-card__content"><h2 class="itt-card__title">L’ATELIER</h2><div class="itt-card__meta">ENGRAVED · RECONSTRUCTED · ONE OF ONE</div><div class="itt-card__link">COMMISSION <span class="itt-arrow">→</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.gvo_link | default: routes.all_products_collection_url }}">{% unless motion_disabled %}<video class="itt-card__media" data-itt-motion autoplay muted loop playsinline preload="none" poster="{{ 'itt-menu-gvo.webp' | asset_url }}" aria-hidden="true"><source src="{{ 'itt-menu-gvo.mp4' | asset_url }}" type="video/mp4"></video>{% elsif section.settings.flagline_image != blank %}{{ section.settings.flagline_image | image_url: width: 1200 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM FLAGLINE" }}{% else %}{{ 'itt-menu-gvo.webp' | asset_url | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM FLAGLINE" }}{% endunless %}<div class="itt-card__number">03</div><div class="itt-card__content"><h2 class="itt-card__title">FLAGLINE</h2><div class="itt-card__meta">SPORT · TEAM CULTURE · GVO</div><div class="itt-card__link">DISCOVER <span class="itt-arrow">→</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.lab_link | default: section.settings.category_link_3 | default: routes.all_products_collection_url }}">{% unless motion_disabled %}<video class="itt-card__media" data-itt-motion autoplay muted loop playsinline preload="none" poster="{{ 'itt-menu-lab.webp' | asset_url }}" aria-hidden="true"><source src="{{ 'itt-menu-lab.mp4' | asset_url }}" type="video/mp4"></video>{% elsif section.settings.lab_image != blank %}{{ section.settings.lab_image | image_url: width: 1200 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM Le Laboratoire" }}{% else %}{{ 'itt-menu-lab.webp' | asset_url | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM Le Laboratoire" }}{% endunless %}<div class="itt-card__number">04</div><div class="itt-card__content"><h2 class="itt-card__title">LE LABORATOIRE</h2><div class="itt-card__meta">CROCHET · PROTOTYPES · LIMITED</div><div class="itt-card__link">EXPLORE <span class="itt-arrow">→</span></div></div></a>
  </div>

  <div class="itt-manifesto"><div class="itt-manifesto__eyebrow">LE CODE DE LA MAISON</div><p>ONE OF ONE, OR ONE OF FEW. NOT MERCH. <em>WEARABLE ART.</em></p></div>

  <div class="itt-story">{% unless motion_disabled %}<video class="itt-story__media" data-itt-motion autoplay muted loop playsinline preload="none" poster="{{ 'itt-story-process.webp' | asset_url }}" aria-hidden="true"><source src="{{ 'itt-story-process.mp4' | asset_url }}" type="video/mp4"></video>{% else %}{{ 'itt-story-process.webp' | asset_url | image_tag: class: 'itt-story__media', loading: 'lazy', alt: "ITT TOLD’EM materials and process" }}{% endunless %}<div class="itt-story__content"><div class="itt-kicker">SAVOIR-FAIRE · DÉTROIT</div><h2 class="itt-display itt-story__title">FROM MATERIAL<br>TO MEMORY.</h2><p class="itt-story__copy">The work begins with material, hand and machine. It leaves the house as a limited piece made to be worn, remembered and kept.</p><a class="itt-btn" href="{{ section.settings.story_link | default: routes.root_url }}">DISCOVER THE PROCESS <span class="itt-arrow">→</span></a></div><div class="itt-values">Matière<br>Main<br>Machine<br>Mémoire</div></div>

  <div class="itt-drop"><div><div class="itt-kicker">INVITATION PRIVÉE</div><h2 class="itt-display">RECEIVE THE HOUSE LETTER.</h2></div>{% form 'customer', class: 'itt-drop__form' %}<input type="hidden" name="contact[tags]" value="newsletter,ittoldem-house"><label class="visually-hidden" for="IttDropEmail-{{ section.id }}">Email address</label><input id="IttDropEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="EMAIL ADDRESS" required autocomplete="email"><button type="submit">ENTER LA MAISON <span>→</span></button>{% if form.posted_successfully? %}<p class="itt-drop__status" role="status">BIENVENUE. YOU’RE IN.</p>{% endif %}{% if form.errors %}<div class="itt-drop__status" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</div>
  <div class="itt-servicebar"><div class="itt-service">◇ &nbsp; LIMITED PRODUCTION</div><div class="itt-service">✦ &nbsp; COMMISSIONS AVAILABLE</div><div class="itt-service">▢ &nbsp; SECURE CHECKOUT</div><div class="itt-service">⌁ &nbsp; DETROIT DESIGN HOUSE</div></div>
</section>

<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} .itt-house');
    if (!root) return;
    const videos = root.querySelectorAll('video[data-itt-motion]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      videos.forEach((video) => video.pause());
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.play().catch(() => {});
        else entry.target.pause();
      });
    }, { rootMargin: '180px 0px', threshold: 0.05 });
    videos.forEach((video) => observer.observe(video));
  })();
</script>

{% schema %}
{"name":"ITT TOLD'EM House","tag":"section","class":"section-ittoldem-house","settings":[{"type":"header","content":"Campaign media"},{"type":"checkbox","id":"disable_motion_media","label":"Disable bundled motion media","default":false},{"type":"image_picker","id":"hero_image","label":"Static hero override"},{"type":"image_picker","id":"apparel_image","label":"Static Apparel override"},{"type":"image_picker","id":"flagline_image","label":"Static GVO override"},{"type":"image_picker","id":"lab_image","label":"Static The Lab override"},{"type":"image_picker","id":"denim_image","label":"Static Custom Denim override"},{"type":"url","id":"hero_link","label":"Hero link"},{"type":"url","id":"category_link_1","label":"Apparel link"},{"type":"url","id":"gvo_link","label":"GVO link (includes FLAGLINE)"},{"type":"url","id":"category_link_3","label":"The Lab link"},{"type":"url","id":"category_link_4","label":"Custom denim link"},{"type":"url","id":"lab_link","label":"The Lab nav link"},{"type":"collection","id":"featured_collection","label":"Current release collection"},{"type":"url","id":"story_link","label":"About / story link"}],"presets":[{"name":"ITT TOLD'EM House"}]}
{% endschema %}
