<section id="IttMakersFloor-{{ section.id }}" class="itt-makers-floor" data-itt-makers-floor>
  <style>
    #IttMakersFloor-{{ section.id }}{background:#090909;color:#f4efe4;padding:clamp(3rem,7vw,7rem) clamp(1rem,4vw,4rem);border-top:1px solid rgba(244,239,228,.14);border-bottom:1px solid rgba(244,239,228,.14);overflow:hidden}
    #IttMakersFloor-{{ section.id }} .itt-mf-head{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);gap:2rem;align-items:end;margin-bottom:2.25rem}
    #IttMakersFloor-{{ section.id }} .itt-mf-kicker{font-size:.68rem;letter-spacing:.22em;text-transform:uppercase;opacity:.68;margin-bottom:.8rem}
    #IttMakersFloor-{{ section.id }} h2{margin:0;font-size:clamp(3.2rem,8vw,8.5rem);line-height:.84;letter-spacing:-.055em;font-weight:500}
    #IttMakersFloor-{{ section.id }} .itt-mf-head p{max-width:34rem;margin:0 0 .6rem auto;font-size:clamp(.95rem,1.2vw,1.15rem);line-height:1.55;color:rgba(244,239,228,.72)}
    #IttMakersFloor-{{ section.id }} .itt-mf-track{display:grid;grid-template-columns:1.25fr .8fr .8fr;gap:1rem;align-items:stretch}
    #IttMakersFloor-{{ section.id }} .itt-mf-card{position:relative;min-height:clamp(460px,62vw,820px);background:#111;overflow:hidden;border:1px solid rgba(244,239,228,.13)}
    #IttMakersFloor-{{ section.id }} .itt-mf-media{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;background:#111}
    #IttMakersFloor-{{ section.id }} .itt-mf-card:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.02) 35%,rgba(0,0,0,.82) 100%);pointer-events:none}
    #IttMakersFloor-{{ section.id }} .itt-mf-ui{position:absolute;inset:auto 0 0 0;z-index:3;padding:1.1rem;display:grid;gap:.45rem}
    #IttMakersFloor-{{ section.id }} .itt-mf-badge{position:absolute;z-index:4;top:1rem;left:1rem;padding:.45rem .6rem;border:1px solid rgba(244,239,228,.55);background:rgba(0,0,0,.35);backdrop-filter:blur(10px);font-size:.58rem;letter-spacing:.18em;text-transform:uppercase}
    #IttMakersFloor-{{ section.id }} .itt-mf-index{font-size:.6rem;letter-spacing:.2em;opacity:.7}
    #IttMakersFloor-{{ section.id }} .itt-mf-title{font-size:clamp(1.7rem,3vw,3.7rem);line-height:.92;letter-spacing:-.03em;text-transform:uppercase;max-width:90%}
    #IttMakersFloor-{{ section.id }} .itt-mf-copy{font-size:.82rem;line-height:1.45;max-width:30rem;color:rgba(244,239,228,.76)}
    #IttMakersFloor-{{ section.id }} .itt-mf-actions{display:flex;gap:.55rem;align-items:center;flex-wrap:wrap;margin-top:.35rem}
    #IttMakersFloor-{{ section.id }} .itt-mf-btn{appearance:none;border:1px solid rgba(244,239,228,.55);background:rgba(0,0,0,.28);color:#f4efe4;padding:.62rem .8rem;font:inherit;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;text-decoration:none;backdrop-filter:blur(8px)}
    #IttMakersFloor-{{ section.id }} .itt-mf-progress{height:2px;background:rgba(244,239,228,.2);overflow:hidden;margin-top:.55rem}.itt-mf-progress>span{display:block;height:100%;width:0;background:#f4efe4;transform-origin:left}
    #IttMakersFloor-{{ section.id }} .itt-mf-note{display:flex;justify-content:space-between;gap:1rem;margin-top:1rem;font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:rgba(244,239,228,.48)}
    @media(max-width:900px){#IttMakersFloor-{{ section.id }} .itt-mf-head{grid-template-columns:1fr}#IttMakersFloor-{{ section.id }} .itt-mf-head p{margin:0}#IttMakersFloor-{{ section.id }} .itt-mf-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:.75rem;padding-bottom:.5rem;scrollbar-width:none}#IttMakersFloor-{{ section.id }} .itt-mf-track::-webkit-scrollbar{display:none}#IttMakersFloor-{{ section.id }} .itt-mf-card{flex:0 0 84vw;min-height:68svh;scroll-snap-align:center}#IttMakersFloor-{{ section.id }} h2{font-size:clamp(3rem,16vw,6rem)}}
  </style>

  <div class="itt-mf-head">
    <div><div class="itt-mf-kicker">{{ section.settings.kicker | escape }}</div><h2>{{ section.settings.heading | escape | newline_to_br }}</h2></div>
    <p>{{ section.settings.copy | escape }}</p>
  </div>

  <div class="itt-mf-track" data-mf-track>
    {% for block in section.blocks %}
      {% assign fallback_video = blank %}
      {% assign fallback_image = blank %}
      {% if forloop.index == 1 %}{% assign fallback_video = 'https://cdn.shopify.com/videos/c/o/v/87040c4ea6db4c80927dc1f729b4444f.mov' %}{% endif %}
      {% if forloop.index == 2 %}{% assign fallback_video = 'https://cdn.shopify.com/videos/c/o/v/829da22df9ae4c89ad7479a2440de5fe.mov' %}{% endif %}
      {% if forloop.index == 3 %}{% assign fallback_image = 'https://cdn.shopify.com/s/files/1/0735/1320/5802/files/IMG_3515.jpg?v=1789008514' %}{% endif %}
      <article class="itt-mf-card" {{ block.shopify_attributes }}>
        <div class="itt-mf-badge">REAL GARMENT / REAL PROCESS</div>
        {% if block.settings.video != blank %}
          {{ block.settings.video | video_tag: class: 'itt-mf-media', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
        {% elsif fallback_video != blank %}
          <video class="itt-mf-media" autoplay muted loop playsinline preload="metadata"><source src="{{ fallback_video }}" type="video/quicktime"></video>
        {% elsif block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1600 | image_tag: class: 'itt-mf-media', loading: 'lazy', alt: block.settings.title }}
        {% elsif fallback_image != blank %}
          <img class="itt-mf-media" src="{{ fallback_image }}" loading="lazy" alt="ITT TOLD'EM crochet work held in hand">
        {% endif %}
        <div class="itt-mf-ui">
          <div class="itt-mf-index">0{{ forloop.index }} · {{ block.settings.eyebrow | escape }}</div>
          <div class="itt-mf-title">{{ block.settings.title | escape }}</div>
          <div class="itt-mf-copy">{{ block.settings.caption | escape }}</div>
          <div class="itt-mf-actions">
            {% if block.settings.video != blank or fallback_video != blank %}<button class="itt-mf-btn" type="button" data-mf-sound>SOUND ON</button>{% endif %}
            {% if block.settings.product != blank %}<a class="itt-mf-btn" href="{{ block.settings.product.url }}">SHOP THE PIECE →</a>{% elsif block.settings.link != blank %}<a class="itt-mf-btn" href="{{ block.settings.link }}">{{ block.settings.link_label | default: 'DISCOVER' | escape }} →</a>{% endif %}
          </div>
          {% if block.settings.video != blank or fallback_video != blank %}<div class="itt-mf-progress"><span></span></div>{% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
  <div class="itt-mf-note"><span>SHOT IN REAL LIFE · NO PRODUCT RENDER</span><span>SWIPE / DRAG TO EXPLORE</span></div>

  <script>
    (()=>{
      const root=document.getElementById('IttMakersFloor-{{ section.id }}'); if(!root)return;
      const anchor=document.querySelector('.itt-atelier-proof'); if(anchor && anchor.nextElementSibling!==root) anchor.insertAdjacentElement('afterend',root);
      root.querySelectorAll('video').forEach(v=>{
        const card=v.closest('.itt-mf-card'),bar=card?.querySelector('.itt-mf-progress>span'),btn=card?.querySelector('[data-mf-sound]');
        const update=()=>{if(bar&&v.duration)bar.style.width=((v.currentTime/v.duration)*100)+'%'}; v.addEventListener('timeupdate',update);
        btn?.addEventListener('click',()=>{v.muted=!v.muted;btn.textContent=v.muted?'SOUND ON':'SOUND OFF'; if(v.paused)v.play().catch(()=>{})});
      });
      const io=new IntersectionObserver(es=>es.forEach(e=>{const v=e.target.querySelector('video');if(!v)return;e.isIntersecting?v.play().catch(()=>{}):v.pause()}),{threshold:.35});
      root.querySelectorAll('.itt-mf-card').forEach(c=>io.observe(c));
    })();
  </script>
</section>

{% schema %}
{
  "name": "ITT Makers Floor",
  "tag": "section",
  "class": "section-itt-makers-floor",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker","default":"THE MAKERS FLOOR · DETROIT"},
    {"type":"textarea","id":"heading","label":"Heading","default":"WATCH IT\nBECOME REAL."},
    {"type":"textarea","id":"copy","label":"Intro copy","default":"Campaign imagery sets the world. This is the proof: real garments, real texture, real hands, real movement."}
  ],
  "blocks": [
    {
      "type":"proof",
      "name":"Process chapter",
      "settings":[
        {"type":"video","id":"video","label":"Shopify-hosted video"},
        {"type":"image_picker","id":"image","label":"Fallback / still image"},
        {"type":"text","id":"eyebrow","label":"Eyebrow","default":"IN THE HOUSE"},
        {"type":"text","id":"title","label":"Title","default":"REAL PIECE. REAL MOVEMENT."},
        {"type":"textarea","id":"caption","label":"Caption","default":"See the material, fit and finish outside the render."},
        {"type":"product","id":"product","label":"Shoppable product"},
        {"type":"url","id":"link","label":"Optional link"},
        {"type":"text","id":"link_label","label":"Link label","default":"DISCOVER"}
      ]
    },
    {"type":"@app"}
  ],
  "max_blocks": 6,
  "presets":[{"name":"ITT Makers Floor","blocks":[{"type":"proof","settings":{"eyebrow":"FIT STUDY","title":"ON BODY. IN MOTION.","caption":"A real fit check showing the pants from every angle."}},{"type":"proof","settings":{"eyebrow":"PRINT STUDY","title":"TOUCH THE SURFACE.","caption":"Raised puff print and texture shown close-up by hand."}},{"type":"proof","settings":{"eyebrow":"HANDWORK","title":"CROCHET, HELD UP CLOSE.","caption":"The material and construction shown without campaign styling."}}]}]
}
{% endschema %}