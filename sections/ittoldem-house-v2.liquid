<section class="itt-v2" id="IttV2-{{ section.id }}">
  <style>
    #IttV2-{{ section.id }}{background:#090909;color:#f3eee4;overflow:hidden}.itt-v2 *{box-sizing:border-box}.itt-v2 a{color:inherit;text-decoration:none}.itt-v2__hero{position:relative;min-height:78svh;background:#111;overflow:hidden}.itt-v2__hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}.itt-v2__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.72) 0%,rgba(0,0,0,.28) 52%,rgba(0,0,0,.08) 100%)}.itt-v2__hero-copy{position:relative;z-index:2;min-height:78svh;display:flex;flex-direction:column;justify-content:flex-end;padding:clamp(2rem,5vw,5rem);max-width:920px}.itt-v2__kicker{font-size:.68rem;letter-spacing:.22em;text-transform:uppercase;opacity:.72;margin-bottom:1rem}.itt-v2__hero h1,.itt-v2__section-title{margin:0;font-weight:500;letter-spacing:-.055em;line-height:.86;text-transform:uppercase}.itt-v2__hero h1{font-size:clamp(4rem,10vw,9.5rem)}.itt-v2__hero p{max-width:640px;font-size:clamp(1rem,1.4vw,1.2rem);line-height:1.5;color:rgba(243,238,228,.8)}.itt-v2__cta{display:inline-flex;align-items:center;gap:.65rem;border:1px solid rgba(243,238,228,.62);padding:.85rem 1rem;margin-right:.6rem;margin-top:.8rem;font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;background:rgba(0,0,0,.26);backdrop-filter:blur(8px)}
    .itt-v2__edit{background:#efe7d7;color:#111;padding:clamp(2.5rem,5vw,5rem)}.itt-v2__edit-head{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:1.5rem}.itt-v2__section-title{font-size:clamp(3rem,6vw,6.6rem)}.itt-v2__products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.itt-v2__product img{width:100%;aspect-ratio:4/5;object-fit:cover;display:block;background:#ddd}.itt-v2__product-meta{display:flex;justify-content:space-between;gap:1rem;padding-top:.7rem;font-size:.7rem;letter-spacing:.04em;text-transform:uppercase}.itt-v2__product-title{max-width:75%}
    .itt-v2__process{padding:clamp(3rem,6vw,6rem) clamp(1rem,4vw,4rem)}.itt-v2__process-head{display:grid;grid-template-columns:1.2fr .8fr;gap:2rem;align-items:end;margin-bottom:2rem}.itt-v2__process-head p{max-width:34rem;margin-left:auto;color:rgba(243,238,228,.72);line-height:1.55}.itt-v2__process-track{display:grid;grid-template-columns:1.25fr .85fr .85fr;gap:1rem}.itt-v2__media-card{position:relative;min-height:clamp(480px,58vw,780px);overflow:hidden;background:#141414;border:1px solid rgba(243,238,228,.12)}.itt-v2__media-card video,.itt-v2__media-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.itt-v2__media-card:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.03) 35%,rgba(0,0,0,.82) 100%)}.itt-v2__media-ui{position:absolute;z-index:2;left:1rem;right:1rem;bottom:1rem}.itt-v2__badge{display:inline-block;border:1px solid rgba(243,238,228,.55);padding:.45rem .6rem;font-size:.58rem;letter-spacing:.16em;text-transform:uppercase;margin-bottom:.8rem;background:rgba(0,0,0,.34)}.itt-v2__media-ui h3{margin:0 0 .45rem;font-size:clamp(1.6rem,2.4vw,3rem);line-height:.92;text-transform:uppercase}.itt-v2__media-ui p{margin:0;color:rgba(243,238,228,.74);font-size:.82rem;line-height:1.45}.itt-v2__sound{margin-top:.8rem;border:1px solid rgba(243,238,228,.5);background:rgba(0,0,0,.3);color:#f3eee4;padding:.55rem .7rem;font:inherit;font-size:.6rem;letter-spacing:.14em;text-transform:uppercase}
    .itt-v2__archive{padding:clamp(3rem,7vw,7rem) clamp(1rem,4vw,4rem);border-top:1px solid rgba(243,238,228,.12);background:#0c0c0c}.itt-v2__archive-head{display:grid;grid-template-columns:1.1fr .9fr;gap:2rem;align-items:end;margin-bottom:2rem}.itt-v2__archive-head p{margin:0 0 .2rem auto;max-width:38rem;color:rgba(243,238,228,.68);line-height:1.55}.itt-v2__archive-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1rem}.itt-v2__proof{position:relative;min-height:420px;overflow:hidden;border:1px solid rgba(243,238,228,.12);background:#161616}.itt-v2__proof:nth-child(1),.itt-v2__proof:nth-child(6){grid-column:span 6;min-height:620px}.itt-v2__proof{grid-column:span 3}.itt-v2__proof video,.itt-v2__proof img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.itt-v2__proof:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.03) 28%,rgba(0,0,0,.86) 100%)}.itt-v2__proof-ui{position:absolute;z-index:2;left:1rem;right:1rem;bottom:1rem}.itt-v2__proof-ui h3{font-size:clamp(1.2rem,1.8vw,2.2rem);line-height:.95;margin:.2rem 0 .45rem;text-transform:uppercase}.itt-v2__proof-ui p{font-size:.76rem;line-height:1.45;margin:0;color:rgba(243,238,228,.7)}.itt-v2__proof--laser{border-color:rgba(243,238,228,.32)}.itt-v2__proof--laser .itt-v2__badge{background:#efe7d7;color:#111;border-color:#efe7d7}.itt-v2__proof-number{position:absolute;z-index:2;top:1rem;right:1rem;font-size:.62rem;letter-spacing:.16em;opacity:.7}
    .itt-v2__worlds{padding:clamp(3rem,6vw,6rem) clamp(1rem,4vw,4rem);border-top:1px solid rgba(243,238,228,.12)}.itt-v2__world-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:1.5rem}.itt-v2__world{min-height:430px;border:1px solid rgba(243,238,228,.14);position:relative;overflow:hidden;background:linear-gradient(180deg,#292929,#111)}.itt-v2__world img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.9}.itt-v2__world:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.1),rgba(0,0,0,.78))}.itt-v2__world-copy{position:absolute;z-index:2;left:1rem;right:1rem;bottom:1rem}.itt-v2__world-copy h3{margin:0;font-size:clamp(1.5rem,2.3vw,2.6rem);text-transform:uppercase}.itt-v2__world-copy span{font-size:.58rem;letter-spacing:.15em;text-transform:uppercase;opacity:.68}
    .itt-v2__manifesto{padding:clamp(3rem,7vw,7rem) clamp(1rem,4vw,4rem);font-size:clamp(3rem,7vw,8rem);line-height:.88;letter-spacing:-.05em;text-transform:uppercase;border-top:1px solid rgba(243,238,228,.12)}.itt-v2__manifesto em{font-family:serif;font-weight:400}.itt-v2__letter{background:#e9dfcc;color:#111;padding:clamp(2.5rem,5vw,5rem);display:grid;grid-template-columns:1.2fr .8fr;gap:2rem;align-items:end}.itt-v2__letter h2{margin:0;font-size:clamp(3rem,6vw,6rem);line-height:.9;letter-spacing:-.05em;text-transform:uppercase}.itt-v2__form{display:flex}.itt-v2__form input{flex:1;background:transparent;border:1px solid #111;padding:1rem}.itt-v2__form button{background:#111;color:#fff;border:0;padding:0 1.2rem;font-size:.65rem;letter-spacing:.14em;text-transform:uppercase}
    @media(max-width:900px){.itt-v2__products{grid-template-columns:repeat(2,1fr)}.itt-v2__process-head,.itt-v2__letter,.itt-v2__archive-head{grid-template-columns:1fr}.itt-v2__process-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.itt-v2__media-card{flex:0 0 84vw;scroll-snap-align:center;min-height:68svh}.itt-v2__world-grid{grid-template-columns:repeat(2,1fr)}.itt-v2__hero{min-height:72svh}.itt-v2__hero-copy{min-height:72svh}.itt-v2__archive-grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.itt-v2__proof,.itt-v2__proof:nth-child(1),.itt-v2__proof:nth-child(6){flex:0 0 78vw;min-height:62svh;scroll-snap-align:center}}
    @media(max-width:560px){.itt-v2__products{grid-template-columns:1fr 1fr;gap:.65rem}.itt-v2__world-grid{grid-template-columns:1fr}.itt-v2__edit-head{align-items:start;flex-direction:column}.itt-v2__form{flex-direction:column}.itt-v2__form button{padding:1rem}}
  </style>

  <div class="itt-v2__hero">
    {% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_alt }}{% endif %}
    <div class="itt-v2__shade"></div>
    <div class="itt-v2__hero-copy"><div class="itt-v2__kicker">{{ section.settings.hero_kicker | escape }}</div><h1>{{ section.settings.hero_heading | escape | newline_to_br }}</h1><p>{{ section.settings.hero_copy | escape }}</p><div><a class="itt-v2__cta" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}">{{ section.settings.hero_primary_label | escape }} →</a><a class="itt-v2__cta" href="#IttV2Edit-{{ section.id }}">{{ section.settings.hero_secondary_label | escape }} ↓</a></div></div>
  </div>

  <section class="itt-v2__edit" id="IttV2Edit-{{ section.id }}"><div class="itt-v2__edit-head"><div><div class="itt-v2__kicker">CURRENT RELEASE</div><h2 class="itt-v2__section-title">THE HOUSE EDIT</h2></div><a href="{{ section.settings.featured_collection.url | default: routes.all_products_collection_url }}">VIEW THE COLLECTION →</a></div><div class="itt-v2__products">{% assign featured = section.settings.featured_collection %}{% if featured != blank %}{% for product in featured.products limit: 4 %}{% if product.featured_image != blank %}<a class="itt-v2__product" href="{{ product.url }}">{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}<div class="itt-v2__product-meta"><span class="itt-v2__product-title">{{ product.title }}</span><span>{{ product.price | money }}</span></div></a>{% endif %}{% endfor %}{% endif %}</div></section>

  <section class="itt-v2__process"><div class="itt-v2__process-head"><div><div class="itt-v2__kicker">THE MAKERS FLOOR · DETROIT</div><h2 class="itt-v2__section-title">WATCH IT<br>BECOME REAL.</h2></div><p>Campaign imagery sets the world. This is the proof: garments on body, raised print under the hand, crochet held up close, and the process visible instead of hidden.</p></div><div class="itt-v2__process-track"><article class="itt-v2__media-card"><video autoplay muted loop playsinline preload="metadata"><source src="https://cdn.shopify.com/videos/c/o/v/87040c4ea6db4c80927dc1f729b4444f.mov" type="video/quicktime"></video><div class="itt-v2__media-ui"><span class="itt-v2__badge">REAL FIT</span><h3>ON BODY. IN MOTION.</h3><p>Real pants, shown from every angle.</p><button class="itt-v2__sound" type="button">SOUND ON</button></div></article><article class="itt-v2__media-card"><video autoplay muted loop playsinline preload="metadata"><source src="https://cdn.shopify.com/videos/c/o/v/829da22df9ae4c89ad7479a2440de5fe.mov" type="video/quicktime"></video><div class="itt-v2__media-ui"><span class="itt-v2__badge">REAL PROCESS</span><h3>TOUCH THE SURFACE.</h3><p>Raised puff print shown close-up by hand.</p><button class="itt-v2__sound" type="button">SOUND ON</button></div></article><article class="itt-v2__media-card"><img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/IMG_3515.jpg?v=1789008514" loading="lazy" alt="Crochet work held up in hand"><div class="itt-v2__media-ui"><span class="itt-v2__badge">HANDWORK</span><h3>CROCHET, HELD UP CLOSE.</h3><p>Material and construction without campaign styling.</p></div></article></div></section>

  <section class="itt-v2__archive" id="IttProofArchive-{{ section.id }}"><div class="itt-v2__archive-head"><div><div class="itt-v2__kicker">PROCESS / PROOF / PRODUCT</div><h2 class="itt-v2__section-title">THE PROOF<br>ARCHIVE.</h2></div><p>Not a moodboard. Not mockups. Actual garments, actual print methods, actual movement. This is where the house shows the work close enough to inspect it.</p></div><div class="itt-v2__archive-grid">
    {% if section.settings.laser_video_url != blank %}<article class="itt-v2__proof itt-v2__proof--laser"><span class="itt-v2__proof-number">00 / LASER</span><video autoplay muted loop playsinline preload="metadata"><source src="{{ section.settings.laser_video_url | escape }}" type="video/quicktime"></video><div class="itt-v2__proof-ui"><span class="itt-v2__badge">LASER CUTTING</span><h3>PATTERN TO PANEL.</h3><p>The cut itself becomes part of the garment language.</p><button class="itt-v2__sound" type="button">SOUND ON</button></div></article>{% endif %}
    <article class="itt-v2__proof"><span class="itt-v2__proof-number">01</span><video autoplay muted loop playsinline preload="metadata"><source src="https://cdn.shopify.com/videos/c/o/v/3fc17ed4da83432f86079c82c790ddbb.mov" type="video/quicktime"></video><div class="itt-v2__proof-ui"><span class="itt-v2__badge">RICH FRIENDS</span><h3>JOGGERS, IN MOTION.</h3><p>Cut, proportion and finish shown as a real garment instead of a flat mockup.</p><button class="itt-v2__sound" type="button">SOUND ON</button></div></article>
    <article class="itt-v2__proof"><span class="itt-v2__proof-number">02</span><video autoplay muted loop playsinline preload="metadata"><source src="https://cdn.shopify.com/videos/c/o/v/5a0eb69fcd12494198769e4ac27c6b28.mov" type="video/quicktime"></video><div class="itt-v2__proof-ui"><span class="itt-v2__badge">SCARY FAST</span><h3>SPEED BUILT IN.</h3><p>Joggers documented on body with the graphic language intact.</p><button class="itt-v2__sound" type="button">SOUND ON</button></div></article>
    <article class="itt-v2__proof"><span class="itt-v2__proof-number">03</span><video autoplay muted loop playsinline preload="metadata"><source src="https://cdn.shopify.com/videos/c/o/v/ccf55ce803e54a2ea550225b2635dfab.mov" type="video/quicktime"></video><div class="itt-v2__proof-ui"><span class="itt-v2__badge">PAY ME</span><h3>TEE + JOGGER SYSTEM.</h3><p>A complete look, shown together instead of isolated product tiles.</p><button class="itt-v2__sound" type="button">SOUND ON</button></div></article>
    <article class="itt-v2__proof"><span class="itt-v2__proof-number">04</span><video autoplay muted loop playsinline preload="metadata"><source src="https://cdn.shopify.com/videos/c/o/v/8e9ff79d37c24680bda11cf1127b3d90.mov" type="video/quicktime"></video><div class="itt-v2__proof-ui"><span class="itt-v2__badge">SCREEN PRINT</span><h3>GLITTER / HOLOGRAPHIC.</h3><p>Light-reactive surface treatment shown under movement.</p><button class="itt-v2__sound" type="button">SOUND ON</button></div></article>
    <article class="itt-v2__proof"><span class="itt-v2__proof-number">05</span><video autoplay muted loop playsinline preload="metadata"><source src="https://cdn.shopify.com/videos/c/o/v/1bd09a1ef5f744eda9810900e1342454.mov" type="video/quicktime"></video><div class="itt-v2__proof-ui"><span class="itt-v2__badge">REFLECTIVE FLOOD</span><h3>LIGHT CHANGES THE SHIRT.</h3><p>The reflective field flickers and shifts as the light moves.</p><button class="itt-v2__sound" type="button">SOUND ON</button></div></article>
    <article class="itt-v2__proof"><span class="itt-v2__proof-number">06</span><video autoplay muted loop playsinline preload="metadata"><source src="https://cdn.shopify.com/videos/c/o/v/2fa9a87404b045b99f16c71b80f30c33.mov" type="video/quicktime"></video><div class="itt-v2__proof-ui"><span class="itt-v2__badge">GLITTER PRINT</span><h3>SURFACE WITH DEPTH.</h3><p>Texture and sparkle shown at working distance.</p><button class="itt-v2__sound" type="button">SOUND ON</button></div></article>
    <article class="itt-v2__proof"><span class="itt-v2__proof-number">07</span><video autoplay muted loop playsinline preload="metadata"><source src="https://cdn.shopify.com/videos/c/o/v/368c8cc4c7eb48e1bdb4b97bd675a6d7.mov" type="video/quicktime"></video><div class="itt-v2__proof-ui"><span class="itt-v2__badge">DTF</span><h3>TRANSFER, CLEANLY DONE.</h3><p>A direct look at one of the house production methods.</p><button class="itt-v2__sound" type="button">SOUND ON</button></div></article>
    <article class="itt-v2__proof"><span class="itt-v2__proof-number">08</span><img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/IMG_2528_25dee8c6-1d6b-42dd-8c25-353b55adcf1f.jpg?v=1789002866" loading="lazy" alt="Rich Friends shirt"><div class="itt-v2__proof-ui"><span class="itt-v2__badge">RICH FRIENDS</span><h3>HOUSE GRAPHIC.</h3><p>Finished shirt, photographed as produced.</p></div></article>
    <article class="itt-v2__proof"><span class="itt-v2__proof-number">09</span><img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/IMG_2507.jpg?v=1789002851" loading="lazy" alt="Rich Friends hoodie"><div class="itt-v2__proof-ui"><span class="itt-v2__badge">RICH FRIENDS</span><h3>THE HOODIE PEOPLE REMEMBER.</h3><p>A strong repeatable house piece with proven visual pull.</p></div></article>
    <article class="itt-v2__proof"><span class="itt-v2__proof-number">10</span><img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/IMG_2506_07026f67-25a4-4aff-a6db-9b3d1069a8d8.jpg?v=1789002849" loading="lazy" alt="Rich Friends hoodie detail"><div class="itt-v2__proof-ui"><span class="itt-v2__badge">RICH FRIENDS</span><h3>SECOND ANGLE.</h3><p>Proof of shape, print placement and scale.</p></div></article>
    <article class="itt-v2__proof"><span class="itt-v2__proof-number">11</span><img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/D44880D0-7B60-4458-AA3E-6383EE1C8E3E.png?v=1789002841" loading="lazy" alt="Lions Stronghold shirt"><div class="itt-v2__proof-ui"><span class="itt-v2__badge">TEAM CULTURE</span><h3>LIONS STRONGHOLD.</h3><p>Sports culture filtered through the house, not generic fan merch.</p></div></article>
  </div></section>

  <section class="itt-v2__worlds"><div class="itt-v2__kicker">HOUSE WORLDS</div><h2 class="itt-v2__section-title">ENTER THE HOUSE.</h2><div class="itt-v2__world-grid">{% assign labels = 'LA MAISON|L’ATELIER|FLAGLINE|LE LABORATOIRE' | split: '|' %}{% assign subs = 'LIMITED EDITIONS · HOUSE SIGNATURES|ENGRAVED · RECONSTRUCTED · ONE OF ONE|SPORT · TEAM CULTURE · GVO|CROCHET · PROTOTYPES · LIMITED' | split: '|' %}{% for i in (0..3) %}<a class="itt-v2__world" href="{{ routes.all_products_collection_url }}">{% case i %}{% when 0 %}{% if section.settings.apparel_image != blank %}{{ section.settings.apparel_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: labels[i] }}{% endif %}{% when 1 %}{% if section.settings.denim_image != blank %}{{ section.settings.denim_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: labels[i] }}{% endif %}{% when 2 %}{% if section.settings.flagline_image != blank %}{{ section.settings.flagline_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: labels[i] }}{% endif %}{% when 3 %}{% if section.settings.lab_image != blank %}{{ section.settings.lab_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: labels[i] }}{% endif %}{% endcase %}<div class="itt-v2__world-copy"><h3>{{ labels[i] }}</h3><span>{{ subs[i] }}</span></div></a>{% endfor %}</div></section>

  <div class="itt-v2__manifesto"><span>ONE OF ONE, OR ONE OF FEW. NOT MERCH. </span><em>WEARABLE ART.</em></div>
  <section class="itt-v2__letter"><div><div class="itt-v2__kicker">INVITATION PRIVÉE</div><h2>RECEIVE THE<br>HOUSE LETTER.</h2></div>{% form 'customer', class: 'itt-v2__form' %}<input type="hidden" name="contact[tags]" value="newsletter,ittoldem-house"><input type="email" name="contact[email]" placeholder="EMAIL ADDRESS" required autocomplete="email"><button type="submit">ENTER LA MAISON →</button>{% endform %}</section>

  <script>(()=>{const root=document.getElementById('IttV2-{{ section.id }}');if(!root)return;root.querySelectorAll('.itt-v2__media-card,.itt-v2__proof').forEach(card=>{const v=card.querySelector('video'),b=card.querySelector('.itt-v2__sound');if(v&&b)b.addEventListener('click',()=>{v.muted=!v.muted;b.textContent=v.muted?'SOUND ON':'SOUND OFF';if(v.paused)v.play().catch(()=>{})})});const io=new IntersectionObserver(es=>es.forEach(e=>{const v=e.target.querySelector('video');if(!v)return;e.isIntersecting?v.play().catch(()=>{}):v.pause()}),{threshold:.3});root.querySelectorAll('.itt-v2__media-card,.itt-v2__proof').forEach(c=>io.observe(c))})();</script>
</section>

{% schema %}
{
  "name":"ITT House V2",
  "tag":"section",
  "class":"section-itt-house-v2",
  "settings":[
    {"type":"image_picker","id":"hero_image","label":"Hero image"},
    {"type":"text","id":"hero_alt","label":"Hero alt text","default":"ITT TOLD’EM Detroit atelier campaign"},
    {"type":"text","id":"hero_kicker","label":"Hero kicker","default":"MAISON · DÉTROIT — EAST SIDE"},
    {"type":"textarea","id":"hero_heading","label":"Hero heading","default":"THE HOUSE.\nBUILT DIFFERENT."},
    {"type":"textarea","id":"hero_copy","label":"Hero copy","default":"Limited apparel, custom work and material experiments from the house."},
    {"type":"text","id":"hero_primary_label","label":"Primary button","default":"ENTER THE HOUSE"},
    {"type":"text","id":"hero_secondary_label","label":"Secondary button","default":"VIEW THE HOUSE EDIT"},
    {"type":"url","id":"hero_link","label":"Hero link"},
    {"type":"collection","id":"featured_collection","label":"Featured collection"},
    {"type":"text","id":"laser_video_url","label":"Laser cutting pants video URL","info":"Paste the Shopify CDN .mov URL here. When present it becomes the first Proof Archive card."},
    {"type":"image_picker","id":"apparel_image","label":"La Maison image"},
    {"type":"image_picker","id":"denim_image","label":"L’Atelier image"},
    {"type":"image_picker","id":"flagline_image","label":"Flagline image"},
    {"type":"image_picker","id":"lab_image","label":"Le Laboratoire image"}
  ],
  "presets":[{"name":"ITT House V2"}]
}
{% endschema %}