{%- liquid
  assign gvo_url = routes.search_url | append: '?view=gvo&type=product&q=GVO'
  assign flagline_url = routes.search_url | append: '?view=flagline&type=product&q=FLAGLINE'
  assign custom_url = routes.search_url | append: '?view=custom&type=product&q=CUSTOM'
  assign wehair_url = routes.search_url | append: '?view=wehair&type=product&q=WE%20HAIR'
  assign lab_url = routes.search_url | append: '?view=lab&type=product&q=CROCHET'
  assign about_url = routes.search_url | append: '?view=about&q=ITT'
-%}
<nav class="itt-global-nav" aria-label="ITT TOLD'EM primary navigation">
  <a href="{{ routes.all_products_collection_url }}">SHOP</a>
  <a href="{{ gvo_url | escape }}">GVO</a>
  <a class="itt-global-nav__sub" href="{{ flagline_url | escape }}">FLAGLINE <span>GVO</span></a>
  <a href="{{ custom_url | escape }}">CUSTOM</a>
  <a href="{{ wehair_url | escape }}">WE HAIR</a>
  <a href="{{ lab_url | escape }}">THE LAB</a>
  <a href="{{ about_url | escape }}">ABOUT</a>
</nav>

{% stylesheet %}
.itt-global-nav{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));background:#050505;color:#f4efe6;border-top:1px solid rgba(244,239,230,.15);border-bottom:1px solid rgba(244,239,230,.15);position:relative}
.itt-global-nav a{min-height:48px;padding:14px 10px;display:flex;align-items:center;justify-content:center;gap:6px;color:inherit;text-decoration:none;text-align:center;border-right:1px solid rgba(244,239,230,.15);font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}
.itt-global-nav a:last-child{border-right:0}.itt-global-nav a:hover,.itt-global-nav a:focus-visible{background:#f4efe6;color:#111}.itt-global-nav__sub span{font-size:.52rem;opacity:.55;border:1px solid currentColor;padding:2px 4px}
@media(max-width:1100px){.itt-global-nav{display:flex;overflow-x:auto;overscroll-behavior-inline:contain;scrollbar-width:none;-webkit-overflow-scrolling:touch;scroll-snap-type:x proximity}.itt-global-nav::-webkit-scrollbar{display:none}.itt-global-nav a{min-width:104px;min-height:44px;flex:0 0 auto;padding:12px 14px;font-size:.64rem;letter-spacing:.11em;scroll-snap-align:start}.itt-global-nav__sub{min-width:128px!important}}
@media(max-width:640px){.itt-global-nav a{min-width:92px;min-height:42px;padding:10px 12px;font-size:.6rem}.itt-global-nav__sub{min-width:118px!important}.itt-global-nav__sub span{font-size:.46rem;padding:1px 3px}}
{% endstylesheet %}

{% schema %}
{"name":"ITT House Navigation","tag":"section","settings":[],"presets":[{"name":"ITT House Navigation"}]}
{% endschema %}
