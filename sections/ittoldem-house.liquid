{{ 'ittoldem-house.css' | asset_url | stylesheet_tag }}
<style>.itt-media-placeholder{display:block;background:linear-gradient(180deg,#ece8df 0%,#d7d1c7 100%);width:100%;height:100%;}</style>

{% assign motion_disabled = section.settings.disable_motion_media %}

<section class="itt-house">
  <div class="itt-announcement" aria-label="House benefits">
    <span>MAISON · DÉTROIT — EAST SIDE</span><span>WORLDWIDE SHIPPING</span><span>DESIGNED TO BE DISCOVERED</span>
  </div>

  <div class="itt-hero">
    {% unless motion_disabled %}
      <video class="itt-hero__media" data-itt-motion autoplay muted loop playsinline preload="metadata" poster="{{ 'itt-house-hero-desktop.webp' | asset_url }}" aria-hidden="true">
        <source src="{{ 'itt-house-hero-mobile.mp4' | asset_url }}" media="(max-width: 749px)" type="video/mp4">
        <source src="{{ 'itt-house-hero-desktop.mp4' | asset_url }}" type="video/mp4">
      </video>
    {% elsif section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'itt-hero__media', loading: 'eager', fetchpriority: 'high', alt: "ITT TOLD’EM Detroit campaign" }}
    {% else %}
      {{ 'itt-house-hero-desktop.webp' | asset_url | image_tag: class: 'itt-hero__media', loading: 'eager', fetchpriority: 'high', alt: "ITT TOLD’EM Detroit campaign" }}
    {% endunless %}
    <div class="itt-hero__content"><div class="itt-kicker">DETROIT · SPORT · CRAFT · EXPERIMENT</div><h1 class="itt-display itt-hero__title">THE HOUSE<br>DOESN’T<br>FOLLOW.</h1><p class="itt-hero__sub">Limited pieces, custom work and sport culture built through an East Side point of view.</p><div class="itt-hero__actions"><a class="itt-btn itt-btn--solid" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}">SHOP THE HOUSE <span class="itt-arrow">→</span></a><a class="itt-textlink" href="#itt-new-arrivals">SEE WHAT’S NEW <span class="itt-arrow">↓</span></a></div></div>
    <div class="itt-script">We built the house.<br>Now we tell ’em.<small>JE VOUS L’AVAIS DIT.</small></div><div class="itt-hero__index">MAISON 001 · DETROIT</div>
  </div>

  <div class="itt-categories">
    <a class="itt-card" href="{{ section.settings.category_link_1 | default: routes.all_products_collection_url }}">{% unless motion_disabled %}<video class="itt-card__media" data-itt-motion autoplay muted loop playsinline preload="none" poster="{{ 'itt-menu-apparel.webp' | asset_url }}" aria-hidden="true"><source src="{{ 'itt-menu-apparel.mp4' | asset_url }}" type="video/mp4"></video>{% elsif section.settings.apparel_image != blank %}{{ section.settings.apparel_image | image_url: width: 1200 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM apparel" }}{% else %}{{ 'itt-menu-apparel.webp' | asset_url | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM apparel" }}{% endunless %}<div class="itt-card__number">01</div><div class="itt-card__content"><h2 class="itt-card__title">APPAREL</h2><div class="itt-card__meta">HOODIES · TEES · JOGGERS</div><div class="itt-card__link">ENTER <span class="itt-arrow">→</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.gvo_link | default: routes.all_products_collection_url }}">{% unless motion_disabled %}<video class="itt-card__media" data-itt-motion autoplay muted loop playsinline preload="none" poster="{{ 'itt-menu-gvo.webp' | asset_url }}" aria-hidden="true"><source src="{{ 'itt-menu-gvo.mp4' | asset_url }}" type="video/mp4"></video>{% elsif section.settings.flagline_image != blank %}{{ section.settings.flagline_image | image_url: width: 1200 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "Gym Vibes Only" }}{% else %}{{ 'itt-menu-gvo.webp' | asset_url | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "Gym Vibes Only" }}{% endunless %}<div class="itt-card__number">02</div><div class="itt-card__content"><h2 class="itt-card__title">GVO</h2><div class="itt-card__meta">TRAINING · FAN CULTURE · FLAGLINE</div><div class="itt-card__link">ENTER <span class="itt-arrow">→</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.lab_link | default: section.settings.category_link_3 | default: routes.all_products_collection_url }}">{% unless motion_disabled %}<video class="itt-card__media" data-itt-motion autoplay muted loop playsinline preload="none" poster="{{ 'itt-menu-lab.webp' | asset_url }}" aria-hidden="true"><source src="{{ 'itt-menu-lab.mp4' | asset_url }}" type="video/mp4"></video>{% elsif section.settings.lab_image != blank %}{{ section.settings.lab_image | image_url: width: 1200 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM The Lab" }}{% else %}{{ 'itt-menu-lab.webp' | asset_url | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM The Lab" }}{% endunless %}<div class="itt-card__number">03</div><div class="itt-card__content"><h2 class="itt-card__title">THE LAB</h2><div class="itt-card__meta">CROCHET · EXPERIMENT · LIMITED</div><div class="itt-card__link">ENTER <span class="itt-arrow">→</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.category_link_4 | default: routes.all_products_collection_url }}">{% unless motion_disabled %}<video class="itt-card__media" data-itt-motion autoplay muted loop playsinline preload="none" poster="{{ 'itt-menu-custom-denim.webp' | asset_url }}" aria-hidden="true"><source src="{{ 'itt-menu-custom-denim.mp4' | asset_url }}" type="video/mp4"></video>{% elsif section.settings.denim_image != blank %}{{ section.settings.denim_image | image_url: width: 1200 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM custom denim" }}{% else %}{{ 'itt-menu-custom-denim.webp' | asset_url | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM custom denim" }}{% endunless %}<div class="itt-card__number">04</div><div class="itt-card__content"><h2 class="itt-card__title">CUSTOM DENIM</h2><div class="itt-card__meta">ENGRAVED · ONE OF ONE</div><div class="itt-card__link">ENTER <span class="itt-arrow">→</span></div></div></a>
  </div>

  <div class="itt-products" id="itt-new-arrivals"><div class="itt-products__head"><div><div class="itt-kicker itt-kicker--dark">CURRENT RELEASE</div><h2 class="itt-display itt-products__title">NEW ARRIVALS</h2></div><a class="itt-products__all" href="{{ section.settings.featured_collection.url | default: routes.all_products_collection_url }}">SHOP ALL <span class="itt-arrow">→</span></a></div><div class="itt-products__grid">{% assign featured = section.settings.featured_collection %}{% if featured != blank and featured.products_count > 0 %}{% for product in featured.products limit: 8 %}<article class="itt-product"><a class="itt-product__link" href="{{ product.url }}"><div class="itt-product__image">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: class: 'itt-product__primary', loading: 'lazy', alt: product.title }}{% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 900 | image_tag: class: 'itt-product__secondary', loading: 'lazy', alt: product.title }}{% endif %}{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}<div class="itt-product__badges">{% unless product.available %}<span>SOLD OUT</span>{% endunless %}{% if product.compare_at_price > product.price %}<span>MARKDOWN</span>{% endif %}{% if forloop.index <= 2 and product.available %}<span>HOUSE PICK</span>{% endif %}</div><div class="itt-product__shop">VIEW PIECE <span>→</span></div></div><div class="itt-product__meta"><div class="itt-product__name">{{ product.title }}</div><div class="itt-product__price">{% if product.price_varies %}<span class="itt-product__from">FROM</span> {% endif %}{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div></div></a></article>{% endfor %}{% else %}{% for i in (1..8) %}<div class="itt-product"><div class="itt-product__image">{{ 'product-apparel-1' | placeholder_svg_tag }}</div><div class="itt-product__name">ITT TOLD’EM PIECE {{ i }}</div><div class="itt-product__price">COMING SOON</div></div>{% endfor %}{% endif %}</div></div>

  <div class="itt-manifesto"><div class="itt-manifesto__eyebrow">THE HOUSE CODE</div><p>NO UNIFORM. NO SAFE VERSION. <em>MAKE THE THING PEOPLE REMEMBER.</em></p></div>

  <div class="itt-story">{% unless motion_disabled %}<video class="itt-story__media" data-itt-motion autoplay muted loop playsinline preload="metadata" poster="{{ 'itt-story-process.webp' | asset_url }}" aria-label="Hands showing the raised puff print texture on an ITT TOLD’EM shirt"><source src="https://cdn.shopify.com/videos/c/o/v/829da22df9ae4c89ad7479a2440de5fe.mov" type="video/quicktime"></video>{% else %}{{ 'itt-story-process.webp' | asset_url | image_tag: class: 'itt-story__media', loading: 'lazy', alt: "ITT TOLD’EM materials and process" }}{% endunless %}<div class="itt-story__content"><div class="itt-kicker">MAISON · DÉTROIT — EAST SIDE</div><h2 class="itt-display itt-story__title">MADE HERE.<br>NOT GENERATED.</h2><p class="itt-story__copy">Fashion, sport and fabrication meet inside the house. The work begins with material, hand, machine and an East Side point of view.</p><a class="itt-btn" href="{{ section.settings.story_link | default: routes.root_url }}">ENTER THE STORY <span class="itt-arrow">→</span></a></div><div class="itt-values">Material<br>Craft<br>Process<br>Experiment</div></div>

  <div class="itt-drop"><div><div class="itt-kicker">DON’T WAIT FOR THE ALGORITHM</div><h2 class="itt-display">GET THE DROP SIGNAL.</h2></div>{% form 'customer', class: 'itt-drop__form' %}<input type="hidden" name="contact[tags]" value="newsletter,ittoldem-house"><label class="visually-hidden" for="IttDropEmail-{{ section.id }}">Email address</label><input id="IttDropEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="EMAIL ADDRESS" required autocomplete="email"><button type="submit">JOIN THE HOUSE <span>→</span></button>{% if form.posted_successfully? %}<p class="itt-drop__status" role="status">YOU’RE IN.</p>{% endif %}{% if form.errors %}<div class="itt-drop__status" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</div>
  <div class="itt-servicebar"><div class="itt-service">✈ &nbsp; WORLDWIDE SHIPPING</div><div class="itt-service">◇ &nbsp; CUSTOM WORK AVAILABLE</div><div class="itt-service">▢ &nbsp; SECURE CHECKOUT</div><div class="itt-service">⌁ &nbsp; DETROIT DESIGN HOUSE</div></div><div class="itt-footer-statement"><strong>ITT TOLD’EM <span class="itt-kicker">MAISON · DÉTROIT</span></strong><em>We built the house. Now we tell ’em.</em></div>
</section>

<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} .itt-house');
    if (!root) return;
    const videos = root.querySelectorAll('video[data-itt-motion]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      videos.forEach((video) => video.pause());
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.play().catch(() => {});
        else entry.target.pause();
      });
    }, { rootMargin: '180px 0px', threshold: 0.05 });
    videos.forEach((video) => observer.observe(video));
  })();
</script>

{% schema %}
{"name":"ITT TOLD'EM House","tag":"section","class":"section-ittoldem-house","settings":[{"type":"header","content":"Campaign media"},{"type":"checkbox","id":"disable_motion_media","label":"Disable bundled motion media","default":false},{"type":"image_picker","id":"hero_image","label":"Static hero override"},{"type":"image_picker","id":"apparel_image","label":"Static Apparel override"},{"type":"image_picker","id":"flagline_image","label":"Static GVO override"},{"type":"image_picker","id":"lab_image","label":"Static The Lab override"},{"type":"image_picker","id":"denim_image","label":"Static Custom Denim override"},{"type":"url","id":"hero_link","label":"Hero link"},{"type":"url","id":"category_link_1","label":"Apparel link"},{"type":"url","id":"gvo_link","label":"GVO link (includes FLAGLINE)"},{"type":"url","id":"category_link_3","label":"The Lab link"},{"type":"url","id":"category_link_4","label":"Custom denim link"},{"type":"url","id":"lab_link","label":"The Lab nav link"},{"type":"collection","id":"featured_collection","label":"Current release collection"},{"type":"url","id":"story_link","label":"About / story link"}],"presets":[{"name":"ITT TOLD'EM House"}]}
{% endschema %}
