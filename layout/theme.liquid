<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {%- render 'view-transition-opt-in' -%}
    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'card-hover-effect-styles' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}
    {{ 'ittoldem-commerce.css' | asset_url | stylesheet_tag }}
    {{ 'itt-real-proof.css' | asset_url | stylesheet_tag }}
    {% if request.page_type == 'index' %}
      <style>
        .itt-x__worlds{position:relative!important;min-height:auto!important;padding:6rem 0 7rem!important;overflow:hidden!important;background:#050505!important;isolation:isolate}
        .itt-x__worlds:before{content:"";position:absolute;inset:-12% -20%;z-index:0;pointer-events:none;background:url('https://cdn.shopify.com/s/files/1/0735/1320/5802/files/ittoldem-cream-background.svg?v=1789092315') center 58%/min(78vw,1100px) auto no-repeat;filter:invert(1) sepia(.12);opacity:.055}
        .itt-x__worldsHead{position:relative!important;z-index:4!important;padding:0 5vw!important;margin:0 0 2.6rem!important;display:flex!important;align-items:flex-end!important;justify-content:space-between!important}
        .itt-x__worldsHead h2{font:italic 400 clamp(5rem,10vw,11rem)/.7 Georgia,serif!important;letter-spacing:-.07em!important;margin:0!important}
        .itt-x__worldgrid{position:relative!important;z-index:3!important;display:flex!important;gap:clamp(14px,2vw,28px)!important;align-items:center!important;width:100%!important;height:min(66svh,680px)!important;min-height:520px!important;padding:3vh 15vw 5vh!important;overflow-x:auto!important;overflow-y:hidden!important;scroll-snap-type:x mandatory!important;scroll-padding-inline:15vw!important;-webkit-overflow-scrolling:touch!important;overscroll-behavior-x:contain!important;border:0!important;scrollbar-width:none!important;perspective:1500px!important}
        .itt-x__worldgrid::-webkit-scrollbar{display:none}
        .itt-x__worldgrid a{position:relative!important;flex:0 0 min(68vw,760px)!important;height:88%!important;min-height:0!important;scroll-snap-align:center!important;padding:1.5rem!important;border:1px solid rgba(255,255,255,.18)!important;display:flex!important;flex-direction:column!important;justify-content:flex-end!important;overflow:hidden!important;color:#f7f0e5!important;background:#111!important;box-shadow:0 38px 120px rgba(0,0,0,.66)!important;transform:scale(.82) rotateY(var(--ry,0deg))!important;opacity:.48!important;filter:saturate(.72) brightness(.7)!important;transition:transform .42s cubic-bezier(.2,.8,.2,1),opacity .42s,filter .42s,border-color .42s!important}
        .itt-x__worldgrid a:nth-child(1){--ry:12deg;background:linear-gradient(180deg,rgba(2,2,2,.08),rgba(2,2,2,.82)),url('https://cdn.shopify.com/s/files/1/0735/1320/5802/files/ittoldem-atelier-daylight-hero.png?v=1789103059') center/cover}
        .itt-x__worldgrid a:nth-child(2){--ry:9deg;background:radial-gradient(circle at 50% 28%,rgba(44,104,150,.42),transparent 38%),linear-gradient(180deg,#091019 0%,#050505 78%)}
        .itt-x__worldgrid a:nth-child(3){--ry:0deg;background:linear-gradient(180deg,rgba(5,5,5,.08),rgba(5,5,5,.68)),url('https://cdn.shopify.com/s/files/1/0735/1320/5802/files/ittoldem-atelier-daylight-hero.png?v=1789103059') center/cover}
        .itt-x__worldgrid a:nth-child(4){--ry:-9deg;background:radial-gradient(circle at 52% 34%,rgba(217,225,229,.18),transparent 42%),linear-gradient(145deg,#111,#030303 68%)}
        .itt-x__worldgrid a:nth-child(5){--ry:-12deg;background:radial-gradient(circle at 70% 20%,rgba(189,134,69,.28),transparent 38%),linear-gradient(160deg,#160e08,#030303 70%)}
        .itt-x__worldgrid a:before{position:absolute;right:1.2rem;top:.7rem;font:italic 400 clamp(4rem,9vw,8.5rem)/1 Georgia,serif;color:rgba(255,255,255,.13);letter-spacing:-.08em;z-index:2}.itt-x__worldgrid a:nth-child(1):before{content:"01"}.itt-x__worldgrid a:nth-child(2):before{content:"02"}.itt-x__worldgrid a:nth-child(3):before{content:"03"}.itt-x__worldgrid a:nth-child(4):before{content:"04"}.itt-x__worldgrid a:nth-child(5):before{content:"05"}
        .itt-x__worldgrid a:after{content:"ENTER WORLD →";position:absolute;left:1.5rem;bottom:1.25rem;font:600 9px/1 Arial,sans-serif;letter-spacing:.25em;color:rgba(255,255,255,.72);opacity:0;transform:translateY(10px);transition:.35s ease}
        .itt-x__worldgrid a b,.itt-x__worldgrid a span{position:relative;z-index:3;text-shadow:0 5px 25px rgba(0,0,0,.7)}
        .itt-x__worldgrid a b{font:600 10px/1.2 Arial,sans-serif!important;letter-spacing:.27em!important;margin-bottom:auto!important}
        .itt-x__worldgrid a span{font:italic 400 clamp(3rem,6vw,6rem)/.78 Georgia,serif!important;letter-spacing:-.055em!important;max-width:9ch!important;margin-bottom:2.8rem!important}
        .itt-x__worldgrid a.is-world-active{transform:scale(1) rotateY(0deg)!important;opacity:1!important;filter:none!important;border-color:rgba(201,168,97,.72)!important;z-index:8!important}
        .itt-x__worldgrid a.is-world-active:after{opacity:1;transform:none}
        .itt-x__worldgrid a.is-world-left{transform:scale(.82) rotateY(12deg) translateX(3vw)!important}.itt-x__worldgrid a.is-world-right{transform:scale(.82) rotateY(-12deg) translateX(-3vw)!important}
        .itt-world-progress{position:relative;z-index:4;display:flex;justify-content:center;gap:10px;margin-top:1.4rem}.itt-world-progress button{width:40px;height:3px;padding:0;border:0;background:rgba(255,255,255,.18);border-radius:999px}.itt-world-progress button.is-active{background:#f0e7d7}
        @media(max-width:900px){.itt-x__worlds{padding-top:4.5rem!important}.itt-x__worldsHead{padding-inline:24px!important;margin-bottom:1.5rem!important}.itt-x__worldsHead h2{font-size:14vw!important}.itt-x__worldgrid{height:64svh!important;min-height:560px!important;padding:2vh 12vw 4vh!important;scroll-padding-inline:12vw!important}.itt-x__worldgrid a{flex-basis:72vw!important;height:92%!important}.itt-x__worldgrid a span{font-size:7vw!important}}
        @media(max-width:560px){.itt-x__worldgrid{height:68svh!important;min-height:520px!important;padding-inline:8vw!important;scroll-padding-inline:8vw!important}.itt-x__worldgrid a{flex-basis:84vw!important}.itt-x__worldgrid a span{font-size:12vw!important}}
      </style>
    {% endif %}
    {% if request.design_mode %}{%- render 'theme-editor' -%}{% endif %}
    {{ content_for_header }}
  </head>
  <body class="template-{{ request.page_type | handle }} page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    {% render 'chat-drawer' %}
    <div class="page-wrapper">
      <div id="header-group">{% sections 'header-group' %}</div>
      <script>
        window.measureHeaderHeights=(function(){let measured=false;return function(){if(measured)return;const header=document.querySelector('#header-component');const group=document.querySelector('#header-group');if(!header||!group)return;measured=true;const h=header.offsetHeight;let gh=0;for(const el of group.children){if(el instanceof HTMLElement)gh+=el.offsetHeight}if(header.hasAttribute('transparent')&&header.parentElement?.nextElementSibling)gh+=h;document.body.style.setProperty('--header-height',`${h}px`);document.body.style.setProperty('--header-group-height',`${gh}px`)}})();
        if(document.querySelector('#header-component')?.hasAttribute('transparent'))measureHeaderHeights();
        (function(){const h=document.querySelector('#header-component');const r=h?.querySelector('.header__row--top');if(!r)return;requestAnimationFrame(()=>h.style.setProperty('--top-row-height',`${r.getBoundingClientRect().height}px`))})();
        (function(){const h=document.querySelector('#header-component');const s=document.querySelector('#header-group .header-section');if(!s||!h?.hasAttribute('transparent'))return;if(!s.nextElementSibling?.classList.contains('shopify-section'))document.body.style.setProperty('--transparent-header-offset-boolean','1')})();
        (function(){const h=document.querySelector('#header-component');if(h){const touch='ontouchstart'in window&&navigator.maxTouchPoints>0;const o=h.querySelector('overflow-list');h.dataset.menuStyle=touch||(o&&o.hasAttribute('minimum-reached'))?'drawer':'menu'}})();
      </script>
      <main id="MainContent" class="content-for-layout" role="main" data-page-transition-enabled="{{ settings.page_transition_enabled }}" data-product-transition="{{ settings.transition_to_main_product }}" data-template="{{ template }}">{{ content_for_layout }}</main>
      {% unless request.page_type == 'index' %}{% render 'itt-house-trust' %}{% endunless %}
      <footer>{% sections 'footer-group' %}</footer>
    </div>
    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}
    {% render 'search-modal' %}
    {% if settings.quick_add or settings.mobile_quick_add %}{% render 'quick-add-modal' %}{% endif %}
    <script src="{{ 'itt-real-proof.js' | asset_url }}" defer></script>
    {% if request.page_type == 'index' %}
      <script src="{{ 'itt-horizontal-parallax.js' | asset_url }}" defer></script>
      <script>
        (()=>{const boot=()=>{const rail=document.querySelector('.itt-x__worldgrid');if(!rail||rail.dataset.carouselReady)return;rail.dataset.carouselReady='1';const cards=[...rail.querySelectorAll('a')];if(cards.length<3)return;const progress=document.createElement('div');progress.className='itt-world-progress';cards.forEach((_,i)=>{const b=document.createElement('button');b.type='button';b.setAttribute('aria-label','Show world '+(i+1));b.addEventListener('click',()=>cards[i].scrollIntoView({behavior:'smooth',inline:'center',block:'nearest'}));progress.appendChild(b)});rail.after(progress);const dots=[...progress.children];const setActive=(idx)=>{cards.forEach((c,i)=>{c.classList.toggle('is-world-active',i===idx);c.classList.toggle('is-world-left',i<idx);c.classList.toggle('is-world-right',i>idx)});dots.forEach((d,i)=>d.classList.toggle('is-active',i===idx))};const nearest=()=>{const rc=rail.getBoundingClientRect(),cx=rc.left+rc.width/2;let best=0,dist=1e9;cards.forEach((c,i)=>{const r=c.getBoundingClientRect(),d=Math.abs((r.left+r.width/2)-cx);if(d<dist){dist=d;best=i}});setActive(best)};let raf=0;rail.addEventListener('scroll',()=>{cancelAnimationFrame(raf);raf=requestAnimationFrame(nearest)},{passive:true});setActive(2);requestAnimationFrame(()=>cards[2].scrollIntoView({behavior:'auto',inline:'center',block:'nearest'}));setTimeout(nearest,80);};if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();document.addEventListener('shopify:section:load',boot)})();
      </script>
    {% endif %}
  </body>
</html>