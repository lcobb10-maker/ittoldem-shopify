{%- liquid
  assign gvo_url = routes.search_url | append: '?view=gvo&type=product&q=GVO'
  assign flagline_url = routes.search_url | append: '?view=flagline&type=product&q=FLAGLINE'
  assign custom_url = routes.search_url | append: '?view=custom&type=product&q=CUSTOM'
  assign wehair_url = routes.search_url | append: '?view=wehair&type=product&q=WE%20HAIR'
  assign lab_url = routes.search_url | append: '?view=lab&type=product&q=CROCHET'
  assign about_url = routes.search_url | append: '?view=about&q=ITT'
  assign contact_page = pages['contact']
  assign contact_url = contact_page.url | default: routes.root_url
-%}
<footer class="itt-footer">
  <div class="itt-footer__lead">
    <div>
      <div class="itt-footer__eyebrow">MAISON · DÉTROIT — EAST SIDE</div>
      <div class="itt-footer__brand">ITT TOLD’EM</div>
      <p>Limited editions, sport culture and one-of-one commissions shaped through a Detroit point of view.</p>
    </div>
    <div class="itt-footer__signal">
      {% if request.page_type == 'index' %}
        <div class="itt-footer__eyebrow">SIGNATURE DE LA MAISON</div>
        <div class="itt-footer__signature">I told ’em.<small>JE VOUS L’AVAIS DIT.</small></div>
      {% else %}
        <div class="itt-footer__eyebrow">LA LETTRE DE LA MAISON</div>
        {% form 'customer', class: 'itt-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,ittoldem-footer">
          <label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email address</label>
          <input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="EMAIL ADDRESS" autocomplete="email" required>
          <button type="submit">ENTER →</button>
          {% if form.posted_successfully? %}<p role="status">BIENVENUE. YOU’RE IN.</p>{% endif %}
          {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        {% endform %}
      {% endif %}
    </div>
  </div>

  <div class="itt-footer__grid">
    <div><span>COLLECTIONS</span><a href="{{ routes.all_products_collection_url }}">The Archive</a>{% if collections['house-edit'] != blank %}<a href="{{ collections['house-edit'].url }}">The House Edit</a>{% endif %}{% if collections['hoodie-season'] != blank %}<a href="{{ collections['hoodie-season'].url }}">Hoodie Season</a>{% endif %}{% if collections['fan-gear'] != blank %}<a href="{{ collections['fan-gear'].url }}">Fan Gear</a>{% endif %}{% if collections['after-dark'] != blank %}<a href="{{ collections['after-dark'].url }}">Après Minuit</a>{% endif %}</div>
    <div><span>LA MAISON</span><a href="{{ custom_url | escape }}">L’Atelier</a><a href="{{ wehair_url | escape }}">We Hair</a><a href="{{ lab_url | escape }}">Le Laboratoire</a><a href="{{ about_url | escape }}">Our Story</a></div>
    <div><span>CLIENT SERVICES</span><a href="{{ contact_url }}">Contact</a><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Cart</a></div>
    <div><span>LEGAL</span>{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Returns</a>{% endif %}{% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping</a>{% endif %}{% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{% endif %}{% if shop.terms_of_service != blank %}<a href="{{ shop.terms_of_service.url }}">Terms</a>{% endif %}</div>
  </div>
  <div class="itt-footer__bottom"><span>© {{ 'now' | date: '%Y' }} ITT TOLD’EM · MAISON DÉTROIT</span><span>I TOLD ’EM. JE VOUS L’AVAIS DIT.</span></div>
</footer>

{% stylesheet %}
.itt-footer{background:#050505;color:#f4efe6}.itt-footer a{color:inherit;text-decoration:none}.itt-footer__lead{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;padding:46px max(24px,5vw);border-top:1px solid #242424}.itt-footer__eyebrow{font-size:.64rem;letter-spacing:.2em;text-transform:uppercase;opacity:.62}.itt-footer__brand{font-family:var(--font-heading--family,serif);font-size:clamp(2.8rem,5.8vw,5.8rem);line-height:.88;letter-spacing:-.05em;margin:12px 0 16px}.itt-footer__lead p{max-width:36rem;line-height:1.6;opacity:.72}.itt-footer__signature{margin-top:14px;font-family:cursive;font-size:clamp(2.5rem,5vw,5rem);line-height:.9;transform:rotate(-4deg)}.itt-footer__signature small{display:block;margin-top:18px;font-family:var(--font-body--family,sans-serif);font-size:.62rem;letter-spacing:.22em;transform:rotate(4deg)}.itt-footer__form{display:grid;grid-template-columns:1fr auto;margin-top:18px}.itt-footer__form input{min-width:0;background:transparent;color:inherit;border:1px solid #555;padding:14px;min-height:50px;border-radius:0}.itt-footer__form button{background:#f4efe6;color:#111;border:1px solid #f4efe6;padding:0 20px;min-height:50px;font-weight:700;letter-spacing:.08em}.itt-footer__form p,.itt-footer__form div{grid-column:1/-1;font-size:.72rem;letter-spacing:.08em;margin-top:9px}.itt-footer__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;padding:30px max(24px,5vw);border-top:1px solid #242424}.itt-footer__grid>div{display:flex;flex-direction:column;gap:9px}.itt-footer__grid span{font-size:.66rem;letter-spacing:.15em;font-weight:700;opacity:.58;margin-bottom:7px}.itt-footer__grid a{font-size:.88rem}.itt-footer__grid a:hover{text-decoration:underline;text-underline-offset:4px}.itt-footer__bottom{display:flex;justify-content:space-between;gap:24px;padding:18px max(24px,5vw);border-top:1px solid #242424;font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;opacity:.72}@media(max-width:749px){.itt-footer__lead{grid-template-columns:1fr;padding:34px 20px;gap:30px}.itt-footer__grid{grid-template-columns:1fr 1fr;padding:28px 20px}.itt-footer__bottom{flex-direction:column;padding:18px 20px}.itt-footer__form{grid-template-columns:1fr}.itt-footer__form button{padding:14px}}
{% endstylesheet %}

{% schema %}
{"name":"ITT TOLD'EM Footer","tag":"section","settings":[],"presets":[{"name":"ITT TOLD'EM Footer"}]}
{% endschema %}
