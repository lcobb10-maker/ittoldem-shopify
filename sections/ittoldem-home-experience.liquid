<section class="itt-x" id="IttX-{{ section.id }}">
  <style>
    #IttX-{{ section.id }}{--ink:#050505;--bone:#f0e7d7;--gold:#c9a861;--p:0;background:var(--ink);color:#f8f3ea;overflow:clip;isolation:isolate}
    #IttX-{{ section.id }} *{box-sizing:border-box}#IttX-{{ section.id }} a{color:inherit;text-decoration:none}
    .itt-x__hero{position:relative;height:100svh;min-height:720px;overflow:hidden;background:#060504;view-timeline-name:--hero;view-timeline-axis:block}
    .itt-x__heroimg{position:absolute;inset:-6%;z-index:0;will-change:transform;animation:heroDrift linear both;animation-timeline:--hero;animation-range:entry 0% exit 100%}.itt-x__heroimg img{width:100%;height:100%;object-fit:cover;object-position:center;filter:brightness(.56) saturate(.78) contrast(1.14);transform:scale(1.04)}
