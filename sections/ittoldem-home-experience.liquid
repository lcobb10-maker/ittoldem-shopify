    .itt-x__mast{position:absolute;left:4vw;right:4vw;top:49%;transform:translateY(-50%);z-index:8;pointer-events:none}.itt-x__word{display:flex;align-items:flex-start;font-family:Georgia,serif;font-style:italic;font-size:clamp(6rem,15vw,15rem);line-height:.67;letter-spacing:-.1em;white-space:nowrap;text-shadow:0 18px 44px rgba(0,0,0,.55)}.itt-x__letter{position:relative;display:inline-block;will-change:transform,opacity;animation:breakLetter linear both;animation-timeline:--hero;animation-range:entry 16% exit 78%}.itt-x__letter:nth-child(2n){--rx:10deg;--tx:4vw;--ty:46vh}.itt-x__letter:nth-child(3n){--rx:-13deg;--tx:-3vw;--ty:58vh}.itt-x__letter:nth-child(4n){--rx:17deg;--tx:6vw;--ty:68vh}.itt-x__letter:nth-child(5n){--rx:-19deg;--tx:-5vw;--ty:52vh}@keyframes breakLetter{0%,22%{transform:none;opacity:1;filter:blur(0)}75%{opacity:.88}100%{transform:translate3d(var(--tx,2vw),var(--ty,62vh),100px) rotate(var(--rx,14deg)) scale(.82);opacity:0;filter:blur(1px)}}
    .itt-x__tm{font:normal 500 .9rem/1 Arial,sans-serif;margin:.15em 0 0 .25em;letter-spacing:0}.itt-x__thought{margin:1.6rem 0 0 10vw;font-size:.68rem;letter-spacing:.32em;text-transform:uppercase;color:rgba(248,243,234,.78)}
    .itt-x__herofoot{position:absolute;z-index:9;left:4vw;right:4vw;bottom:4vh;display:flex;justify-content:space-between;align-items:end;gap:2rem}.itt-x__eyebrow{font-size:.54rem;letter-spacing:.3em;text-transform:uppercase;opacity:.72}.itt-x__herofoot p{max-width:34rem;margin:.55rem 0 0;font-size:.8rem;line-height:1.55;color:rgba(248,243,234,.7)}.itt-x__herolinks{display:flex;gap:1.2rem;font-size:.55rem;letter-spacing:.18em;text-transform:uppercase}
    .itt-x__rain{position:fixed;inset:0;z-index:35;pointer-events:none;overflow:hidden;opacity:0;transition:opacity .2s linear}.itt-x.itt-x--active .itt-x__rain{opacity:1}.itt-x__drop{position:absolute;top:-18vh;font-size:clamp(.62rem,1vw,.88rem);letter-spacing:.22em;text-transform:uppercase;color:rgba(246,240,229,.68);text-shadow:0 0 18px rgba(201,168,97,.16);animation:houseRain var(--dur) linear infinite;animation-delay:var(--delay);will-change:transform}.itt-x__drop:nth-child(3n){font-family:Georgia,serif;font-style:italic;text-transform:none;color:rgba(201,168,97,.82);font-size:clamp(.8rem,1.3vw,1.1rem)}@keyframes houseRain{to{transform:translate3d(var(--drift,0),128vh,0) rotate(var(--rot,0deg))}}
    .itt-x__trim{position:fixed;top:0;bottom:0;width:clamp(34px,4.6vw,70px);z-index:34;pointer-events:none;opacity:0;background-image:linear-gradient(rgba(5,5,5,.1),rgba(5,5,5,.1)),url('https://cdn.shopify.com/s/files/1/0735/1320/5802/files/ittoldem-pyramid-textile-scroll-trim.jpg?v=1789035130');background-size:auto 145%;background-position:center var(--trimY,50%);filter:sepia(.08) contrast(1.1) brightness(.76);box-shadow:0 0 35px rgba(0,0,0,.7);transition:opacity .25s ease,transform .25s ease}.itt-x__trim:after{content:"";position:absolute;top:0;bottom:0;width:1px;background:linear-gradient(transparent,rgba(201,168,97,.9) 14%,rgba(248,243,234,.55) 50%,rgba(201,168,97,.9) 86%,transparent)}.itt-x__trim--l{left:0;transform:translateX(-105%)}.itt-x__trim--l:after{right:6px}.itt-x__trim--r{right:0;transform:translateX(105%) scaleX(-1)}.itt-x__trim--r:after{right:6px}.itt-x.itt-x--active .itt-x__trim{opacity:.95;transform:translateX(0)}.itt-x.itt-x--active .itt-x__trim--r{transform:translateX(0) scaleX(-1)}
    .itt-x__commerce{position:relative;background:var(--bone);color:#090909;padding:clamp(5rem,9vw,9rem) clamp(1.2rem,5vw,5rem);min-height:120svh;view-timeline-name:--shop}.itt-x__shophead{display:grid;grid-template-columns:1fr auto;align-items:end;gap:2rem;margin-bottom:5rem}.itt-x__shophead h2{margin:.35rem 0 0;font-size:clamp(4rem,9vw,9rem);line-height:.78;letter-spacing:-.075em;text-transform:uppercase;font-weight:500}.itt-x__shophead p{max-width:20rem;font-size:.75rem;line-height:1.55;opacity:.65}
    .itt-x__productstage{position:relative;min-height:78svh;display:grid;place-items:center}.itt-x__product{position:relative;width:min(72vw,860px);display:grid;grid-template-columns:1.15fr .85fr;gap:3rem;align-items:center}.itt-x__productmedia{position:relative;aspect-ratio:4/5;overflow:hidden;background:#d9cfbd;clip-path:polygon(0 7%,91% 0,100% 92%,9% 100%);transform:rotate(-2deg);box-shadow:0 30px 70px rgba(0,0,0,.14)}.itt-x__productmedia img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s cubic-bezier(.2,.8,.2,1)}.itt-x__product:hover img{transform:scale(1.03)}.itt-x__productcopy h3{font:italic 400 clamp(3.2rem,7vw,7rem)/.82 Georgia,serif;letter-spacing:-.06em;margin:0 0 1rem}.itt-x__price{font-size:.62rem;letter-spacing:.2em;text-transform:uppercase}.itt-x__shopcta{display:inline-flex;margin-top:1.6rem;padding:.8rem 0;border-bottom:1px solid #111;font-size:.58rem;letter-spacing:.18em;text-transform:uppercase}
    .itt-x__ribbon{position:absolute;left:-15vw;right:-15vw;top:47%;height:clamp(54px,7vw,92px);z-index:4;pointer-events:none;background-image:url('https://cdn.shopify.com/s/files/1/0735/1320/5802/files/ittoldem-pyramid-textile-scroll-trim.jpg?v=1789035130');background-size:auto 540%;background-position:center;filter:contrast(1.08) brightness(.82);transform:rotate(-4deg) translateY(-50%) perspective(800px) rotateX(8deg);box-shadow:0 18px 40px rgba(0,0,0,.24);mix-blend-mode:multiply;animation:ribbonMove linear both;animation-timeline:--shop;animation-range:entry 0% exit 85%}@keyframes ribbonMove{from{transform:translateX(-12%) rotate(-5deg) translateY(-50%) perspective(800px) rotateX(10deg)}to{transform:translateX(12%) rotate(3deg) translateY(-30%) perspective(800px) rotateX(-8deg)}}
    .itt-x__process{position:relative;min-height:170svh;background:#040404;color:#f8f3ea;view-timeline-name:--process;overflow:hidden}.itt-x__processSticky{position:sticky;top:0;height:100svh;min-height:720px;overflow:hidden;display:grid;place-items:center}.itt-x__processTitle{position:absolute;left:4vw;top:5vh;z-index:9;font-size:clamp(4rem,10vw,10rem);line-height:.73;letter-spacing:-.08em;text-transform:uppercase;max-width:90vw}.itt-x__processNote{position:absolute;right:5vw;top:11vh;z-index:9;width:16rem;font-size:.7rem;line-height:1.6;color:rgba(248,243,234,.55)}
    .itt-x__film{position:absolute;overflow:hidden;background:#111;box-shadow:0 35px 110px rgba(0,0,0,.65);will-change:transform}.itt-x__film video{width:100%;height:100%;object-fit:cover;filter:saturate(.78) contrast(1.08) brightness(.76)}.itt-x__film--eye{width:min(58vw,760px);height:58vh;left:7vw;top:27%;clip-path:ellipse(48% 34% at 50% 50%);animation:filmEye linear both;animation-timeline:--process;animation-range:entry 10% exit 85%}.itt-x__film--cut{width:min(36vw,480px);height:44vh;right:8vw;top:35%;clip-path:polygon(50% 0,100% 100%,0 100%);animation:filmCut linear both;animation-timeline:--process;animation-range:entry 10% exit 85%}.itt-x__film--press{width:min(31vw,420px);height:34vh;right:19vw;bottom:3%;clip-path:polygon(7% 0,100% 8%,91% 100%,0 88%);animation:filmPress linear both;animation-timeline:--process;animation-range:entry 10% exit 85%}@keyframes filmEye{to{transform:translate3d(16vw,-9vh,100px) rotate(5deg) scale(1.12)}}@keyframes filmCut{to{transform:translate3d(-13vw,10vh,150px) rotate(-8deg) scale(1.08)}}@keyframes filmPress{to{transform:translate3d(-11vw,-13vh,220px) rotate(6deg) scale(1.12)}}
    .itt-x__ghost{position:absolute;left:50%;top:52%;transform:translate(-50%,-50%);font:italic 400 clamp(10rem,28vw,28rem)/.7 Georgia,serif;color:rgba(248,243,234,.045);white-space:nowrap}.itt-x__line{position:absolute;left:-8vw;right:-8vw;top:57%;height:1px;background:linear-gradient(90deg,transparent,rgba(201,168,97,.75),rgba(248,243,234,.55),transparent);transform:rotate(-8deg)}
    .itt-x__atelier{position:relative;background:var(--bone);color:#070707;padding:clamp(6rem,10vw,10rem) clamp(1.2rem,5vw,5rem);display:grid;grid-template-columns:.8fr 1.2fr;gap:5vw;align-items:center;min-height:100svh}.itt-x__atelierCopy{align-self:center}.itt-x__atelierCopy h2{margin:.5rem 0 1.2rem;font:italic 400 clamp(4.2rem,9vw,9rem)/.8 Georgia,serif;letter-spacing:-.065em}.itt-x__atelierCopy p{max-width:31rem;font-size:.84rem;line-height:1.7;color:rgba(0,0,0,.68)}.itt-x__atelierCta{display:inline-flex;margin-top:1.6rem;padding:.85rem 0;border-bottom:1px solid #111;font-size:.58rem;letter-spacing:.18em;text-transform:uppercase}.itt-x__atelierImage{position:relative;min-height:76svh;overflow:hidden;background:#d9cfbd;clip-path:polygon(0 4%,94% 0,100% 94%,7% 100%)}.itt-x__atelierImage img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.itt-x__atelierImage:after{content:"I TOLD ’EM.";position:absolute;right:1rem;bottom:1rem;color:#fff;font:italic 400 clamp(2rem,4vw,4.5rem)/1 Georgia,serif;text-shadow:0 4px 18px rgba(0,0,0,.5)}
    .itt-x__worlds{background:#050505;color:#f5efe5;padding:5rem 4vw 7rem}.itt-x__worldsHead{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:3rem}.itt-x__worldsHead h2{font:italic 400 clamp(3.8rem,8vw,8rem)/.8 Georgia,serif;margin:0}.itt-x__worldgrid{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid rgba(255,255,255,.16);border-bottom:1px solid rgba(255,255,255,.16)}.itt-x__worldgrid a{min-height:180px;padding:1.1rem;border-right:1px solid rgba(255,255,255,.13);display:flex;flex-direction:column;justify-content:space-between;transition:background .3s,color .3s}.itt-x__worldgrid a:last-child{border-right:0}.itt-x__worldgrid a:hover{background:var(--bone);color:#090909}.itt-x__worldgrid b{font-size:.66rem;letter-spacing:.2em;text-transform:uppercase}.itt-x__worldgrid span{font:italic 400 2rem/1 Georgia,serif}
    @media(max-width:900px){.itt-x__hero{min-height:680px}.itt-x__word{font-size:17vw}.itt-x__herofoot{flex-direction:column;align-items:flex-start}.itt-x__product{width:86vw;grid-template-columns:1fr .9fr;gap:2rem}.itt-x__processTitle{font-size:11vw}.itt-x__film--eye{left:-8vw;width:73vw}.itt-x__film--cut{right:1vw;width:42vw}.itt-x__film--press{right:7vw;width:45vw}.itt-x__atelier{grid-template-columns:1fr}.itt-x__atelierImage{min-height:64svh}.itt-x__worldgrid{grid-template-columns:repeat(2,1fr)}.itt-x__worldgrid a:nth-child(2n){border-right:0}}
    @media(max-width:560px){.itt-x__hero{height:92svh;min-height:620px}.itt-x__heroimg{inset:-3% -18%}.itt-x__heroimg img{object-position:58% center}.itt-x__mast{left:18px;right:18px;top:43%}.itt-x__word{font-size:24vw}.itt-x__thought{margin-left:.3rem;font-size:.49rem;letter-spacing:.2em;max-width:80%}.itt-x__herofoot{left:18px;right:18px}.itt-x__herofoot p{max-width:86%;font-size:.74rem}.itt-x__herolinks{flex-wrap:wrap}.itt-x__trim{width:28px}.itt-x__drop:nth-child(even){display:none}.itt-x__shophead{grid-template-columns:1fr}.itt-x__shophead h2{font-size:16vw}.itt-x__product{width:92vw;grid-template-columns:1fr}.itt-x__productmedia{max-height:58svh}.itt-x__ribbon{height:46px;top:41%}.itt-x__processSticky{min-height:620px}.itt-x__processTitle{left:20px;top:4vh;font-size:14vw;max-width:88vw}.itt-x__processNote{left:20px;right:auto;top:19%;width:70%;font-size:.62rem}.itt-x__film--eye{left:-22vw;top:34%;width:88vw;height:43vh}.itt-x__film--cut{right:-10vw;top:37%;width:53vw;height:31vh}.itt-x__film--press{right:-4vw;bottom:3%;width:65vw;height:27vh}.itt-x__atelier{padding-left:1rem;padding-right:1rem}.itt-x__worldgrid{grid-template-columns:1fr}.itt-x__worldgrid a{border-right:0;border-bottom:1px solid rgba(255,255,255,.13);min-height:120px}}
    @media(prefers-reduced-motion:reduce){.itt-x__heroimg,.itt-x__letter,.itt-x__film,.itt-x__ribbon{animation:none!important}.itt-x__rain{display:none}.itt-x__trim{display:none}}
  </style>

  <div class="itt-x__trim itt-x__trim--l" aria-hidden="true"></div><div class="itt-x__trim itt-x__trim--r" aria-hidden="true"></div>
  <div class="itt-x__rain" aria-hidden="true">
    <span class="itt-x__drop" style="left:4%;--dur:12s;--delay:-4s;--drift:3vw;--rot:7deg">FLAGLINE</span><span class="itt-x__drop" style="left:13%;--dur:18s;--delay:-13s;--drift:-2vw;--rot:-8deg">ittoldem™</span><span class="itt-x__drop" style="left:23%;--dur:15s;--delay:-9s;--drift:4vw;--rot:11deg">L’Atelier</span><span class="itt-x__drop" style="left:34%;--dur:20s;--delay:-16s;--drift:-3vw;--rot:-6deg">ONE OF ONE</span><span class="itt-x__drop" style="left:45%;--dur:14s;--delay:-7s;--drift:2vw;--rot:9deg">WE HAIR</span><span class="itt-x__drop" style="left:56%;--dur:17s;--delay:-2s;--drift:-4vw;--rot:-12deg">I TOLD ’EM.</span><span class="itt-x__drop" style="left:67%;--dur:13s;--delay:-10s;--drift:3vw;--rot:5deg">TAILORING</span><span class="itt-x__drop" style="left:77%;--dur:19s;--delay:-15s;--drift:-2vw;--rot:-9deg">ITTELIER</span><span class="itt-x__drop" style="left:87%;--dur:16s;--delay:-6s;--drift:3vw;--rot:8deg">LE LABORATOIRE</span><span class="itt-x__drop" style="left:95%;--dur:21s;--delay:-18s;--drift:-3vw;--rot:-7deg">LA MAISON</span>
  </div>

  <section class="itt-x__hero">
    <div class="itt-x__heroimg">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2800 | image_tag: loading:'eager', fetchpriority:'high', alt:'ittoldem atelier campaign' }}{% endif %}</div><div class="itt-x__shade"></div>
    <div class="itt-x__mast"><div class="itt-x__word" aria-label="ittoldem trademark"><span class="itt-x__letter">i</span><span class="itt-x__letter">t</span><span class="itt-x__letter">t</span><span class="itt-x__letter">o</span><span class="itt-x__letter">l</span><span class="itt-x__letter">d</span><span class="itt-x__letter">e</span><span class="itt-x__letter">m</span><span class="itt-x__tm">™</span></div><div class="itt-x__thought">I TOLD ’EM · SAME THOUGHT / DIFFERENT LEVELS</div></div>
    <div class="itt-x__herofoot"><div><div class="itt-x__eyebrow">MAISON · DÉTROIT — EAST SIDE</div><p>Fashion, tailoring, sportswear and objects. Limited pieces, custom work and ideas made to be worn.</p></div><div class="itt-x__herolinks"><a href="/collections/all">ENTER THE HOUSE →</a><a href="#IttShop-{{ section.id }}">THE HOUSE EDIT ↓</a></div></div>
  </section>

  <section class="itt-x__commerce" id="IttShop-{{ section.id }}"><div class="itt-x__ribbon" aria-hidden="true"></div><div class="itt-x__shophead"><div><div class="itt-x__eyebrow">02 / THE HOUSE EDIT</div><h2>ONE PIECE.<br>FULL ATTENTION.</h2></div><p>No catalog wall. One real garment gets the room, then the next. Commerce behaves like editorial.</p></div>
    {% assign hero_product = all_products['ghost-bloom-polo'] %}{% if hero_product != blank %}<div class="itt-x__productstage"><a class="itt-x__product" href="{{ hero_product.url }}"><div class="itt-x__productmedia">{{ hero_product.featured_image | image_url: width:1600 | image_tag: loading:'lazy', alt:hero_product.title }}</div><div class="itt-x__productcopy"><div class="itt-x__eyebrow">CURRENT RELEASE / LIMITED</div><h3>{{ hero_product.title }}</h3><div class="itt-x__price">{{ hero_product.price | money }}</div><span class="itt-x__shopcta">VIEW THE PIECE →</span></div></a></div>{% endif %}
  </section>

  <section class="itt-x__process"><div class="itt-x__processSticky"><div class="itt-x__ghost">ittoldem™</div><div class="itt-x__line"></div><div class="itt-x__processTitle">THE WORK<br>LEAKS THROUGH.</div><div class="itt-x__processNote">Three processes run together. The films are cut into house geometry instead of sitting in cards.</div>
    <div class="itt-x__film itt-x__film--eye"><video autoplay muted loop playsinline preload="auto" src="https://cdn.shopify.com/videos/c/o/v/87040c4ea6db4c80927dc1f729b4444f.mov"></video></div>
    <div class="itt-x__film itt-x__film--cut"><video autoplay muted loop playsinline preload="auto" src="https://cdn.shopify.com/videos/c/o/v/829da22df9ae4c89ad7479a2440de5fe.mov"></video></div>
    <div class="itt-x__film itt-x__film--press"><video autoplay muted loop playsinline preload="auto" src="https://cdn.shopify.com/videos/c/o/v/cbb48a13846a47ed964d127d0d92947c.mov"></video></div>
  </div></section>

  <section class="itt-x__atelier"><div class="itt-x__atelierCopy"><div class="itt-x__eyebrow">04 / L’ATELIER · COMMISSIONS</div><h2>Made for<br>your body.<br>Not a template.</h2><p>One-of-one work, tailoring, custom garments, team and organization pieces, specialty finishes and material experiments—developed as design work first.</p><a class="itt-x__atelierCta" href="/pages/contact">START A COMMISSION →</a></div><div class="itt-x__atelierImage"><img src="https://cdn.shopify.com/s/files/1/0735/1320/5802/files/IMG_2459.jpg?v=1789002816" loading="lazy" alt="ittoldem custom atelier work"></div></section>

  <section class="itt-x__worlds"><div class="itt-x__worldsHead"><div><div class="itt-x__eyebrow">05 / THE HOUSE</div><h2>Choose a world.</h2></div><div class="itt-x__eyebrow">I TOLD ’EM.</div></div><div class="itt-x__worldgrid"><a href="/collections/all"><b>LA MAISON</b><span>House Edit</span></a><a href="/search?type=product&q=FLAGLINE"><b>FLAGLINE</b><span>Sport / Field</span></a><a href="/pages/contact"><b>L’ATELIER</b><span>Commission</span></a><a href="/search?type=product&q=CROCHET"><b>LE LABORATOIRE</b><span>Material Study</span></a><a href="/search?type=product&q=WE%20HAIR"><b>WE HAIR</b><span>Objects / Hair</span></a></div></section>

  <script>(()=>{const root=document.getElementById('IttX-{{ section.id }}');if(!root)return;const rain=root.querySelector('.itt-x__rain'),trims=root.querySelectorAll('.itt-x__trim'),process=root.querySelector('.itt-x__process'),hero=root.querySelector('.itt-x__hero');root.querySelectorAll('video').forEach(v=>{v.muted=true;v.defaultMuted=true;v.playsInline=true;const p=()=>v.play().catch(()=>{});if(v.readyState>1)p();else v.addEventListener('canplay',p,{once:true})});let ticking=false;const draw=()=>{const h=hero.getBoundingClientRect(),pr=process.getBoundingClientRect(),active=(h.top<innerHeight*.35&&pr.bottom>innerHeight*.2);root.classList.toggle('itt-x--active',active);const pos=((scrollY||document.documentElement.scrollTop)*.18)%100;trims.forEach(t=>t.style.setProperty('--trimY',`${pos}%`));ticking=false};const on=()=>{if(!ticking){requestAnimationFrame(draw);ticking=true}};addEventListener('scroll',on,{passive:true});addEventListener('resize',on,{passive:true});draw()})();</script>
</section>
{% schema %}{"name":"ITT Home Experience","tag":"section","class":"section-itt-home-experience","settings":[{"type":"image_picker","id":"hero_image","label":"Hero image"}],"presets":[{"name":"ITT Home Experience"}]}{% endschema %}