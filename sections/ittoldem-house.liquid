  <div class="itt-categories">
    <a class="itt-card" href="{{ section.settings.category_link_1 | default: routes.all_products_collection_url }}">{% if section.settings.apparel_image != blank %}{{ section.settings.apparel_image | image_url: width: 1400 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM apparel" }}{% endif %}<div class="itt-card__number">01 / PROV. 22:1</div><div class="itt-card__content"><h2 class="itt-card__title">STORE</h2><div class="itt-card__meta">A GOOD NAME IS RATHER TO BE CHOSEN.</div><div class="itt-card__link">SELECT <span>↗</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.gvo_link | default: routes.all_products_collection_url }}">{% if section.settings.flagline_image != blank %}{{ section.settings.flagline_image | image_url: width: 1400 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "FLAGLINE sport" }}{% endif %}<div class="itt-card__number">02 / 1 COR. 9:24</div><div class="itt-card__content"><h2 class="itt-card__title">SPORT</h2><div class="itt-card__meta">SO RUN, THAT YE MAY OBTAIN.</div><div class="itt-card__link">SELECT <span>↗</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.lab_link | default: routes.all_products_collection_url }}">{% if section.settings.lab_image != blank %}{{ section.settings.lab_image | image_url: width: 1400 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM The Lab" }}{% endif %}<div class="itt-card__number">03 / ECC. 9:10</div><div class="itt-card__content"><h2 class="itt-card__title">THE LAB</h2><div class="itt-card__meta">DO IT WITH THY MIGHT.</div><div class="itt-card__link">SELECT <span>↗</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.category_link_4 | default: routes.all_products_collection_url }}">{% if section.settings.denim_image != blank %}{{ section.settings.denim_image | image_url: width: 1400 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM custom work" }}{% endif %}<div class="itt-card__number">04 / EX. 35:35</div><div class="itt-card__content"><h2 class="itt-card__title">ITTelier</h2><div class="itt-card__meta">FILLED WITH WISDOM OF HEART.</div><div class="itt-card__link">SELECT <span>↗</span></div></div></a>
  </div>

  <div class="itt-manifesto"><div class="itt-manifesto__eyebrow">PROVERBS 22:1</div><p>A GOOD NAME <em>IS RATHER TO BE CHOSEN THAN GREAT RICHES.</em></p></div>

  <div class="itt-story">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1900 | image_tag: class: 'itt-story__media', loading: 'lazy', alt: "ITT TOLD’EM house story" }}{% endif %}<div class="itt-story__content"><div class="itt-kicker">COLOSSIANS 3:23</div><h2 class="itt-display itt-story__title">ITT<br>TOLD’EM</h2><p class="itt-story__copy">“And whatsoever ye do, do it heartily, as to the Lord, and not unto men.”</p><a class="itt-btn" href="{{ section.settings.story_link | default: routes.root_url }}">OPEN HOUSE FILE <span>→</span></a></div><div class="itt-values">Faith<br>Work<br>Wisdom<br>Vision</div></div>

