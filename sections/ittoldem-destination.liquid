{{ 'ittoldem-destination.css' | asset_url | stylesheet_tag }}
{%- assign flagline_url = routes.search_url | append: '?view=flagline&type=product&q=FLAGLINE' -%}

<section class="itt-destination itt-destination--{{ section.settings.world }}" aria-labelledby="IttDestinationTitle-{{ section.id }}">
  {% if section.settings.campaign_image != blank %}
    {{ section.settings.campaign_image | image_url: width: 1800 | image_tag: class: 'itt-destination__media', loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1800', sizes: '100vw', alt: section.settings.title }}
  {% else %}
    <div class="itt-destination__media itt-destination__media--empty" aria-hidden="true"></div>
  {% endif %}
  <div class="itt-destination__panel">
    <div class="itt-destination__eyebrow">{{ section.settings.eyebrow }}</div>
    <h1 id="IttDestinationTitle-{{ section.id }}" class="itt-destination__title">{{ section.settings.title }}</h1>
    <p class="itt-destination__copy">{{ section.settings.copy }}</p>
    <div class="itt-destination__meta">{{ section.settings.meta }}</div>
    {% if section.settings.world == 'gvo' %}<a class="itt-destination__cta" href="{{ flagline_url | escape }}">DISCOVER FLAGLINE →</a>{% endif %}
    {% if section.settings.world == 'custom' %}<a class="itt-destination__cta" href="#itt-custom-request">REQUEST A COMMISSION ↓</a>{% endif %}
    <a class="itt-destination__back" href="{{ routes.root_url }}">← RETURN TO LA MAISON</a>
  </div>
</section>

{% if section.settings.world == 'custom' %}
  <section id="itt-custom-request" class="itt-custom-request" aria-labelledby="IttCustomTitle-{{ section.id }}">
    <div>
      <div class="itt-destination__eyebrow">L’ATELIER · PRIVATE COMMISSIONS</div>
      <h2 id="IttCustomTitle-{{ section.id }}">BEGIN WITH THE IDEA.</h2>
      <p>One-of-one garments, team work, engraving, reconstruction and experimental fabrication begin here. Share the intended piece, quantity, measurements, timing and references. The house confirms feasibility and pricing after review.</p>
      <div class="itt-custom-request__note">EACH REQUEST IS REVIEWED · NO AUTOMATIC ACCEPTANCE</div>
    </div>
    {% form 'contact', class: 'itt-custom-form' %}
      <input type="hidden" name="contact[tags]" value="commission-request,ittoldem-atelier">
      <label for="IttCustomName-{{ section.id }}">CLIENT NAME</label>
      <input id="IttCustomName-{{ section.id }}" name="contact[name]" type="text" autocomplete="name" required>
      <label for="IttCustomEmail-{{ section.id }}">EMAIL</label>
      <input id="IttCustomEmail-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" required>
      <label for="IttCustomType-{{ section.id }}">COMMISSION TYPE</label>
      <select id="IttCustomType-{{ section.id }}" name="contact[Commission type]"><option>One-of-one garment</option><option>Engraved denim</option><option>Team / sport project</option><option>Crochet</option><option>Fabrication / prototype</option><option>Other</option></select>
      <label for="IttCustomBody-{{ section.id }}">THE BRIEF</label>
      <textarea id="IttCustomBody-{{ section.id }}" name="contact[body]" rows="7" placeholder="Piece, quantity, measurements, colors, deadline and reference links." required></textarea>
      <button type="submit">SUBMIT FOR REVIEW →</button>
      {% if form.posted_successfully? %}<p class="itt-custom-status" role="status">REQUEST RECEIVED. L’ATELIER WILL REVIEW THE BRIEF.</p>{% endif %}
      {% if form.errors %}<div class="itt-custom-status" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    {% endform %}
  </section>
{% endif %}

{% if search.performed %}
  {% paginate search.results by 24 %}
    {% if search.results_count > 0 %}
      <section class="itt-destination-products" aria-label="{{ section.settings.title | escape }} products">
        <div class="itt-destination-products__head"><h2>{{ section.settings.results_heading }}</h2><div class="itt-destination-products__count">CURATED FROM THE HOUSE</div></div>
        <div class="itt-destination-products__grid">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              <a class="itt-destination-product{% if item.featured_image == blank %} itt-destination-product--awaiting-media{% endif %}" href="{{ item.url }}">
                <div class="itt-destination-product__image">
                  {% if item.featured_image %}
                    {{ item.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(max-width: 749px) 50vw, 25vw', alt: item.title }}
                  {% else %}
                    <div class="itt-destination-product__media-note"><span>PHOTOGRAPHY IN PROGRESS</span><strong>{{ item.title }}</strong></div>
                  {% endif %}
                </div>
                <div class="itt-destination-product__meta"><span class="itt-destination-product__title">{{ item.title }}</span><span class="itt-destination-product__price">{{ item.price | money }}</span></div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}<div class="itt-destination-pagination">{{ paginate | default_pagination }}</div>{% endif %}
      </section>
    {% else %}
      <section class="itt-destination-empty"><div class="itt-destination__eyebrow">PROCHAINE ÉDITION · NEXT EDITION</div><h2>THE NEXT RELEASE IS IN DEVELOPMENT.</h2><p>This house world has no available pieces today. Enter the complete collection or join the private letter for the next release.</p><a href="{{ routes.all_products_collection_url }}">VIEW THE HOUSE EDIT →</a></section>
    {% endif %}
  {% endpaginate %}
{% endif %}

{% stylesheet %}
.itt-custom-request__note{display:inline-block;margin-top:16px;padding-top:13px;border-top:1px solid rgba(244,239,230,.3);font-size:.66rem;letter-spacing:.14em;line-height:1.5}
.itt-destination-product__media-note{width:100%;height:100%;display:flex;flex-direction:column;justify-content:space-between;padding:18px;background:#151515;color:#f4efe6}
.itt-destination-product__media-note span{font-size:.62rem;letter-spacing:.14em;line-height:1.4}
.itt-destination-product__media-note strong{font-family:var(--font-heading--family,serif);font-size:clamp(1.25rem,2.2vw,2.2rem);font-weight:500;line-height:.95;letter-spacing:-.035em;text-transform:uppercase}
.itt-destination-product--awaiting-media{opacity:.82}
{% endstylesheet %}

{% schema %}
{"name":"ITT Destination","tag":"section","settings":[{"type":"header","content":"Campaign image"},{"type":"image_picker","id":"campaign_image","label":"Destination image"},{"type":"select","id":"world","label":"House world","default":"gvo","options":[{"value":"gvo","label":"GVO"},{"value":"flagline","label":"FLAGLINE"},{"value":"wehair","label":"WE HAIR"},{"value":"lab","label":"THE LAB"},{"value":"custom","label":"CUSTOM"},{"value":"apparel","label":"APPAREL"}]},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ITT TOLD’EM · HOUSE WORLD"},{"type":"text","id":"title","label":"Title","default":"GVO"},{"type":"textarea","id":"copy","label":"Copy","default":"Sport, training and culture through the ITT TOLD’EM point of view."},{"type":"text","id":"meta","label":"Meta","default":"DETROIT · SPORT · CULTURE"},{"type":"text","id":"results_heading","label":"Results heading","default":"AVAILABLE NOW"}],"presets":[{"name":"ITT Destination"}]}
{% endschema %}
