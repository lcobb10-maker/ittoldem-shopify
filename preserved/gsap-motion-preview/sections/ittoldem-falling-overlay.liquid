</nav>

<script>
  (() => {
    const fill = document.querySelector('.itt-scroll-meter__fill');
    const pct = document.querySelector('.itt-scroll-meter__pct');
    const links = [...document.querySelectorAll('.itt-command-rail a')];
    if (!fill || !pct) return;
    let ticking = false;
    const update = () => {
      const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      const p = Math.max(0, Math.min(1, scrollY / max));
      fill.style.width = `${p * 100}%`;
      pct.textContent = `${String(Math.round(p * 100)).padStart(3,'0')}%`;
      if (links.length) {
        const idx = Math.min(links.length - 1, Math.floor(p * links.length));
        links.forEach((a,i) => a.classList.toggle('is-active', i === idx));
      }
      ticking = false;
    };
    addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }, {passive:true});
    update();
  })();
</script>

