{%- liquid
  assign flagline_url = routes.search_url | append: '?view=flagline&type=product&q=FLAGLINE'
  assign custom_url = routes.search_url | append: '?view=custom&type=product&q=CUSTOM'
  assign lab_url = routes.search_url | append: '?view=lab&type=product&q=CROCHET'
  assign about_url = routes.search_url | append: '?view=about&q=ITT'
-%}
<nav class="itt-global-nav" aria-label="ITT TOLD'EM primary navigation">
  <a href="{{ about_url | escape }}">LA MAISON</a>
  <a href="{{ routes.all_products_collection_url }}">SHOP</a>
  <a href="{{ flagline_url | escape }}">FLAGLINE</a>
  <a href="{{ custom_url | escape }}">L’ATELIER</a>
  <a href="{{ lab_url | escape }}">LE LABORATOIRE</a>
</nav>

{% stylesheet %}
.itt-global-nav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));background:#050505;color:#f4efe6;border-top:1px solid rgba(244,239,230,.15);border-bottom:1px solid rgba(244,239,230,.15);position:relative}
.itt-global-nav a{min-height:48px;padding:14px 10px;display:flex;align-items:center;justify-content:center;gap:6px;color:inherit;text-decoration:none;text-align:center;border-right:1px solid rgba(244,239,230,.15);font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}
.itt-global-nav a:last-child{border-right:0}.itt-global-nav a:hover,.itt-global-nav a:focus-visible{background:#f4efe6;color:#111}
@media(max-width:1100px){.itt-global-nav{display:flex;overflow-x:auto;overscroll-behavior-inline:contain;scrollbar-width:none;-webkit-overflow-scrolling:touch;scroll-snap-type:x proximity}.itt-global-nav::-webkit-scrollbar{display:none}.itt-global-nav a{min-width:132px;min-height:44px;flex:1 0 auto;padding:12px 16px;font-size:.64rem;letter-spacing:.11em;scroll-snap-align:start}}
@media(max-width:640px){.itt-global-nav a{min-width:118px;min-height:42px;padding:10px 12px;font-size:.6rem}}
{% endstylesheet %}

{% schema %}
{"name":"ITT House Navigation","tag":"section","settings":[],"presets":[{"name":"ITT House Navigation"}]}
{% endschema %}
