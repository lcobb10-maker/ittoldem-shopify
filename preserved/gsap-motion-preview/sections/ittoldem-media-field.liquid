<section class="itt-field" id="IttField-{{ section.id }}">
  <style>
    .itt-v3__cinema,.itt-v3__archive,.section-itt-watch-four{display:none!important}
    #IttField-{{ section.id }}{--ink:#050505;--paper:#f2eadc;--gold:#d7b56c;position:relative;background:var(--ink);color:#f7f2e8;min-height:190svh;overflow:clip;isolation:isolate}
    #IttField-{{ section.id }} *{box-sizing:border-box}
    .itt-field__sticky{position:sticky;top:0;height:100svh;min-height:720px;overflow:hidden;touch-action:pan-y;background:radial-gradient(circle at 50% 48%,rgba(215,181,108,.07),transparent 27%),linear-gradient(180deg,#070706,#020202 72%,#070706);perspective:1200px}
    .itt-field__trim{position:absolute;top:0;bottom:0;width:clamp(38px,5.2vw,78px);z-index:18;opacity:var(--trim,0);background-image:linear-gradient(rgba(244,238,225,.08),rgba(244,238,225,.08)),url('https://cdn.shopify.com/s/files/1/0735/1320/5802/files/ittoldem-pyramid-textile-scroll-trim.jpg?v=1789035130');background-size:auto 145%;background-position:center calc(50% + var(--p,0) * -170px);filter:sepia(.16) contrast(1.12) brightness(.76);box-shadow:0 0 38px rgba(0,0,0,.72);will-change:opacity,transform,background-position}
    .itt-field__trim:after{content:"";position:absolute;top:0;bottom:0;width:1px;background:linear-gradient(transparent,rgba(215,181,108,.8) 12%,rgba(247,242,232,.55) 50%,rgba(215,181,108,.8) 88%,transparent)}
    .itt-field__trim--l{left:0;transform:translateX(calc((1 - var(--trim,0)) * -105%));border-right:1px solid rgba(215,181,108,.35)}.itt-field__trim--l:after{right:6px}
    .itt-field__trim--r{right:0;transform:translateX(calc((1 - var(--trim,0)) * 105%)) scaleX(-1);border-left:1px solid rgba(215,181,108,.35)}.itt-field__trim--r:after{right:6px}
    .itt-field__rain{position:absolute;inset:0;z-index:15;pointer-events:none;overflow:hidden;opacity:calc(.28 + var(--rain,0) * .72);mix-blend-mode:screen}
    .itt-field__drop{position:absolute;top:-26%;writing-mode:vertical-rl;text-orientation:mixed;text-transform:uppercase;letter-spacing:.18em;font-size:clamp(.52rem,.85vw,.72rem);font-weight:500;color:rgba(247,242,232,.72);text-shadow:0 0 18px rgba(215,181,108,.16);animation:ittFieldRain var(--dur) linear infinite;animation-delay:var(--delay);will-change:transform}
    .itt-field__drop:nth-child(3n){font-family:Georgia,serif;font-style:italic;text-transform:none;font-size:clamp(.7rem,1.2vw,1rem);color:rgba(215,181,108,.88)}
    .itt-field__drop:nth-child(4n){font-size:.48rem;letter-spacing:.28em;color:rgba(247,242,232,.48)}
    @keyframes ittFieldRain{to{transform:translate3d(0,145svh,0) rotate(.001deg)}}
    .itt-field__grain{position:absolute;inset:0;pointer-events:none;z-index:22;opacity:.13;background-image:radial-gradient(circle,rgba(255,255,255,.5) .5px,transparent .7px);background-size:4px 4px;mix-blend-mode:soft-light;mask-image:linear-gradient(118deg,#000,transparent 44%,#000)}
    .itt-field__head{position:absolute;z-index:17;left:clamp(3.6rem,8vw,8rem);top:clamp(2.5rem,6vw,5.5rem);max-width:82vw}.itt-field__kicker{font-size:.56rem;letter-spacing:.34em;text-transform:uppercase;color:rgba(247,242,232,.62)}
    .itt-field__title{margin:.7rem 0 0;font-size:clamp(4.3rem,10.4vw,10.8rem);font-weight:500;letter-spacing:-.085em;line-height:.72;text-transform:uppercase;white-space:nowrap;transform-origin:left center;will-change:transform,filter}.itt-field__title span{display:inline-block;will-change:transform,opacity}
    .itt-field__note{position:absolute;z-index:17;right:clamp(4rem,8vw,9rem);top:15%;max-width:17rem;font-size:.7rem;line-height:1.65;color:rgba(247,242,232,.56);letter-spacing:.025em;transform:translateY(calc(var(--p,0) * -38px))}
    .itt-field__stage{position:absolute;inset:0;z-index:6}.itt-field__piece{position:absolute;overflow:hidden;background:#0b0b0b;box-shadow:0 34px 110px rgba(0,0,0,.72),0 0 0 1px rgba(238,229,213,.09);will-change:transform,filter,opacity;transform-origin:center;backface-visibility:hidden}.itt-field__piece video{width:100%;height:100%;display:block;object-fit:cover;filter:saturate(.82) contrast(1.1) brightness(.76);transform:scale(1.035)}
    .itt-field__piece:before{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(140deg,rgba(0,0,0,.08),transparent 44%,rgba(0,0,0,.58)),radial-gradient(circle at center,transparent 33%,rgba(0,0,0,.58) 100%)}
    .itt-field__one{left:6vw;top:31%;width:min(49vw,660px);height:47vh;min-height:350px;clip-path:polygon(2% 10%,94% 0,100% 88%,8% 100%);transform:translate3d(calc(var(--p,0) * 6vw),calc(var(--p,0) * -4vh),0) rotate(calc(-2.5deg + var(--p,0) * 4deg)) scale(calc(.98 + var(--p,0) * .07))}
    .itt-field__two{right:8vw;top:31%;width:min(24vw,330px);height:34vh;min-height:250px;clip-path:polygon(9% 0,100% 7%,91% 100%,0 89%);transform:translate3d(calc(var(--p,0) * -6vw),calc(var(--p,0) * 8vh),70px) rotate(calc(3deg - var(--p,0) * 7deg)) scale(calc(.92 + var(--p,0) * .1))}
    .itt-field__three{right:15vw;bottom:3%;width:min(37vw,510px);height:31vh;min-height:235px;clip-path:polygon(5% 14%,94% 0,100% 88%,12% 100%);transform:translate3d(calc(var(--p,0) * -8vw),calc(var(--p,0) * -10vh),110px) rotate(calc(-2deg + var(--p,0) * 5deg)) scale(calc(.94 + var(--p,0) * .12))}
    .itt-field__label{position:absolute;z-index:5;left:1rem;bottom:1rem;max-width:15rem;text-shadow:0 2px 16px #000}.itt-field__label span{font-size:.48rem;letter-spacing:.22em;text-transform:uppercase;opacity:.72}.itt-field__label h3{margin:.3rem 0 0;font-size:clamp(1.12rem,1.9vw,2rem);line-height:.9;text-transform:uppercase;letter-spacing:-.035em}
    .itt-field__monogram{position:absolute;z-index:5;left:50%;top:54%;transform:translate(-50%,-50%) scale(calc(.88 + var(--p,0)*.22));font-family:Georgia,serif;font-style:italic;font-size:clamp(8rem,22vw,23rem);line-height:.65;letter-spacing:-.1em;color:rgba(238,229,213,.055);white-space:nowrap;pointer-events:none}
    .itt-field__slash{position:absolute;z-index:14;left:-8vw;top:58%;width:116vw;height:1px;background:linear-gradient(90deg,transparent,rgba(238,229,213,.9) 24%,rgba(215,181,108,.7) 53%,transparent 84%);transform:rotate(calc(-7deg + var(--p,0) * 10deg)) scaleX(calc(.38 + var(--p,0) * .78));transform-origin:center;box-shadow:0 0 20px rgba(215,181,108,.28)}
    .itt-field__edition{position:absolute;z-index:16;bottom:4.5%;left:clamp(4rem,8vw,8rem);font-size:.52rem;letter-spacing:.34em;text-transform:uppercase;color:rgba(247,242,232,.54)}
    .itt-field__veil{position:absolute;inset:0;z-index:16;pointer-events:none;background:linear-gradient(180deg,#050505 0,transparent 13%,transparent 86%,#050505 100%),linear-gradient(90deg,rgba(0,0,0,.58),transparent 12%,transparent 88%,rgba(0,0,0,.58))}
    @media(max-width:900px){#IttField-{{ section.id }}{min-height:185svh}.itt-field__sticky{min-height:680px}.itt-field__trim{width:44px}.itt-field__head{left:62px;top:5.5%;max-width:86vw}.itt-field__title{font-size:clamp(4.4rem,13.6vw,8rem)}.itt-field__note{top:19%;right:60px;max-width:14rem}.itt-field__one{left:4vw;top:33%;width:67vw;height:45vh}.itt-field__two{right:5vw;top:34%;width:34vw;height:31vh}.itt-field__three{right:8vw;bottom:3%;width:54vw;height:28vh}.itt-field__edition{left:62px}}
    @media(max-width:560px){#IttField-{{ section.id }}{min-height:180svh}.itt-field__sticky{min-height:620px}.itt-field__trim{width:29px}.itt-field__head{left:42px;top:4.5%;max-width:88vw}.itt-field__kicker{font-size:.46rem;letter-spacing:.24em}.itt-field__title{font-size:16.5vw;line-height:.74;white-space:normal;max-width:86vw}.itt-field__note{left:42px;right:auto;top:20%;max-width:68%;font-size:.61rem}.itt-field__one{left:-13vw;top:34%;width:88vw;height:42vh;min-height:290px}.itt-field__two{right:-5vw;top:35%;width:46vw;height:27vh;min-height:195px}.itt-field__three{right:-4vw;bottom:4%;width:68vw;height:27vh;min-height:205px}.itt-field__label h3{font-size:1rem}.itt-field__edition{left:42px;font-size:.42rem;letter-spacing:.23em}.itt-field__drop:nth-child(even){display:none}.itt-field__rain{opacity:calc(.4 + var(--rain,0)*.6)}}
    @media(prefers-reduced-motion:reduce){#IttField-{{ section.id }}{min-height:auto}.itt-field__sticky{position:relative;height:auto;min-height:900px}.itt-field__piece,.itt-field__title,.itt-field__note,.itt-field__slash,.itt-field__trim{transform:none!important}.itt-field__rain{display:none}.itt-field__trim{opacity:.35}}
  </style>
  <div class="itt-field__sticky">
    <div class="itt-field__trim itt-field__trim--l" aria-hidden="true"></div><div class="itt-field__trim itt-field__trim--r" aria-hidden="true"></div>
    <div class="itt-field__rain" aria-hidden="true">
      <span class="itt-field__drop" style="left:4%;--dur:13s;--delay:-8s">FLAGLINE</span><span class="itt-field__drop" style="left:10%;--dur:18s;--delay:-3s">ittoldem™</span><span class="itt-field__drop" style="left:18%;--dur:15s;--delay:-11s">L’Atelier</span><span class="itt-field__drop" style="left:28%;--dur:21s;--delay:-6s">ONE OF ONE</span><span class="itt-field__drop" style="left:39%;--dur:17s;--delay:-14s">LE LABORATOIRE</span><span class="itt-field__drop" style="left:51%;--dur:14s;--delay:-5s">I TOLD ’EM.</span><span class="itt-field__drop" style="left:62%;--dur:20s;--delay:-16s">TAILORING</span><span class="itt-field__drop" style="left:73%;--dur:16s;--delay:-9s">ITTELIER</span><span class="itt-field__drop" style="left:83%;--dur:19s;--delay:-2s">CUSTOM</span><span class="itt-field__drop" style="left:91%;--dur:15s;--delay:-12s">THE LAB</span><span class="itt-field__drop" style="left:96%;--dur:22s;--delay:-7s">LA MAISON</span>
    </div>
    <div class="itt-field__grain"></div><div class="itt-field__veil"></div>
    <div class="itt-field__head"><div class="itt-field__kicker">MAISON · DÉTROIT — EAST SIDE / PROCESS AS IMAGE</div><h2 class="itt-field__title" aria-label="The work leaks through"><span>THE</span> <span>WORK</span><br><span>LEAKS</span> <span>THROUGH.</span></h2></div>
    <p class="itt-field__note">Process, garment and machine move through the house like evidence—not content cards.</p>
    <div class="itt-field__stage"><div class="itt-field__monogram">ittoldem™</div><div class="itt-field__slash"></div>
      <article class="itt-field__piece itt-field__one"><video autoplay muted loop playsinline preload="auto" src="https://cdn.shopify.com/videos/c/o/v/87040c4ea6db4c80927dc1f729b4444f.mov"></video><div class="itt-field__label"><span>01 / BODY</span><h3>THE GARMENT MOVES FIRST.</h3></div></article>
      <article class="itt-field__piece itt-field__two"><video autoplay muted loop playsinline preload="auto" src="https://cdn.shopify.com/videos/c/o/v/829da22df9ae4c89ad7479a2440de5fe.mov"></video><div class="itt-field__label"><span>02 / SURFACE</span><h3>PRINT BECOMES RELIEF.</h3></div></article>
      <article class="itt-field__piece itt-field__three"><video autoplay muted loop playsinline preload="auto" src="https://cdn.shopify.com/videos/c/o/v/cbb48a13846a47ed964d127d0d92947c.mov"></video><div class="itt-field__label"><span>03 / MACHINE</span><h3>PATTERN CUTS INTO MATERIAL.</h3></div></article>
    </div>
    <div class="itt-field__edition">FASHION / TAILORING / SPORTSWEAR / OBJECTS · I TOLD ’EM.</div>
  </div>
  <script>(()=>{const root=document.getElementById('IttField-{{ section.id }}');if(!root)return;const sticky=root.querySelector('.itt-field__sticky'),title=[...root.querySelectorAll('.itt-field__title span')],reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;root.querySelectorAll('video').forEach(v=>{v.muted=true;v.defaultMuted=true;v.playsInline=true;const play=()=>v.play().catch(()=>{});if(v.readyState>=2)play();else v.addEventListener('canplay',play,{once:true})});if(reduced)return;let ticking=false;const draw=()=>{const r=root.getBoundingClientRect(),max=Math.max(1,root.offsetHeight-innerHeight),p=Math.max(0,Math.min(1,-r.top/max)),trim=Math.max(0,Math.sin(Math.PI*p)),rain=Math.min(1,p*2.1);sticky.style.setProperty('--p',p.toFixed(4));sticky.style.setProperty('--trim',trim.toFixed(4));sticky.style.setProperty('--rain',rain.toFixed(4));title.forEach((s,i)=>{const phase=Math.max(0,(p-.08)*1.25),x=(i%2?1:-1)*phase*(22+i*11),y=phase*(i*8),rot=(i%2?1:-1)*phase*(3+i*1.15);s.style.transform=`translate3d(${x}px,${y}px,0) rotate(${rot}deg)`;s.style.opacity=String(1-phase*.22)});ticking=false};const on=()=>{if(!ticking){requestAnimationFrame(draw);ticking=true}};addEventListener('scroll',on,{passive:true});addEventListener('resize',on,{passive:true});draw()})();</script>
</section>
