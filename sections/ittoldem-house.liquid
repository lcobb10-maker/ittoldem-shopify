    <a class="itt-clip itt-clip--tall" href="{{ section.settings.gvo_link | default: routes.all_products_collection_url }}">{% if section.settings.flagline_image != blank %}{{ section.settings.flagline_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'FLAGLINE preview' }}{% endif %}<span>SPORT / 02</span></a>
    <a class="itt-clip" href="{{ section.settings.lab_link | default: routes.all_products_collection_url }}">{% if section.settings.lab_image != blank %}{{ section.settings.lab_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'The Lab preview' }}{% endif %}<span>LAB / 03</span></a>
    <a class="itt-clip itt-clip--wide" href="{{ section.settings.category_link_4 | default: routes.all_products_collection_url }}">{% if section.settings.denim_image != blank %}{{ section.settings.denim_image | image_url: width: 1100 | image_tag: loading: 'lazy', alt: 'ITTelier preview' }}{% endif %}<span>ITTelier / 04</span></a>
    <a class="itt-clip" href="{{ section.settings.wehair_link | default: routes.all_products_collection_url }}">{% if section.settings.wehair_image != blank %}{{ section.settings.wehair_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'WE HAIR preview' }}{% endif %}<span>WE HAIR / 05</span></a>
