<section class="itt-field" id="IttField-{{ section.id }}">
  <style>
    .itt-v3__cinema,.itt-v3__archive,.section-itt-watch-four{display:none!important}
    .itt-v3__hero,.itt-v3__hero-copy{min-height:min(52svh,620px)!important}.itt-v3__hero h1{font-size:clamp(3.7rem,7.4vw,7.8rem)!important}.itt-v3__hero:after{background:radial-gradient(ellipse at 62% 44%,rgba(0,0,0,.02) 10%,rgba(0,0,0,.18) 48%,rgba(0,0,0,.88) 100%),linear-gradient(90deg,rgba(0,0,0,.88),rgba(0,0,0,.22) 58%,rgba(0,0,0,.46))!important}
    #IttField-{{ section.id }}{--ink:#070707;--paper:#eee5d5;position:relative;background:var(--ink);color:#f7f2e8;min-height:1180px;overflow:hidden;padding:clamp(4rem,8vw,8rem) clamp(1rem,4vw,4rem) 8rem;isolation:isolate}
    #IttField-{{ section.id }} *{box-sizing:border-box}.itt-field__head{position:relative;z-index:8;max-width:1180px}.itt-field__kicker{font-size:.62rem;letter-spacing:.28em;text-transform:uppercase;opacity:.58}.itt-field__title{margin:.7rem 0 0;max-width:8ch;font-size:clamp(4rem,9vw,10rem);font-weight:500;letter-spacing:-.075em;line-height:.78;text-transform:uppercase}.itt-field__note{position:absolute;z-index:8;right:5vw;top:11rem;max-width:22rem;font-size:.78rem;line-height:1.6;color:rgba(247,242,232,.62)}
    .itt-field__stage{position:relative;height:860px;margin-top:-2rem}.itt-field__piece{position:absolute;overflow:hidden;background:#0d0d0d;isolation:isolate;box-shadow:0 38px 90px rgba(0,0,0,.42)}.itt-field__piece video,.itt-field__piece img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.82) contrast(1.08) brightness(.7);transition:filter .75s ease,transform 1.3s cubic-bezier(.18,.8,.2,1)}.itt-field__piece:before{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;background:radial-gradient(ellipse at center,transparent 22%,rgba(0,0,0,.12) 51%,rgba(0,0,0,.94) 100%)}.itt-field__piece:after{content:"";position:absolute;inset:0;z-index:3;pointer-events:none;opacity:.22;background-image:radial-gradient(circle,rgba(245,239,227,.55) .65px,transparent .82px);background-size:4px 4px;mix-blend-mode:soft-light;-webkit-mask-image:linear-gradient(118deg,#000 0 14%,transparent 32% 70%,#000 92%);mask-image:linear-gradient(118deg,#000 0 14%,transparent 32% 70%,#000 92%)}
    .itt-field__piece.is-active video,.itt-field__piece:hover video{filter:saturate(.98) contrast(1.05) brightness(.9);transform:scale(1.025)}.itt-field__one{left:3%;top:130px;width:min(54vw,720px);height:590px;-webkit-mask-image:radial-gradient(ellipse at 52% 48%,#000 44%,rgba(0,0,0,.9) 61%,transparent 88%);mask-image:radial-gradient(ellipse at 52% 48%,#000 44%,rgba(0,0,0,.9) 61%,transparent 88%)}.itt-field__two{right:1%;top:15px;width:min(28vw,390px);height:430px;clip-path:polygon(8% 0,100% 7%,92% 100%,0 88%)}.itt-field__three{right:12%;bottom:10px;width:min(39vw,520px);height:360px;-webkit-mask-image:linear-gradient(135deg,transparent 0 8%,#000 22% 76%,transparent 96%);mask-image:linear-gradient(135deg,transparent 0 8%,#000 22% 76%,transparent 96%)}
    .itt-field__label{position:absolute;z-index:5;left:1rem;bottom:1rem;max-width:17rem}.itt-field__label span{font-size:.54rem;letter-spacing:.18em;text-transform:uppercase;opacity:.64}.itt-field__label h3{margin:.35rem 0 0;font-size:clamp(1.4rem,2.4vw,2.8rem);line-height:.9;text-transform:uppercase}.itt-field__ghost{position:absolute;z-index:1;left:46%;top:47%;transform:translate(-50%,-50%) rotate(-7deg);font-family:serif;font-style:italic;font-size:clamp(4rem,11vw,11rem);line-height:.72;letter-spacing:-.06em;color:rgba(238,229,213,.08);white-space:nowrap;pointer-events:none}.itt-field__line{position:absolute;z-index:4;left:41%;top:46%;width:26vw;height:1px;background:linear-gradient(90deg,rgba(238,229,213,.65),transparent);transform:rotate(-13deg);transform-origin:left center}.itt-field__play{position:absolute;z-index:7;right:.8rem;top:.8rem;border:1px solid rgba(255,255,255,.35);background:rgba(0,0,0,.3);color:#fff;padding:.55rem .7rem;font:inherit;font-size:.52rem;letter-spacing:.14em;text-transform:uppercase;backdrop-filter:blur(8px)}
    @media(max-width:900px){.itt-v3__hero,.itt-v3__hero-copy{min-height:46svh!important}#IttField-{{ section.id }}{min-height:1040px;padding-top:4rem}.itt-field__note{position:relative;top:auto;right:auto;margin:1.2rem 0 0;max-width:28rem}.itt-field__stage{height:760px;margin-top:1rem}.itt-field__one{left:-9%;top:90px;width:82vw;height:490px}.itt-field__two{right:-5%;top:0;width:40vw;height:300px}.itt-field__three{right:2%;bottom:0;width:62vw;height:285px}.itt-field__ghost{left:52%;top:49%}.itt-field__line{left:34%;top:50%;width:44vw}}
    @media(max-width:560px){.itt-v3__hero,.itt-v3__hero-copy{min-height:41svh!important}.itt-v3__hero h1{font-size:clamp(3.3rem,15vw,5.4rem)!important}#IttField-{{ section.id }}{min-height:920px;padding-left:0;padding-right:0}.itt-field__head,.itt-field__note{padding-left:18px;padding-right:18px}.itt-field__title{font-size:clamp(3.8rem,19vw,6.4rem)}.itt-field__stage{height:650px}.itt-field__one{left:-18%;top:110px;width:94vw;height:420px}.itt-field__two{right:-12%;top:12px;width:49vw;height:230px}.itt-field__three{right:-7%;bottom:0;width:72vw;height:240px}.itt-field__label{left:.8rem;bottom:.8rem}.itt-field__label h3{font-size:1.25rem}.itt-field__ghost{font-size:18vw}}
    @media(prefers-reduced-motion:reduce){.itt-field__piece video{display:none}}
  </style>
  <div class="itt-field__head"><div class="itt-field__kicker">MAISON · DÉTROIT — EAST SIDE / PROCESS AS IMAGE</div><h2 class="itt-field__title">THE WORK LEAKS THROUGH.</h2></div>
  <p class="itt-field__note">Not a video gallery. Fragments of the house surface, disappear and overlap like ink, shadow and evidence.</p>
  <div class="itt-field__stage">
    <div class="itt-field__ghost">made / worn / altered</div><div class="itt-field__line"></div>
    <article class="itt-field__piece itt-field__one" data-field-film><video muted loop playsinline preload="metadata" src="https://cdn.shopify.com/videos/c/o/v/87040c4ea6db4c80927dc1f729b4444f.mov"></video><button class="itt-field__play" type="button">VIEW MOTION</button><div class="itt-field__label"><span>01 / BODY</span><h3>THE GARMENT MOVES FIRST.</h3></div></article>
    <article class="itt-field__piece itt-field__two" data-field-film><video muted loop playsinline preload="metadata" src="https://cdn.shopify.com/videos/c/o/v/829da22df9ae4c89ad7479a2440de5fe.mov"></video><button class="itt-field__play" type="button">VIEW TEXTURE</button><div class="itt-field__label"><span>02 / SURFACE</span><h3>PRINT BECOMES RELIEF.</h3></div></article>
    <article class="itt-field__piece itt-field__three" data-field-film><video muted loop playsinline preload="metadata" src="https://cdn.shopify.com/videos/c/o/v/cbb48a13846a47ed964d127d0d92947c.mov"></video><button class="itt-field__play" type="button">VIEW PROCESS</button><div class="itt-field__label"><span>03 / MACHINE</span><h3>PATTERN CUTS INTO MATERIAL.</h3></div></article>
  </div>
  <script>
    (()=>{const root=document.getElementById('IttField-{{ section.id }}');if(!root)return;const films=[...root.querySelectorAll('[data-field-film]')];const videos=films.map(x=>x.querySelector('video'));const stop=except=>videos.forEach(v=>{if(v!==except)v.pause()});films.forEach((film,i)=>{const v=videos[i],b=film.querySelector('.itt-field__play');b.addEventListener('click',()=>{if(v.paused){stop(v);films.forEach(f=>f.classList.remove('is-active'));v.play().catch(()=>{});film.classList.add('is-active');b.textContent='PAUSE'}else{v.pause();film.classList.remove('is-active');b.textContent='VIEW MOTION'}})});const io=new IntersectionObserver(entries=>{entries.forEach(e=>{if(!e.isIntersecting){const v=e.target.querySelector('video');v.pause();e.target.classList.remove('is-active')}})},{threshold:.08});films.forEach(f=>io.observe(f));})();
  </script>
</section>
