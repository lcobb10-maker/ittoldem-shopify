{% assign emblem = '' | strip %}
<a href="{{ routes.root_url }}" class="itt-header-mark" aria-label="ITT TOLD'EM home">
  <img src="data:image/webp;base64,{{ emblem }}" width="44" height="44" alt="ITT TOLD'EM emblem" loading="eager">
  <span class="itt-header-wordmark">ITT TOLD’EM<small>MAISON · DÉTROIT</small></span>
</a>
{% stylesheet %}
.itt-header-mark{display:inline-flex;align-items:center;gap:10px;color:inherit;text-decoration:none;min-width:max-content}.itt-header-mark img{width:42px;height:42px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 1px rgba(127,96,54,.35)}.itt-header-wordmark{display:flex;flex-direction:column;font-size:15px;font-weight:650;line-height:1;letter-spacing:.02em}.itt-header-wordmark small{font-size:7px;font-weight:500;letter-spacing:.28em;margin-top:5px;opacity:.65}
/* ITT storefront polish: keep one announcement, reveal campaign imagery, improve editorial legibility */
.section-ittoldem-house .itt-announcement{display:none!important}.section-ittoldem-house .itt-hero__placeholder{filter:brightness(1.18) saturate(.92) contrast(1.02)}.section-ittoldem-house .itt-hero:after{background:linear-gradient(90deg,rgba(0,0,0,.62) 0%,rgba(0,0,0,.08) 58%,rgba(0,0,0,.12) 100%)}.section-ittoldem-house .itt-manifesto em{font-family:var(--font-heading--family,serif);font-style:italic;font-weight:400;opacity:.88;letter-spacing:-.02em}.section-ittoldem-house .itt-house-nav{scroll-snap-type:x proximity}.section-ittoldem-house .itt-house-nav a{scroll-snap-align:start}.section-ittoldem-house .itt-house-nav::-webkit-scrollbar{display:none}
@media(max-width:749px){.itt-header-mark{gap:7px}.itt-header-mark img{width:34px;height:34px}.itt-header-wordmark{font-size:13px}.itt-header-wordmark small{font-size:6px;letter-spacing:.18em}.section-ittoldem-house .itt-hero__content{padding-top:12vw}.section-ittoldem-house .itt-hero__title{line-height:.86}.section-ittoldem-house .itt-manifesto p{font-size:9.4vw;line-height:.96}.section-ittoldem-house .itt-house-nav a{min-width:108px;padding:16px 12px}}
{% endstylesheet %}
{% schema %}{"name":"t:names.logo","tag":null,"class":"header-logo","settings":[{"type":"checkbox","id":"hide_logo_on_home_page","label":"t:settings.hide_logo_on_home_page","default":false},{"type":"range","id":"padding-block-start","label":"t:settings.top","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding-block-end","label":"t:settings.bottom","min":0,"max":100,"step":1,"unit":"px","default":0}]}{% endschema %}