    <a class="itt-editorial" href="{{ section.settings.editorial_link_2 | default: section.settings.category_link_4 | default: routes.all_products_collection_url }}">{% if section.settings.denim_image != blank %}{{ section.settings.denim_image | image_url: width: 1600 | image_tag: class: 'itt-editorial__media', loading: 'lazy', alt: "ITT custom work" }}{% endif %}<div class="itt-editorial__content"><div class="itt-kicker">EXODUS 35:35</div><h2 class="itt-editorial__title">CUSTOM</h2><div class="itt-editorial__meta">WISDOM OF HEART · MANNER OF WORKMANSHIP.</div><div class="itt-card__link">OPEN ITTelier ↗</div></div></a>
    <a class="itt-editorial" href="{{ section.settings.wehair_link | default: routes.all_products_collection_url }}">{% if section.settings.wehair_image != blank %}{{ section.settings.wehair_image | image_url: width: 1600 | image_tag: class: 'itt-editorial__media', loading: 'lazy', alt: "WE HAIR development" }}{% endif %}<div class="itt-editorial__content"><div class="itt-kicker">JAMES 2:26</div><h2 class="itt-editorial__title">WE HAIR</h2><div class="itt-editorial__meta">FAITH WITHOUT WORKS IS DEAD.</div><div class="itt-card__link">ENTER ↗</div></div></a>
  </div>

  <div class="itt-drop"><div><div class="itt-kicker">MATTHEW 7:7</div><h2 class="itt-display">ASK.<br>SEEK.<br>KNOCK.</h2></div>{% form 'customer', class: 'itt-drop__form' %}<input type="hidden" name="contact[tags]" value="newsletter,ittoldem-house"><label class="visually-hidden" for="IttDropEmail-{{ section.id }}">Email address</label><input id="IttDropEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="ENTER EMAIL" required autocomplete="email"><button type="submit">CONNECT <span>→</span></button>{% if form.posted_successfully? %}<p class="itt-drop__status">RECEIVED.</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</div>
  <div class="itt-servicebar"><div class="itt-service">HABAKKUK 2:2 · VISION</div><div class="itt-service">PROVERBS 16:3 · WORK</div><div class="itt-service">PROVERBS 22:1 · NAME</div><div class="itt-service">JAMES 2:26 · FAITH + WORKS</div></div>
  <div class="itt-footer-statement"><strong>ITT TOLD’EM <span class="itt-kicker">MAISON · DÉTROIT</span></strong><em>“Write the vision.” · Habakkuk 2:2</em></div>
</section>

<script>
  (() => {
    const root = document.currentScript && document.currentScript.previousElementSibling;
    if (!root || !root.classList.contains('itt-house')) return;
    const video = root.querySelector('.itt-hero__video');
    const fallback = root.querySelector('.itt-hero__fallback');
    if (video) {
      const revealVideo = () => { video.classList.add('is-ready'); if (fallback) fallback.classList.add('is-hidden'); };
      if (video.readyState >= 2) revealVideo(); else video.addEventListener('loadeddata', revealVideo, { once: true });
      video.addEventListener('error', () => { video.style.display = 'none'; if (fallback) fallback.classList.remove('is-hidden'); }, { once: true });
    }
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let ticking = false;
      const update = () => {
        const hero = root.querySelector('.itt-hero');
        if (hero) {
          const rect = hero.getBoundingClientRect();
          const progress = Math.max(-1, Math.min(1, -rect.top / Math.max(rect.height, 1)));
          root.style.setProperty('--itt-scroll', progress.toFixed(3));
        }
        ticking = false;
      };
      window.addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, { passive: true });
      update();
    }
  })();
</script>

