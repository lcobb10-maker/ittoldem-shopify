{{ 'ittoldem-house.css' | asset_url | stylesheet_tag }}
<section class="itt-house">
  <div class="itt-announcement"><span>MAISON · DÉTROIT — EAST SIDE</span><span>HABAKKUK 2:2</span><span>WRITE THE VISION.</span></div>

  <div class="itt-hero" id="itt-entry">
    {% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2400 | image_tag: class: 'itt-hero__media', loading: 'eager', fetchpriority: 'high', alt: "ITT TOLD’EM campaign" }}{% endif %}
    <div class="itt-scan" aria-hidden="true"></div>
    <div class="itt-hero__content">
      <div class="itt-systemline"><span>PROVERBS 16:3</span><span>COMMIT THY WORKS.</span></div>
      <div class="itt-kicker">MAISON · DÉTROIT — EAST SIDE</div>
      <h1 class="itt-display itt-hero__title">ENTER<br>THE<br>HOUSE.</h1>
      <p class="itt-hero__sub">“Write the vision, and make it plain.” · Habakkuk 2:2</p>
      <div class="itt-hero__actions"><a class="itt-btn itt-btn--solid" href="#itt-worlds">SELECT A WORLD <span class="itt-arrow">↓</span></a><a class="itt-textlink" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}">ENTER STORE <span class="itt-arrow">→</span></a></div>
    </div>
    <div class="itt-script">“Commit thy works<br>unto the Lord.”<small>PROVERBS 16:3</small></div>
    <div class="itt-hero__index">ECCLESIASTES 9:10 · WITH THY MIGHT</div>
  </div>

  <nav class="itt-command" aria-label="House worlds"><a href="#itt-worlds"><b>01</b><span>WORLDS</span></a><a href="{{ section.settings.category_link_1 | default: routes.all_products_collection_url }}"><b>02</b><span>STORE</span></a><a href="{{ section.settings.gvo_link | default: routes.all_products_collection_url }}"><b>03</b><span>SPORT</span></a><a href="{{ section.settings.lab_link | default: routes.all_products_collection_url }}"><b>04</b><span>LAB</span></a><a href="{{ section.settings.story_link | default: routes.root_url }}"><b>05</b><span>HOUSE FILE</span></a></nav>

  <div class="itt-world-intro" id="itt-worlds"><div><div class="itt-kicker">PROVERBS 27:17</div><h2 class="itt-display">HOUSE<br>WORLDS</h2></div><p>“Iron sharpeneth iron; so a man sharpeneth the countenance of his friend.”</p></div>

  <div class="itt-categories">
    <a class="itt-card" href="{{ section.settings.category_link_1 | default: routes.all_products_collection_url }}">{% if section.settings.apparel_image != blank %}{{ section.settings.apparel_image | image_url: width: 1400 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM apparel" }}{% endif %}<div class="itt-card__number">01 / PROV. 22:1</div><div class="itt-card__content"><h2 class="itt-card__title">STORE</h2><div class="itt-card__meta">A GOOD NAME IS RATHER TO BE CHOSEN.</div><div class="itt-card__link">SELECT <span>↗</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.gvo_link | default: routes.all_products_collection_url }}">{% if section.settings.flagline_image != blank %}{{ section.settings.flagline_image | image_url: width: 1400 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "FLAGLINE sport" }}{% endif %}<div class="itt-card__number">02 / 1 COR. 9:24</div><div class="itt-card__content"><h2 class="itt-card__title">SPORT</h2><div class="itt-card__meta">SO RUN, THAT YE MAY OBTAIN.</div><div class="itt-card__link">SELECT <span>↗</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.lab_link | default: routes.all_products_collection_url }}">{% if section.settings.lab_image != blank %}{{ section.settings.lab_image | image_url: width: 1400 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM The Lab" }}{% endif %}<div class="itt-card__number">03 / ECC. 9:10</div><div class="itt-card__content"><h2 class="itt-card__title">THE LAB</h2><div class="itt-card__meta">DO IT WITH THY MIGHT.</div><div class="itt-card__link">SELECT <span>↗</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.category_link_4 | default: routes.all_products_collection_url }}">{% if section.settings.denim_image != blank %}{{ section.settings.denim_image | image_url: width: 1400 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM custom work" }}{% endif %}<div class="itt-card__number">04 / EX. 35:35</div><div class="itt-card__content"><h2 class="itt-card__title">ITTelier</h2><div class="itt-card__meta">FILLED WITH WISDOM OF HEART.</div><div class="itt-card__link">SELECT <span>↗</span></div></div></a>
  </div>

  <div class="itt-manifesto"><div class="itt-manifesto__eyebrow">PROVERBS 22:1</div><p>A GOOD NAME <em>IS RATHER TO BE CHOSEN THAN GREAT RICHES.</em></p></div>

  <div class="itt-story">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1900 | image_tag: class: 'itt-story__media', loading: 'lazy', alt: "ITT TOLD’EM house story" }}{% endif %}<div class="itt-story__content"><div class="itt-kicker">COLOSSIANS 3:23</div><h2 class="itt-display itt-story__title">ITT<br>TOLD’EM</h2><p class="itt-story__copy">“And whatsoever ye do, do it heartily, as to the Lord, and not unto men.”</p><a class="itt-btn" href="{{ section.settings.story_link | default: routes.root_url }}">OPEN HOUSE FILE <span>→</span></a></div><div class="itt-values">Faith<br>Work<br>Wisdom<br>Vision</div></div>

  <div class="itt-editorials">
    <a class="itt-editorial" href="{{ section.settings.gvo_link | default: routes.all_products_collection_url }}">{% if section.settings.flagline_image != blank %}{{ section.settings.flagline_image | image_url: width: 1600 | image_tag: class: 'itt-editorial__media', loading: 'lazy', alt: "FLAGLINE" }}{% endif %}<div class="itt-editorial__content"><div class="itt-kicker">1 CORINTHIANS 9:24</div><h2 class="itt-editorial__title">FLAGLINE</h2><div class="itt-editorial__meta">SO RUN, THAT YE MAY OBTAIN.</div><div class="itt-card__link">ENTER ↗</div></div></a>
    <a class="itt-editorial" href="{{ section.settings.editorial_link_2 | default: section.settings.category_link_4 | default: routes.all_products_collection_url }}">{% if section.settings.denim_image != blank %}{{ section.settings.denim_image | image_url: width: 1600 | image_tag: class: 'itt-editorial__media', loading: 'lazy', alt: "ITT custom work" }}{% endif %}<div class="itt-editorial__content"><div class="itt-kicker">EXODUS 35:35</div><h2 class="itt-editorial__title">CUSTOM</h2><div class="itt-editorial__meta">WISDOM OF HEART · MANNER OF WORKMANSHIP.</div><div class="itt-card__link">OPEN ITTelier ↗</div></div></a>
    <a class="itt-editorial" href="{{ section.settings.wehair_link | default: routes.all_products_collection_url }}">{% if section.settings.wehair_image != blank %}{{ section.settings.wehair_image | image_url: width: 1600 | image_tag: class: 'itt-editorial__media', loading: 'lazy', alt: "WE HAIR development" }}{% endif %}<div class="itt-editorial__content"><div class="itt-kicker">JAMES 2:26</div><h2 class="itt-editorial__title">WE HAIR</h2><div class="itt-editorial__meta">FAITH WITHOUT WORKS IS DEAD.</div><div class="itt-card__link">ENTER ↗</div></div></a>
  </div>

  <div class="itt-drop"><div><div class="itt-kicker">MATTHEW 7:7</div><h2 class="itt-display">ASK.<br>SEEK.<br>KNOCK.</h2></div>{% form 'customer', class: 'itt-drop__form' %}<input type="hidden" name="contact[tags]" value="newsletter,ittoldem-house"><label class="visually-hidden" for="IttDropEmail-{{ section.id }}">Email address</label><input id="IttDropEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="ENTER EMAIL" required autocomplete="email"><button type="submit">CONNECT <span>→</span></button>{% if form.posted_successfully? %}<p class="itt-drop__status">RECEIVED.</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</div>
  <div class="itt-servicebar"><div class="itt-service">HABAKKUK 2:2 · VISION</div><div class="itt-service">PROVERBS 16:3 · WORK</div><div class="itt-service">PROVERBS 22:1 · NAME</div><div class="itt-service">JAMES 2:26 · FAITH + WORKS</div></div>
  <div class="itt-footer-statement"><strong>ITT TOLD’EM <span class="itt-kicker">MAISON · DÉTROIT</span></strong><em>“Write the vision.” · Habakkuk 2:2</em></div>
</section>
{% schema %}
{"name":"ITT TOLD'EM House","tag":"section","class":"section-ittoldem-house","settings":[{"type":"header","content":"Campaign images"},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"image_picker","id":"apparel_image","label":"Apparel image"},{"type":"image_picker","id":"flagline_image","label":"GVO / FLAGLINE image"},{"type":"image_picker","id":"lab_image","label":"The Lab image"},{"type":"image_picker","id":"denim_image","label":"Custom Denim image"},{"type":"image_picker","id":"wehair_image","label":"WE HAIR image"},{"type":"url","id":"hero_link","label":"Hero link"},{"type":"url","id":"category_link_1","label":"Apparel link"},{"type":"url","id":"gvo_link","label":"GVO link"},{"type":"url","id":"category_link_3","label":"The Lab link"},{"type":"url","id":"category_link_4","label":"Custom link"},{"type":"url","id":"wehair_link","label":"WE HAIR link"},{"type":"url","id":"lab_link","label":"The Lab nav link"},{"type":"collection","id":"featured_collection","label":"Current release collection"},{"type":"url","id":"story_link","label":"About / story link"},{"type":"url","id":"editorial_link_2","label":"Custom work link"}],"presets":[{"name":"ITT TOLD'EM House"}]}
{% endschema %}