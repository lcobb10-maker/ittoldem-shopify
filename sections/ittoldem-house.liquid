{{ 'ittoldem-house.css' | asset_url | stylesheet_tag }}
<section class="itt-house">
  <div class="itt-announcement"><span>MAISON · DÉTROIT — EAST SIDE</span><span>HOUSE SYSTEM / 001</span><span>DESIGNED TO BE DISCOVERED</span></div>

  <div class="itt-hero" id="itt-entry">
    {% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2400 | image_tag: class: 'itt-hero__media', loading: 'eager', fetchpriority: 'high', alt: "ITT TOLD’EM campaign" }}{% endif %}
    <div class="itt-scan" aria-hidden="true"></div>
    <div class="itt-hero__content">
      <div class="itt-systemline"><span>ITT / HOUSE INTERFACE</span><span>ONLINE</span></div>
      <div class="itt-kicker">MAISON · DÉTROIT — EAST SIDE</div>
      <h1 class="itt-display itt-hero__title">ENTER<br>THE<br>HOUSE.</h1>
      <p class="itt-hero__sub">Fashion · sport · fabrication · culture. One house. Multiple worlds.</p>
      <div class="itt-hero__actions"><a class="itt-btn itt-btn--solid" href="#itt-worlds">SELECT A WORLD <span class="itt-arrow">↓</span></a><a class="itt-textlink" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}">ENTER STORE <span class="itt-arrow">→</span></a></div>
    </div>
    <div class="itt-script">We built the house.<br>Now we tell ’em.<small>JE VOUS L’AVAIS DIT.</small></div>
    <div class="itt-hero__index">PLAYER 01 · DETROIT · HOUSE 001</div>
  </div>

  <nav class="itt-command" aria-label="House worlds">
    <a href="#itt-worlds"><b>01</b><span>WORLDS</span></a><a href="{{ section.settings.category_link_1 | default: routes.all_products_collection_url }}"><b>02</b><span>STORE</span></a><a href="{{ section.settings.gvo_link | default: routes.all_products_collection_url }}"><b>03</b><span>SPORT</span></a><a href="{{ section.settings.lab_link | default: routes.all_products_collection_url }}"><b>04</b><span>LAB</span></a><a href="{{ section.settings.story_link | default: routes.root_url }}"><b>05</b><span>HOUSE FILE</span></a>
  </nav>

  <div class="itt-world-intro" id="itt-worlds"><div><div class="itt-kicker">SELECT DESTINATION</div><h2 class="itt-display">HOUSE<br>WORLDS</h2></div><p>Not departments. Different operating systems inside the same house. Choose where you enter.</p></div>

  <div class="itt-categories">
    <a class="itt-card" href="{{ section.settings.category_link_1 | default: routes.all_products_collection_url }}">{% if section.settings.apparel_image != blank %}{{ section.settings.apparel_image | image_url: width: 1400 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM apparel" }}{% endif %}<div class="itt-card__number">WORLD / 01</div><div class="itt-card__content"><h2 class="itt-card__title">STORE</h2><div class="itt-card__meta">THE HOUSE WARDROBE</div><div class="itt-card__link">SELECT <span>↗</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.gvo_link | default: routes.all_products_collection_url }}">{% if section.settings.flagline_image != blank %}{{ section.settings.flagline_image | image_url: width: 1400 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "FLAGLINE sport" }}{% endif %}<div class="itt-card__number">WORLD / 02</div><div class="itt-card__content"><h2 class="itt-card__title">SPORT</h2><div class="itt-card__meta">GVO · FLAGLINE · COMPETITION</div><div class="itt-card__link">SELECT <span>↗</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.lab_link | default: routes.all_products_collection_url }}">{% if section.settings.lab_image != blank %}{{ section.settings.lab_image | image_url: width: 1400 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM The Lab" }}{% endif %}<div class="itt-card__number">WORLD / 03</div><div class="itt-card__content"><h2 class="itt-card__title">THE LAB</h2><div class="itt-card__meta">PROTOTYPES · CROCHET · EXPERIMENT</div><div class="itt-card__link">SELECT <span>↗</span></div></div></a>
    <a class="itt-card" href="{{ section.settings.category_link_4 | default: routes.all_products_collection_url }}">{% if section.settings.denim_image != blank %}{{ section.settings.denim_image | image_url: width: 1400 | image_tag: class: 'itt-card__media', loading: 'lazy', alt: "ITT TOLD’EM custom work" }}{% endif %}<div class="itt-card__number">WORLD / 04</div><div class="itt-card__content"><h2 class="itt-card__title">ITTelier</h2><div class="itt-card__meta">CUSTOM · ENGRAVED · ONE OF ONE</div><div class="itt-card__link">SELECT <span>↗</span></div></div></a>
  </div>

  <div class="itt-manifesto"><div class="itt-manifesto__eyebrow">HOUSE DIRECTIVE / 001</div><p>DON’T BUILD ANOTHER STORE. <em>BUILD A WORLD WORTH ENTERING.</em></p></div>

  <div class="itt-story">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1900 | image_tag: class: 'itt-story__media', loading: 'lazy', alt: "ITT TOLD’EM house story" }}{% endif %}<div class="itt-story__content"><div class="itt-kicker">HOUSE FILE / DETROIT</div><h2 class="itt-display itt-story__title">ITT<br>TOLD’EM</h2><p class="itt-story__copy">A design house where fashion, sport, fabrication and culture share one language. The interface is part of the garment. Discovery is part of the experience.</p><a class="itt-btn" href="{{ section.settings.story_link | default: routes.root_url }}">OPEN HOUSE FILE <span>→</span></a></div><div class="itt-values">Culture<br>Craft<br>Sport<br>Experiment</div></div>

  <div class="itt-editorials">
    <a class="itt-editorial" href="{{ section.settings.gvo_link | default: routes.all_products_collection_url }}">{% if section.settings.flagline_image != blank %}{{ section.settings.flagline_image | image_url: width: 1600 | image_tag: class: 'itt-editorial__media', loading: 'lazy', alt: "FLAGLINE" }}{% endif %}<div class="itt-editorial__content"><div class="itt-kicker">PROGRAM / 01</div><h2 class="itt-editorial__title">FLAGLINE</h2><div class="itt-editorial__meta">WOMEN’S FLAG FOOTBALL · EQUIPMENT · CULTURE</div><div class="itt-card__link">LAUNCH PROGRAM ↗</div></div></a>
    <a class="itt-editorial" href="{{ section.settings.editorial_link_2 | default: section.settings.category_link_4 | default: routes.all_products_collection_url }}">{% if section.settings.denim_image != blank %}{{ section.settings.denim_image | image_url: width: 1600 | image_tag: class: 'itt-editorial__media', loading: 'lazy', alt: "ITT custom work" }}{% endif %}<div class="itt-editorial__content"><div class="itt-kicker">PROGRAM / 02</div><h2 class="itt-editorial__title">CUSTOM</h2><div class="itt-editorial__meta">ONE-OFFS · ENGRAVING · MADE TO ORDER</div><div class="itt-card__link">OPEN ITTelier ↗</div></div></a>
    <a class="itt-editorial" href="{{ section.settings.wehair_link | default: routes.all_products_collection_url }}">{% if section.settings.wehair_image != blank %}{{ section.settings.wehair_image | image_url: width: 1600 | image_tag: class: 'itt-editorial__media', loading: 'lazy', alt: "WE HAIR development" }}{% endif %}<div class="itt-editorial__content"><div class="itt-kicker">PROGRAM / 03</div><h2 class="itt-editorial__title">WE HAIR</h2><div class="itt-editorial__meta">TOOLS · BEAUTY · DEVELOPMENT</div><div class="itt-card__link">ENTER PROGRAM ↗</div></div></a>
  </div>

  <div class="itt-drop"><div><div class="itt-kicker">PRIVATE CHANNEL / DROP SIGNAL</div><h2 class="itt-display">DON’T WAIT<br>FOR THE<br>ALGORITHM.</h2></div>{% form 'customer', class: 'itt-drop__form' %}<input type="hidden" name="contact[tags]" value="newsletter,ittoldem-house"><label class="visually-hidden" for="IttDropEmail-{{ section.id }}">Email address</label><input id="IttDropEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="ENTER EMAIL" required autocomplete="email"><button type="submit">CONNECT <span>→</span></button>{% if form.posted_successfully? %}<p class="itt-drop__status">SIGNAL RECEIVED.</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</div>
  <div class="itt-servicebar"><div class="itt-service">01 / DETROIT DESIGN HOUSE</div><div class="itt-service">02 / CUSTOM WORK</div><div class="itt-service">03 / WORLDWIDE SHIPPING</div><div class="itt-service">04 / SECURE CHECKOUT</div></div>
  <div class="itt-footer-statement"><strong>ITT TOLD’EM <span class="itt-kicker">MAISON · DÉTROIT</span></strong><em>We built the house. Now we tell ’em.</em></div>
</section>
{% schema %}
{"name":"ITT TOLD'EM House","tag":"section","class":"section-ittoldem-house","settings":[{"type":"header","content":"Campaign images"},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"image_picker","id":"apparel_image","label":"Apparel image"},{"type":"image_picker","id":"flagline_image","label":"GVO / FLAGLINE image"},{"type":"image_picker","id":"lab_image","label":"The Lab image"},{"type":"image_picker","id":"denim_image","label":"Custom Denim image"},{"type":"image_picker","id":"wehair_image","label":"WE HAIR image"},{"type":"url","id":"hero_link","label":"Hero link"},{"type":"url","id":"category_link_1","label":"Apparel link"},{"type":"url","id":"gvo_link","label":"GVO link"},{"type":"url","id":"category_link_3","label":"The Lab link"},{"type":"url","id":"category_link_4","label":"Custom link"},{"type":"url","id":"wehair_link","label":"WE HAIR link"},{"type":"url","id":"lab_link","label":"The Lab nav link"},{"type":"collection","id":"featured_collection","label":"Current release collection"},{"type":"url","id":"story_link","label":"About / story link"},{"type":"url","id":"editorial_link_2","label":"Custom work link"}],"presets":[{"name":"ITT TOLD'EM House"}]}
{% endschema %}