<section class="itt8" id="ITT8-{{ section.id }}">
<style>
.section-itt-media-field,.section-itt-custom-studio{display:none!important}
#ITT8-{{ section.id }}{--ink:#050505;--bone:#f0e7d7;--gold:#b79555;background:var(--ink);color:#f8f3ea;overflow:hidden;isolation:isolate}#ITT8-{{ section.id }} *{box-sizing:border-box}#ITT8-{{ section.id }} a{color:inherit;text-decoration:none}.itt8__eyebrow{font:500 9px/1.2 Arial,sans-serif;letter-spacing:.28em;text-transform:uppercase;opacity:.68}
.itt8__hero{position:relative;height:100svh;min-height:650px;overflow:hidden;background:#050403}.itt8__bg{position:absolute;inset:-4%;will-change:transform}.itt8__bg img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(.56) saturate(.82) contrast(1.12)}.itt8__shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08),transparent 48%,rgba(0,0,0,.82))}.itt8__mast{position:absolute;z-index:3;left:5vw;right:5vw;top:47%;transform:translateY(-50%);pointer-events:none}.itt8__word{display:flex;align-items:flex-start;font:italic 400 clamp(6rem,15vw,14rem)/.7 Georgia,serif;letter-spacing:-.1em;white-space:nowrap}.itt8__letter{display:inline-block;will-change:transform,opacity}.itt8__tm{font:500 12px/1 Arial,sans-serif;margin:.2em 0 0 .25em}.itt8__thought{margin:1.4rem 0 0 9vw;font:500 9px/1.4 Arial,sans-serif;letter-spacing:.3em;text-transform:uppercase;opacity:.75}.itt8__herofoot{position:absolute;z-index:4;left:5vw;right:5vw;bottom:4vh;display:flex;justify-content:space-between;align-items:end;gap:2rem}.itt8__herofoot p{max-width:34rem;margin:.55rem 0 0;font:400 12px/1.55 Arial,sans-serif;opacity:.72}.itt8__links{display:flex;gap:1.3rem;font:500 9px/1.2 Arial,sans-serif;letter-spacing:.18em;text-transform:uppercase}
.itt8__rain{position:fixed;inset:0;z-index:30;pointer-events:none;overflow:hidden;opacity:0;transition:opacity .18s}.itt8.is-raining .itt8__rain{opacity:1}.itt8__drop{position:absolute;top:-12vh;font:500 9px/1 Arial,sans-serif;letter-spacing:.22em;text-transform:uppercase;color:rgba(248,243,234,.62);animation:itt8Rain var(--dur) linear infinite;animation-delay:var(--delay);will-change:transform}.itt8__drop:nth-child(3n){font:italic 400 14px/1 Georgia,serif;text-transform:none;color:rgba(183,149,85,.85);letter-spacing:.08em}@keyframes itt8Rain{to{transform:translate3d(var(--drift,0),118vh,0) rotate(var(--rot,0deg))}}
.itt8__trim{position:fixed;top:0;bottom:0;width:26px;z-index:29;pointer-events:none;opacity:0;background:url('https://cdn.shopify.com/s/files/1/0735/1320/5802/files/ittoldem-pyramid-textile-scroll-trim.jpg?v=1789035130') center var(--trimY,50%)/auto 150%;filter:sepia(.08) contrast(1.05) brightness(.82);transition:opacity .18s,transform .2s}.itt8__trim--l{left:0;transform:translateX(-100%)}.itt8__trim--r{right:0;transform:translateX(100%) scaleX(-1)}.itt8.is-raining .itt8__trim{opacity:.72;transform:translateX(0)}.itt8.is-raining .itt8__trim--r{transform:translateX(0) scaleX(-1)}
.itt8__commerce{position:relative;background:var(--bone);color:#080808;padding:clamp(4rem,7vw,7rem) 5vw;min-height:94svh;overflow:hidden}.itt8__shophead{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:2.5rem}.itt8__shophead h2{margin:.35rem 0 0;font:500 clamp(3.5rem,8vw,8rem)/.8 Arial,sans-serif;letter-spacing:-.075em;text-transform:uppercase}.itt8__shophead p{max-width:18rem;font:400 11px/1.55 Arial,sans-serif;opacity:.58}.itt8__ribbon{position:absolute;z-index:1;left:-18vw;right:-18vw;top:50%;height:54px;background:url('https://cdn.shopify.com/s/files/1/0735/1320/5802/files/ittoldem-pyramid-textile-scroll-trim.jpg?v=1789035130') center/auto 520%;filter:contrast(1.06) brightness(.9);mix-blend-mode:multiply;transform:translate3d(var(--ribbonX,0),0,0) rotate(-2deg);opacity:.72;will-change:transform}.itt8__productstage{position:relative;z-index:2;min-height:58svh;display:grid;place-items:center}.itt8__product{width:min(70vw,820px);display:grid;grid-template-columns:1.08fr .92fr;gap:3rem;align-items:center;will-change:transform}.itt8__productmedia{aspect-ratio:4/5;overflow:hidden;background:#d7cdbd;clip-path:polygon(0 5%,94% 0,100% 94%,6% 100%);transform:rotate(-1.5deg);box-shadow:0 24px 60px rgba(0,0,0,.14)}.itt8__productmedia img{width:100%;height:100%;object-fit:cover;display:block}.itt8__productcopy h3{font:italic 400 clamp(3rem,6vw,6rem)/.84 Georgia,serif;letter-spacing:-.055em;margin:.35rem 0 1rem}.itt8__price{font:500 10px/1 Arial,sans-serif;letter-spacing:.18em}.itt8__cta{display:inline-flex;margin-top:1.5rem;padding:.7rem 0;border-bottom:1px solid currentColor;font:500 9px/1 Arial,sans-serif;letter-spacing:.18em;text-transform:uppercase}
.itt8__process{position:relative;height:145svh;background:#030303;color:#f8f3ea}.itt8__processSticky{position:sticky;top:0;height:100svh;min-height:650px;overflow:hidden}.itt8__processTitle{position:absolute;z-index:8;left:5vw;top:6vh;font:500 clamp(3.8rem,8.2vw,8rem)/.78 Arial,sans-serif;letter-spacing:-.075em;text-transform:uppercase}.itt8__ghost{position:absolute;left:50%;top:52%;transform:translate(-50%,-50%);font:italic 400 clamp(9rem,24vw,24rem)/.7 Georgia,serif;color:rgba(248,243,234,.035);white-space:nowrap}.itt8__film{position:absolute;overflow:hidden;background:#0a0a0a;box-shadow:0 28px 80px rgba(0,0,0,.65);will-change:transform}.itt8__film video{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.82) contrast(1.06) brightness(.82)}.itt8__film--a{left:7vw;top:30%;width:min(48vw,650px);height:48vh;clip-path:ellipse(49% 38% at 50% 50%)}.itt8__film--b{right:8vw;top:31%;width:min(31vw,430px);height:43vh;clip-path:polygon(50% 0,100% 100%,0 100%)}.itt8__film--c{right:24vw;bottom:4vh;width:min(29vw,390px);height:31vh;clip-path:polygon(6% 0,100% 7%,92% 100%,0 90%)}
.itt8__atelier{background:var(--bone);color:#070707;padding:clamp(4rem,7vw,7rem) 5vw;display:grid;grid-template-columns:.82fr 1.18fr;gap:5vw;align-items:center;min-height:86svh}.itt8__atelier h2{margin:.5rem 0 1rem;font:italic 400 clamp(4rem,8vw,8rem)/.8 Georgia,serif;letter-spacing:-.06em}.itt8__atelier p{max-width:30rem;font:400 12px/1.65 Arial,sans-serif;opacity:.67}.itt8__atelierImage{position:relative;min-height:68svh;overflow:hidden;clip-path:polygon(0 3%,95% 0,100% 95%,5% 100%);will-change:transform}.itt8__atelierImage img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.itt8__worlds{background:#050505;color:#f5efe5;padding:4rem 5vw 5rem}.itt8__worldsHead{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:2rem}.itt8__worlds h2{font:italic 400 clamp(3.5rem,7vw,7rem)/.85 Georgia,serif;margin:0}.itt8__worldgrid{display:grid;grid-template-columns:repeat(5,1fr);border-block:1px solid rgba(255,255,255,.15)}.itt8__worldgrid a{min-height:140px;padding:1rem;border-right:1px solid rgba(255,255,255,.12);display:flex;flex-direction:column;justify-content:space-between}.itt8__worldgrid b{font:500 9px/1 Arial,sans-serif;letter-spacing:.18em}.itt8__worldgrid span{font:italic 400 1.7rem/1 Georgia,serif}
@media(max-width:900px){.itt8__word{font-size:17vw}.itt8__commerce{min-height:88svh}.itt8__product{width:82vw}.itt8__process{height:132svh}.itt8__processTitle{font-size:10vw}.itt8__film--a{left:3vw;width:62vw;height:43vh}.itt8__film--b{right:2vw;width:38vw;height:36vh}.itt8__film--c{right:14vw;width:40vw;height:28vh}.itt8__atelier{grid-template-columns:.85fr 1.15fr;min-height:82svh}.itt8__atelierImage{min-height:62svh}.itt8__worldgrid{grid-template-columns:repeat(5,1fr)}.itt8__worldgrid span{font-size:1.35rem}}
@media(max-width:560px){.itt8__hero{height:92svh;min-height:600px}.itt8__bg{inset:-3% -16%}.itt8__bg img{object-position:58% center}.itt8__mast{left:18px;right:18px;top:43%}.itt8__word{font-size:24vw}.itt8__thought{margin-left:.2rem;font-size:7px;max-width:85%}.itt8__herofoot{left:18px;right:18px;flex-direction:column;align-items:flex-start}.itt8__herofoot p{font-size:11px}.itt8__links{flex-wrap:wrap}.itt8__trim{width:18px}.itt8__drop:nth-child(even){display:none}.itt8__shophead{display:block}.itt8__shophead h2{font-size:14vw}.itt8__shophead p{margin-top:1.5rem}.itt8__commerce{padding-inline:20px;min-height:auto}.itt8__productstage{min-height:auto}.itt8__product{width:100%;grid-template-columns:1fr;gap:1.5rem}.itt8__productmedia{max-height:54svh}.itt8__process{height:120svh}.itt8__processTitle{left:20px;font-size:13vw}.itt8__film--a{left:-16vw;top:30%;width:82vw;height:39vh}.itt8__film--b{right:-8vw;top:34%;width:48vw;height:31vh}.itt8__film--c{right:2vw;bottom:5vh;width:60vw;height:25vh}.itt8__atelier{grid-template-columns:1fr;padding:4rem 20px;min-height:auto}.itt8__atelierImage{min-height:56svh}.itt8__worldgrid{grid-template-columns:1fr}.itt8__worldgrid a{min-height:95px;border-right:0;border-bottom:1px solid rgba(255,255,255,.12)}}
@media(prefers-reduced-motion:reduce){.itt8__rain,.itt8__trim{display:none}}
</style>
<div class="itt8__trim itt8__trim--l" aria-hidden="true"></div><div class="itt8__trim itt8__trim--r" aria-hidden="true"></div><div class="itt8__rain" aria-hidden="true"><span class="itt8__drop" style="left:6%;--dur:15s;--delay:-4s;--drift:2vw">FLAGLINE</span><span class="itt8__drop" style="left:18%;--dur:19s;--delay:-12s;--drift:-2vw">ittoldem™</span><span class="itt8__drop" style="left:31%;--dur:17s;--delay:-8s;--drift:2vw">L’Atelier</span><span class="itt8__drop" style="left:44%;--dur:21s;--delay:-15s;--drift:-2vw">WE HAIR</span><span class="itt8__drop" style="left:57%;--dur:16s;--delay:-6s;--drift:2vw">I TOLD ’EM.</span><span class="itt8__drop" style="left:70%;--dur:20s;--delay:-13s;--drift:-2vw">TAILORING</span><span class="itt8__drop" style="left:83%;--dur:18s;--delay:-9s;--drift:2vw">ITTELIER</span><span class="itt8__drop" style="left:94%;--dur:22s;--delay:-17s;--drift:-2vw">LE LABORATOIRE</span></div>
<section class="itt8__hero"><div class="itt8__bg">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width:2400 | image_tag: loading:'eager', fetchpriority:'high', alt:section.settings.hero_alt }}{% endif %}</div><div class="itt8__shade"></div><div class="itt8__mast"><div class="itt8__word" aria-label="ittoldem trademark"><span class="itt8__letter">i</span><span class="itt8__letter">t</span><span class="itt8__letter">t</span><span class="itt8__letter">o</span><span class="itt8__letter">l</span><span class="itt8__letter">d</span><span class="itt8__letter">e</span><span class="itt8__letter">m</span><span class="itt8__tm">™</span></div><div class="itt8__thought">I TOLD ’EM · SAME THOUGHT / DIFFERENT LEVELS</div></div><div class="itt8__herofoot"><div><div class="itt8__eyebrow">{{ section.settings.hero_kicker | escape }}</div><p>{{ section.settings.hero_copy | escape }}</p></div><div class="itt8__links"><a href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}">{{ section.settings.hero_primary_label | escape }} →</a><a href="#ITTShop-{{ section.id }}">{{ section.settings.hero_secondary_label | escape }} ↓</a></div></div></section>
<section class="itt8__commerce" id="ITTShop-{{ section.id }}"><div class="itt8__ribbon" aria-hidden="true"></div><div class="itt8__shophead"><div><div class="itt8__eyebrow">02 / THE HOUSE EDIT</div><h2>ONE PIECE.<br>FULL ATTENTION.</h2></div><p>One release gets the room. The garment comes first.</p></div>{% assign hero_product = all_products['ghost-bloom-polo'] %}{% if hero_product != blank %}<div class="itt8__productstage"><a class="itt8__product" href="{{ hero_product.url }}"><div class="itt8__productmedia">{{ hero_product.featured_image | image_url: width:1400 | image_tag: loading:'lazy', alt:hero_product.title }}</div><div class="itt8__productcopy"><div class="itt8__eyebrow">CURRENT RELEASE / LIMITED</div><h3>{{ hero_product.title }}</h3><div class="itt8__price">{{ hero_product.price | money }}</div><span class="itt8__cta">VIEW THE PIECE →</span></div></a></div>{% endif %}</section>
<section class="itt8__process"><div class="itt8__processSticky"><div class="itt8__ghost">ittoldem™</div><div class="itt8__processTitle">THE WORK<br>LEAKS THROUGH.</div><div class="itt8__film itt8__film--a"><video muted loop playsinline preload="metadata" data-src="https://cdn.shopify.com/videos/c/o/v/87040c4ea6db4c80927dc1f729b4444f.mov"></video></div><div class="itt8__film itt8__film--b"><video muted loop playsinline preload="metadata" data-src="https://cdn.shopify.com/videos/c/o/v/829da22df9ae4c89ad7479a2440de5fe.mov"></video></div><div class="itt8__film itt8__film--c"><video muted loop playsinline preload="metadata" data-src="https://cdn.shopify.com/videos/c/o/v/cbb48a13846a47ed964d127d0d92947c.mov"></video></div></div></section>
<section class="itt8__atelier"><div><div class="itt8__eyebrow">04 / L’ATELIER · COMMISSIONS</div><h2>Made for<br>your body.<br>Not a template.</h2><p>One-of-one work, tailoring, custom garments, team and organization pieces, specialty finishes and material experiments—developed as design work first.</p><a class="itt8__cta" href="/pages/contact">START A COMMISSION →</a></div><div class="itt8__atelierImage">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width:1600 | image_tag: loading:'lazy', alt:'ittoldem atelier' }}{% endif %}</div></section>
<section class="itt8__worlds"><div class="itt8__worldsHead"><div><div class="itt8__eyebrow">05 / THE HOUSE</div><h2>Choose a world.</h2></div><div class="itt8__eyebrow">I TOLD ’EM.</div></div><div class="itt8__worldgrid"><a href="/collections/all"><b>LA MAISON</b><span>House Edit</span></a><a href="/search?type=product&q=FLAGLINE"><b>FLAGLINE</b><span>Sport / Field</span></a><a href="/pages/contact"><b>L’ATELIER</b><span>Commission</span></a><a href="/search?type=product&q=CROCHET"><b>LE LABORATOIRE</b><span>Material Study</span></a><a href="/search?type=product&q=WE%20HAIR"><b>WE HAIR</b><span>Objects / Hair</span></a></div></section>
<script>(()=>{const root=document.getElementById('ITT8-{{ section.id }}');if(!root)return;const hero=root.querySelector('.itt8__hero'),commerce=root.querySelector('.itt8__commerce'),process=root.querySelector('.itt8__process'),atelier=root.querySelector('.itt8__atelier'),letters=[...root.querySelectorAll('.itt8__letter')],trims=[...root.querySelectorAll('.itt8__trim')],videos=[...root.querySelectorAll('video')],ribbon=root.querySelector('.itt8__ribbon'),product=root.querySelector('.itt8__product'),atelierImage=root.querySelector('.itt8__atelierImage'),reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;const io=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){videos.forEach(v=>{if(!v.src&&v.dataset.src)v.src=v.dataset.src;v.play().catch(()=>{})})}else if(e.boundingClientRect.top<0||e.boundingClientRect.top>innerHeight*1.5){videos.forEach(v=>v.pause())}}),{rootMargin:'45% 0px'});io.observe(process);if(reduce)return;let ticking=false;const progress=(el)=>{const r=el.getBoundingClientRect();return Math.max(0,Math.min(1,(innerHeight-r.top)/(innerHeight+r.height)))};const draw=()=>{const h=hero.getBoundingClientRect(),p=process.getBoundingClientRect(),hp=Math.max(0,Math.min(1,-h.top/Math.max(1,h.height*.82))),breakP=Math.max(0,Math.min(1,(hp-.55)/.42));root.classList.toggle('is-raining',hp>.08&&p.top>innerHeight*.08);trims.forEach(t=>t.style.setProperty('--trimY',`${((scrollY||0)*.16)%100}%`));letters.forEach((el,i)=>{const s=i%2?1:-1;el.style.transform=`translate3d(${s*breakP*(8+i*2)}px,${breakP*breakP*(180+i*18)}px,0) rotate(${s*breakP*(4+i)}deg)`;el.style.opacity=String(1-breakP*.96)});const bg=root.querySelector('.itt8__bg');if(bg)bg.style.transform=`translate3d(${hp*-3}vw,${hp*-30}px,0) scale(${1+hp*.02})`;const cp=progress(commerce);if(ribbon)ribbon.style.setProperty('--ribbonX',`${(cp-.5)*30}vw`);if(product)product.style.transform=`translate3d(${(cp-.5)*7}vw,0,0)`;const pp=progress(process),a=root.querySelector('.itt8__film--a'),b=root.querySelector('.itt8__film--b'),c=root.querySelector('.itt8__film--c');if(a)a.style.transform=`translate3d(${(pp-.18)*18}vw,${pp*-4}vh,0) rotate(${pp*3}deg)`;if(b)b.style.transform=`translate3d(${(0.72-pp)*20}vw,${pp*3}vh,0) rotate(${pp*-4}deg)`;if(c)c.style.transform=`translate3d(${(0.62-pp)*15}vw,${pp*-5}vh,0) rotate(${pp*3}deg)`;const ap=progress(atelier);if(atelierImage)atelierImage.style.transform=`translate3d(${(ap-.5)*8}vw,0,0) rotate(${(ap-.5)*1.5}deg)`;ticking=false};const on=()=>{if(!ticking){requestAnimationFrame(draw);ticking=true}};addEventListener('scroll',on,{passive:true});addEventListener('resize',on,{passive:true});draw()})();</script>
</section>
{% schema %}{"name":"ITT House","tag":"section","class":"section-itt-house-clean","settings":[{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"text","id":"hero_alt","label":"Hero alt text","default":"ittoldem atelier campaign"},{"type":"text","id":"hero_kicker","label":"Hero kicker","default":"MAISON · DÉTROIT — EAST SIDE"},{"type":"text","id":"hero_heading","label":"Hero heading","default":"I TOLD ’EM."},{"type":"textarea","id":"hero_copy","label":"Hero copy","default":"Fashion, tailoring, sportswear and objects. Limited pieces, custom work and ideas made to be worn."},{"type":"text","id":"hero_primary_label","label":"Primary label","default":"ENTER THE HOUSE"},{"type":"text","id":"hero_secondary_label","label":"Secondary label","default":"VIEW THE HOUSE EDIT"},{"type":"url","id":"hero_link","label":"Hero link"},{"type":"collection","id":"featured_collection","label":"Featured collection"}],"presets":[{"name":"ITT House"}]}{% endschema %}