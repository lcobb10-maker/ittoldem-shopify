{{ 'ittoldem-house.css' | asset_url | stylesheet_tag }}

<section class="itt-house">
  <div class="itt-announcement">
    <span>MAISON · DÉTROIT — EAST SIDE</span>
    <span>WORLDWIDE SHIPPING</span>
    <span>DESIGN TODAY. WEAR FOREVER.</span>
  </div>

  <div class="itt-hero">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2400 | image_tag: class: 'itt-hero__media', loading: 'eager', fetchpriority: 'high' }}
    {% else %}
      <div class="itt-hero__placeholder"></div>
    {% endif %}
    <div class="itt-hero__content">
      <div class="itt-kicker">A DESIGN HOUSE FROM DETROIT</div>
      <h1 class="itt-display itt-hero__title">MORE<br>THAN<br>CLOTHING.</h1>
      <p class="itt-hero__sub">A higher standard for what you wear. Fashion, sport, craft and culture under one house.</p>
      <a class="itt-btn" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}">SHOP THE DROP <span class="itt-arrow">→</span></a>
    </div>
    <div class="itt-script">We built the house.<br>Now we tell ’em.<small>JE VOUS L’AVAIS DIT.</small></div>
  </div>

  <div class="itt-categories">
    {% assign category_titles = 'APPAREL|FLAGLINE|CROCHET|DENIM' | split: '|' %}
    {% assign category_meta = 'HOODIES · TEES · JOGGERS|FOR HER. BY US.|HANDMADE EXPRESSION|CUSTOM · ENGRAVED · ONE OF ONE' | split: '|' %}
    {% for i in (1..4) %}
      {% assign image_key = 'category_image_' | append: i %}
      {% assign link_key = 'category_link_' | append: i %}
      <a class="itt-card" href="{{ section.settings[link_key] | default: routes.all_products_collection_url }}">
        {% if section.settings[image_key] != blank %}
          {{ section.settings[image_key] | image_url: width: 1200 | image_tag: class: 'itt-card__media', loading: 'lazy' }}
        {% else %}
          <div class="itt-card__placeholder"></div>
        {% endif %}
        <div class="itt-card__content">
          <h2 class="itt-card__title">{{ category_titles[forloop.index0] }}</h2>
          <div class="itt-card__meta">{{ category_meta[forloop.index0] }}</div>
          <div class="itt-card__link">SHOP <span class="itt-arrow">→</span></div>
        </div>
      </a>
    {% endfor %}
  </div>

  <div class="itt-products">
    <div class="itt-products__head">
      <h2 class="itt-display itt-products__title">NEW ARRIVALS</h2>
      <a class="itt-products__all" href="{{ section.settings.featured_collection.url | default: routes.all_products_collection_url }}">VIEW ALL <span class="itt-arrow">→</span></a>
    </div>
    <div class="itt-products__grid">
      {% assign featured = section.settings.featured_collection %}
      {% if featured != blank and featured.products_count > 0 %}
        {% for product in featured.products limit: 8 %}
          <a class="itt-product" href="{{ product.url }}">
            <div class="itt-product__image">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="itt-product__name">{{ product.title }}</div>
            <div class="itt-product__price">{{ product.price | money }}</div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..8) %}
          <div class="itt-product">
            <div class="itt-product__image">{{ 'product-apparel-' | append: i | modulo: 3 | plus: 1 | placeholder_svg_tag }}</div>
            <div class="itt-product__name">ITT TOLD’EM PIECE {{ i }}</div>
            <div class="itt-product__price">COMING SOON</div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <div class="itt-story">
    {% if section.settings.story_image != blank %}
      {{ section.settings.story_image | image_url: width: 2200 | image_tag: class: 'itt-story__media', loading: 'lazy' }}
    {% else %}
      <div class="itt-story__placeholder"></div>
    {% endif %}
    <div class="itt-story__content">
      <div class="itt-kicker">A DESIGN HOUSE FROM DETROIT</div>
      <h2 class="itt-display itt-story__title">ITT TOLD’EM</h2>
      <p class="itt-story__copy">We design for the real. Where fashion, sports, and culture meet. Built on creativity, craftsmanship, and the belief that anything is possible when you tell ’em first.</p>
      <a class="itt-btn" href="{{ section.settings.story_link | default: routes.root_url }}">OUR STORY <span class="itt-arrow">→</span></a>
    </div>
    <div class="itt-values">Culture<br>Craft<br>Community<br>Commerce</div>
  </div>

  <div class="itt-editorials">
    {% assign editorial_titles = 'FLAGLINE|MEN’S|KIDS' | split: '|' %}
    {% assign editorial_meta = 'POWER IN EVERY PIECE|ELEVATED ESSENTIALS|BIG ENERGY. EARLY.' | split: '|' %}
    {% for i in (1..3) %}
      {% assign image_key = 'editorial_image_' | append: i %}
      {% assign link_key = 'editorial_link_' | append: i %}
      <a class="itt-editorial" href="{{ section.settings[link_key] | default: routes.all_products_collection_url }}">
        {% if section.settings[image_key] != blank %}
          {{ section.settings[image_key] | image_url: width: 1400 | image_tag: class: 'itt-editorial__media', loading: 'lazy' }}
        {% else %}
          <div class="itt-editorial__placeholder"></div>
        {% endif %}
        <div class="itt-editorial__content">
          <h2 class="itt-editorial__title">{{ editorial_titles[forloop.index0] }}</h2>
          <div class="itt-editorial__meta">{{ editorial_meta[forloop.index0] }}</div>
          <div class="itt-card__link">SHOP <span class="itt-arrow">→</span></div>
        </div>
      </a>
    {% endfor %}
  </div>

  <div class="itt-servicebar">
    <div class="itt-service">✈ &nbsp; WORLDWIDE SHIPPING</div>
    <div class="itt-service">◇ &nbsp; PREMIUM QUALITY</div>
    <div class="itt-service">▢ &nbsp; SECURE CHECKOUT</div>
    <div class="itt-service">▣ &nbsp; FAST FULFILLMENT</div>
  </div>
  <div class="itt-footer-statement"><strong>ITT TOLD’EM <span class="itt-kicker">MAISON · DÉTROIT</span></strong><em>More Than Clothing.</em></div>
</section>

{% schema %}
{
  "name": "ITT TOLD'EM House",
  "tag": "section",
  "class": "section-ittoldem-house",
  "settings": [
    {"type":"image_picker","id":"hero_image","label":"Hero image"},
    {"type":"url","id":"hero_link","label":"Hero link"},
    {"type":"image_picker","id":"category_image_1","label":"Apparel image"},
    {"type":"url","id":"category_link_1","label":"Apparel link"},
    {"type":"image_picker","id":"category_image_2","label":"FLAGLINE image"},
    {"type":"url","id":"category_link_2","label":"FLAGLINE link"},
    {"type":"image_picker","id":"category_image_3","label":"Crochet image"},
    {"type":"url","id":"category_link_3","label":"Crochet link"},
    {"type":"image_picker","id":"category_image_4","label":"Denim image"},
    {"type":"url","id":"category_link_4","label":"Denim link"},
    {"type":"collection","id":"featured_collection","label":"New arrivals collection"},
    {"type":"image_picker","id":"story_image","label":"Story image"},
    {"type":"url","id":"story_link","label":"Story link"},
    {"type":"image_picker","id":"editorial_image_1","label":"FLAGLINE editorial image"},
    {"type":"url","id":"editorial_link_1","label":"FLAGLINE editorial link"},
    {"type":"image_picker","id":"editorial_image_2","label":"Men editorial image"},
    {"type":"url","id":"editorial_link_2","label":"Men editorial link"},
    {"type":"image_picker","id":"editorial_image_3","label":"Kids editorial image"},
    {"type":"url","id":"editorial_link_3","label":"Kids editorial link"}
  ],
  "presets": [{"name":"ITT TOLD'EM House"}]
}
{% endschema %}
