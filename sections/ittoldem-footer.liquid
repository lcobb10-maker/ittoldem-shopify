{%- liquid
  assign gvo_url = routes.search_url | append: '?view=gvo&type=product&q=GVO'
  assign flagline_url = routes.search_url | append: '?view=flagline&type=product&q=FLAGLINE'
  assign custom_url = routes.search_url | append: '?view=custom&type=product&q=CUSTOM'
  assign wehair_url = routes.search_url | append: '?view=wehair&type=product&q=WE%20HAIR'
  assign lab_url = routes.search_url | append: '?view=lab&type=product&q=CROCHET'
  assign about_url = routes.search_url | append: '?view=about&q=ITT'
  assign contact_page = pages['contact']
  assign contact_url = contact_page.url | default: routes.root_url
-%}
<footer class="itt-footer">
  <div class="itt-footer__worlds" aria-label="Choose an ITT TOLD'EM world">
    <div class="itt-footer__worlds-head"><span>05 / THE HOUSE</span><strong>Choose a world.</strong><small>I TOLD ’EM.</small></div>
    <div class="itt-footer__world-grid">
      <a class="itt-footer__world" href="{{ routes.root_url }}"><img src="{{ 'itt-world-maison.svg' | asset_url }}" alt="" width="240" height="240" loading="lazy"><span>LA MAISON</span><em>House Edit</em></a>
      <a class="itt-footer__world" href="{{ flagline_url | escape }}"><img src="{{ 'itt-world-flagline.svg' | asset_url }}" alt="" width="240" height="240" loading="lazy"><span>FLAGLINE</span><em>Sport / Field</em></a>
      <a class="itt-footer__world" href="{{ custom_url | escape }}"><img src="{{ 'itt-world-atelier.svg' | asset_url }}" alt="" width="240" height="240" loading="lazy"><span>L’ATELIER</span><em>Commission</em></a>
      <a class="itt-footer__world" href="{{ lab_url | escape }}"><img src="{{ 'itt-world-lab.svg' | asset_url }}" alt="" width="240" height="240" loading="lazy"><span>LE LABORATOIRE</span><em>Material Study</em></a>
      <a class="itt-footer__world" href="{{ wehair_url | escape }}"><img src="{{ 'itt-world-wehair.svg' | asset_url }}" alt="" width="240" height="240" loading="lazy"><span>WE HAIR</span><em>Objects / Hair</em></a>
    </div>
  </div>

  <div class="itt-footer__lead">
    <div>
      <div class="itt-footer__eyebrow">MAISON · DÉTROIT — EAST SIDE</div>
      <div class="itt-footer__brand">ITT TOLD’EM</div>
      <p>Fashion, sport, custom work, beauty tools and experimental fabrication built under one house.</p>
    </div>
    <div class="itt-footer__signal">
      <div class="itt-footer__eyebrow">GET THE DROP SIGNAL</div>
      {% form 'customer', class: 'itt-footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter,ittoldem-footer">
        <label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email address</label>
        <input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="EMAIL ADDRESS" autocomplete="email" required>
        <button type="submit">JOIN →</button>
        {% if form.posted_successfully? %}<p role="status">YOU’RE IN.</p>{% endif %}
        {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      {% endform %}
    </div>
  </div>

  <div class="itt-footer__grid">
    <div><span>SHOP</span><a href="{{ routes.all_products_collection_url }}">All Pieces</a><a href="{{ gvo_url | escape }}">GVO</a><a href="{{ flagline_url | escape }}">FLAGLINE</a></div>
    <div><span>HOUSE</span><a href="{{ custom_url | escape }}">Custom</a><a href="{{ wehair_url | escape }}">WE HAIR</a><a href="{{ lab_url | escape }}">The Lab</a><a href="{{ about_url | escape }}">About</a></div>
    <div><span>HELP</span><a href="{{ contact_url }}">Contact</a><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Cart</a></div>
    <div><span>POLICIES</span>{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Refund</a>{% endif %}{% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping</a>{% endif %}{% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{% endif %}{% if shop.terms_of_service != blank %}<a href="{{ shop.terms_of_service.url }}">Terms</a>{% endif %}</div>
  </div>
  <div class="itt-footer__bottom"><span>© {{ 'now' | date: '%Y' }} ITT TOLD’EM</span><span>WE BUILT THE HOUSE. NOW WE TELL ’EM.</span></div>
</footer>

{% stylesheet %}
.itt-footer{background:#050505;color:#f4efe6}.itt-footer a{color:inherit;text-decoration:none}.itt-footer__worlds{padding:64px max(24px,5vw) 50px;border-top:1px solid #242424}.itt-footer__worlds-head{display:grid;grid-template-columns:1fr auto 1fr;align-items:end;gap:24px;margin-bottom:36px}.itt-footer__worlds-head>span,.itt-footer__worlds-head>small{font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;opacity:.55}.itt-footer__worlds-head>strong{font-family:var(--font-heading--family,serif);font-size:clamp(2.8rem,6vw,6rem);font-style:italic;font-weight:400;line-height:.9;letter-spacing:-.04em}.itt-footer__worlds-head>small{text-align:right}.itt-footer__world-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border-top:1px solid #242424;border-left:1px solid #242424}.itt-footer__world{min-width:0;display:flex;min-height:320px;flex-direction:column;justify-content:flex-end;padding:24px 18px;border-right:1px solid #242424;border-bottom:1px solid #242424;transition:background .25s ease,color .25s ease}.itt-footer__world img{width:min(100%,170px);height:auto;aspect-ratio:1;object-fit:contain;align-self:center;margin:auto auto 24px;filter:invert(1);opacity:.82;transition:transform .3s ease,opacity .3s ease}.itt-footer__world>span{font-size:.62rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;opacity:.7}.itt-footer__world>em{font-family:var(--font-heading--family,serif);font-size:clamp(1.45rem,2.1vw,2.2rem);line-height:1.05;margin-top:12px}.itt-footer__world:hover,.itt-footer__world:focus-visible{background:#f4efe6;color:#050505;outline:none}.itt-footer__world:hover img,.itt-footer__world:focus-visible img{filter:none;opacity:1;transform:scale(1.04)}.itt-footer__lead{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;padding:54px max(24px,5vw);border-top:1px solid #242424}.itt-footer__eyebrow{font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;opacity:.62}.itt-footer__brand{font-family:var(--font-heading--family,serif);font-size:clamp(3rem,7vw,7rem);line-height:.85;letter-spacing:-.05em;margin:12px 0 18px}.itt-footer__lead p{max-width:42rem;line-height:1.55;opacity:.72}.itt-footer__form{display:grid;grid-template-columns:1fr auto;margin-top:18px}.itt-footer__form input{min-width:0;background:transparent;color:inherit;border:1px solid #555;padding:14px;min-height:50px;border-radius:0}.itt-footer__form button{background:#f4efe6;color:#111;border:1px solid #f4efe6;padding:0 20px;min-height:50px;font-weight:700;letter-spacing:.08em}.itt-footer__form p,.itt-footer__form div{grid-column:1/-1;font-size:.72rem;letter-spacing:.08em;margin-top:9px}.itt-footer__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;padding:34px max(24px,5vw);border-top:1px solid #242424}.itt-footer__grid>div{display:flex;flex-direction:column;gap:9px}.itt-footer__grid span{font-size:.66rem;letter-spacing:.15em;font-weight:700;opacity:.58;margin-bottom:7px}.itt-footer__grid a{font-size:.88rem}.itt-footer__grid a:hover{text-decoration:underline;text-underline-offset:4px}.itt-footer__bottom{display:flex;justify-content:space-between;gap:24px;padding:18px max(24px,5vw);border-top:1px solid #242424;font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;opacity:.72}@media(max-width:900px){.itt-footer__world-grid{grid-template-columns:1fr 1fr}.itt-footer__world:last-child{grid-column:1/-1}.itt-footer__worlds-head{grid-template-columns:1fr}.itt-footer__worlds-head>small{text-align:left}.itt-footer__world{min-height:270px}.itt-footer__world img{width:140px}}@media(max-width:749px){.itt-footer__worlds{padding:42px 20px 36px}.itt-footer__worlds-head{margin-bottom:24px}.itt-footer__world-grid{grid-template-columns:1fr 1fr}.itt-footer__world{min-height:230px;padding:18px 14px}.itt-footer__world img{width:112px;margin-bottom:18px}.itt-footer__world:last-child{grid-column:1/-1}.itt-footer__lead{grid-template-columns:1fr;padding:38px 20px}.itt-footer__grid{grid-template-columns:1fr 1fr;padding:28px 20px}.itt-footer__bottom{flex-direction:column;padding:18px 20px}.itt-footer__form{grid-template-columns:1fr}.itt-footer__form button{padding:14px}}
{% endstylesheet %}

{% schema %}
{"name":"ITT TOLD'EM Footer","tag":"section","settings":[],"presets":[{"name":"ITT TOLD'EM Footer"}]}
{% endschema %}
