<section class="itt-watch4" id="IttWatch4-{{ section.id }}">
  <style>
    #IttWatch4-{{ section.id }}{background:#090909;color:#f7f2e8;padding:clamp(3rem,6vw,6rem) clamp(1rem,4vw,4rem);border-top:1px solid rgba(255,255,255,.08)}
    #IttWatch4-{{ section.id }} *{box-sizing:border-box}.itt-watch4__head{display:grid;grid-template-columns:1.15fr .85fr;gap:2rem;align-items:end;margin-bottom:2rem}.itt-watch4__kicker{font-size:.64rem;letter-spacing:.24em;text-transform:uppercase;opacity:.68}.itt-watch4__title{margin:.6rem 0 0;font-weight:500;letter-spacing:-.06em;line-height:.86;text-transform:uppercase;font-size:clamp(3.2rem,7vw,7.4rem)}.itt-watch4__head p{max-width:34rem;margin:0 0 .2rem auto;color:rgba(247,242,232,.7);line-height:1.55}.itt-watch4__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.itt-watch4__card{position:relative;min-height:clamp(440px,46vw,700px);overflow:hidden;background:#151515;border:1px solid rgba(255,255,255,.12);isolation:isolate}.itt-watch4__card video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.itt-watch4__card:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.02) 32%,rgba(0,0,0,.86) 100%);z-index:1;pointer-events:none}.itt-watch4__ui{position:absolute;z-index:2;left:1rem;right:1rem;bottom:1rem}.itt-watch4__badge{display:inline-block;border:1px solid rgba(255,255,255,.5);padding:.4rem .58rem;font-size:.55rem;letter-spacing:.16em;text-transform:uppercase;background:rgba(0,0,0,.34)}.itt-watch4__ui h3{margin:.7rem 0 .35rem;text-transform:uppercase;line-height:.92;font-size:clamp(1.35rem,2vw,2.5rem)}.itt-watch4__ui p{margin:0;color:rgba(247,242,232,.72);font-size:.76rem;line-height:1.4}.itt-watch4__controls{display:flex;gap:.5rem;margin-top:.8rem}.itt-watch4__btn{border:1px solid rgba(255,255,255,.48);background:rgba(0,0,0,.35);color:#fff;padding:.5rem .7rem;font:inherit;font-size:.56rem;letter-spacing:.13em;text-transform:uppercase}.itt-watch4__master{margin-top:1rem;display:flex;justify-content:flex-end}.itt-watch4__master button{border:1px solid rgba(255,255,255,.42);background:transparent;color:#fff;padding:.65rem .85rem;font:inherit;font-size:.58rem;letter-spacing:.14em;text-transform:uppercase}
    @media(max-width:900px){.itt-watch4__head{grid-template-columns:1fr}.itt-watch4__grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:.5rem}.itt-watch4__card{flex:0 0 78vw;min-height:62svh;scroll-snap-align:center}}
  </style>
  <div class="itt-watch4__head"><div><div class="itt-watch4__kicker">THE MAKERS FLOOR · DETROIT</div><h2 class="itt-watch4__title">WATCH IT<br>BECOME REAL.</h2></div><p>Four real processes, all moving at once. Fit, raised print, laser work and finished joggers — proof that the house exists beyond campaign imagery.</p></div>
  <div class="itt-watch4__grid">
    <article class="itt-watch4__card"><video muted loop playsinline preload="auto" src="https://cdn.shopify.com/videos/c/o/v/87040c4ea6db4c80927dc1f729b4444f.mov"></video><div class="itt-watch4__ui"><span class="itt-watch4__badge">REAL FIT</span><h3>ON BODY. IN MOTION.</h3><p>Real pants, shown from every angle.</p><div class="itt-watch4__controls"><button class="itt-watch4__btn js-sound" type="button">SOUND ON</button></div></div></article>
    <article class="itt-watch4__card"><video muted loop playsinline preload="auto" src="https://cdn.shopify.com/videos/c/o/v/829da22df9ae4c89ad7479a2440de5fe.mov"></video><div class="itt-watch4__ui"><span class="itt-watch4__badge">PUFF PRINT</span><h3>TOUCH THE SURFACE.</h3><p>Raised print shown close-up by hand.</p><div class="itt-watch4__controls"><button class="itt-watch4__btn js-sound" type="button">SOUND ON</button></div></div></article>
    <article class="itt-watch4__card"><video muted loop playsinline preload="auto" src="https://cdn.shopify.com/videos/c/o/v/cbb48a13846a47ed964d127d0d92947c.mov"></video><div class="itt-watch4__ui"><span class="itt-watch4__badge">LASER CUTTING</span><h3>PATTERN TO PANEL.</h3><p>The making process becomes part of the design language.</p><div class="itt-watch4__controls"><button class="itt-watch4__btn js-sound" type="button">SOUND ON</button></div></div></article>
    <article class="itt-watch4__card"><video muted loop playsinline preload="auto" src="https://cdn.shopify.com/videos/c/o/v/3fc17ed4da83432f86079c82c790ddbb.mov"></video><div class="itt-watch4__ui"><span class="itt-watch4__badge">RICH FRIENDS</span><h3>FINISHED, THEN WORN.</h3><p>Joggers moving as a finished garment, not a mockup.</p><div class="itt-watch4__controls"><button class="itt-watch4__btn js-sound" type="button">SOUND ON</button></div></div></article>
  </div>
  <div class="itt-watch4__master"><button class="js-master" type="button">PAUSE ALL</button></div>
  <script>
    (()=>{const root=document.getElementById('IttWatch4-{{ section.id }}');if(!root)return;const videos=[...root.querySelectorAll('video')],master=root.querySelector('.js-master');let wanted=true;const playAll=()=>{wanted=true;videos.forEach(v=>{v.muted=true;v.play().catch(()=>{})});master.textContent='PAUSE ALL'};const pauseAll=()=>{wanted=false;videos.forEach(v=>v.pause());master.textContent='PLAY ALL'};master.addEventListener('click',()=>wanted?pauseAll():playAll());root.querySelectorAll('.js-sound').forEach((b,i)=>b.addEventListener('click',()=>{const v=videos[i];v.muted=!v.muted;b.textContent=v.muted?'SOUND ON':'SOUND OFF';if(v.paused&&wanted)v.play().catch(()=>{})}));const io=new IntersectionObserver(es=>{const e=es[0];if(e.isIntersecting&&e.intersectionRatio>.2){if(wanted)playAll()}else{videos.forEach(v=>v.pause())}},{threshold:[0,.2,.5]});io.observe(root);document.addEventListener('visibilitychange',()=>{if(document.hidden)videos.forEach(v=>v.pause());else if(wanted)playAll()});})();
  </script>
</section>
