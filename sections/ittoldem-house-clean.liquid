<section class="itt-clean" id="IttClean-{{ section.id }}">
  <style>
    #IttClean-{{ section.id }}{--ink:#070707;--paper:#eee5d5;--white:#f7f2e8;background:var(--ink);color:var(--white);overflow:hidden}
    #IttClean-{{ section.id }} *{box-sizing:border-box}#IttClean-{{ section.id }} a{color:inherit;text-decoration:none}
    .itt-clean__hero{position:relative;height:clamp(620px,82svh,940px);overflow:hidden;background:#080706;isolation:isolate;touch-action:pan-y}
    .itt-clean__hero-media{position:absolute;inset:-7%;z-index:0;will-change:transform}.itt-clean__hero-media img{width:100%;height:100%;object-fit:cover;object-position:center;filter:brightness(.55) saturate(.78) contrast(1.12);transform:scale(1.04)}
    .itt-clean__hero:before{content:'';position:absolute;inset:0;z-index:1;background:radial-gradient(circle at 67% 43%,transparent 0 23%,rgba(0,0,0,.18) 51%,rgba(0,0,0,.74) 100%),linear-gradient(90deg,rgba(0,0,0,.76),rgba(0,0,0,.06) 56%,rgba(0,0,0,.4));pointer-events:none}.itt-clean__hero:after{content:'';position:absolute;inset:0;z-index:5;pointer-events:none;background:linear-gradient(180deg,rgba(0,0,0,.16),transparent 55%,#080808 100%)}
    .itt-clean__matrix{position:absolute;inset:0;z-index:2;overflow:hidden;pointer-events:none;mix-blend-mode:screen}.itt-clean__fall{position:absolute;top:-20%;font-size:.55rem;letter-spacing:.18em;text-transform:uppercase;color:rgba(247,242,232,.2);writing-mode:vertical-rl;animation:ittFall var(--dur) linear infinite;animation-delay:var(--delay);text-shadow:0 0 18px rgba(215,181,108,.2)}.itt-clean__fall:nth-child(3n){color:rgba(206,164,75,.28)}.itt-clean__fall:nth-child(4n){font-family:serif;font-style:italic;font-size:.8rem;opacity:.6}@keyframes ittFall{to{transform:translateY(125svh)}}
    .itt-clean__brand{position:absolute;z-index:4;left:clamp(1.2rem,4.5vw,5rem);right:clamp(1.2rem,4.5vw,5rem);top:50%;transform:translateY(-48%);pointer-events:none}.itt-clean__mark{display:flex;align-items:flex-start;white-space:nowrap;font-family:Georgia,serif;font-style:italic;font-size:clamp(5.2rem,15vw,15rem);font-weight:400;line-height:.68;letter-spacing:-.09em;text-transform:lowercase;color:rgba(247,242,232,.94);text-shadow:0 10px 40px rgba(0,0,0,.55)}.itt-clean__char{position:relative;display:inline-block;will-change:transform,opacity;transform:translate3d(calc(var(--bx,0px) * var(--break,0)),calc(var(--fallY,0px) * var(--break,0)),0) rotate(calc(var(--rot,0deg) * var(--break,0)));opacity:calc(1 - (var(--break,0) * .35))}.itt-clean__char:before,.itt-clean__char:after{content:attr(data-char);position:absolute;inset:0;color:rgba(247,242,232,.96);pointer-events:none;opacity:var(--break,0);text-shadow:0 16px 38px rgba(0,0,0,.52)}.itt-clean__char:before{clip-path:polygon(0 0,100% 0,100% 53%,0 68%);transform:translate3d(calc(var(--fx1,0px) * var(--break,0)),calc(var(--fy1,0px) * var(--break,0)),0) rotate(calc(var(--fr1,0deg) * var(--break,0)))}.itt-clean__char:after{clip-path:polygon(0 52%,100% 38%,100% 100%,0 100%);transform:translate3d(calc(var(--fx2,0px) * var(--break,0)),calc(var(--fy2,0px) * var(--break,0)),0) rotate(calc(var(--fr2,0deg) * var(--break,0)))}.itt-clean__tm{font-family:Arial,sans-serif;font-style:normal;font-size:clamp(.65rem,1vw,1rem);vertical-align:top;margin-left:.18em;letter-spacing:0;transform:translateY(.1em)}.itt-clean__thought{margin-top:1.4rem;margin-left:clamp(.3rem,8vw,9rem);font-size:clamp(.72rem,1.15vw,1rem);letter-spacing:.32em;text-transform:uppercase;color:rgba(247,242,232,.78)}
    .itt-clean__rails{position:absolute;inset:0;z-index:4;pointer-events:none;overflow:hidden}.itt-clean__rail{position:absolute;top:0;bottom:0;width:clamp(64px,8vw,116px);overflow:hidden}.itt-clean__rail--left{left:0}.itt-clean__rail--right{right:0}.itt-clean__brandfall{position:absolute;top:-18%;font-size:clamp(.46rem,.7vw,.62rem);letter-spacing:.2em;text-transform:uppercase;color:rgba(247,242,232,.5);writing-mode:vertical-rl;text-orientation:mixed;animation:ittBrandFall var(--dur) linear infinite;animation-delay:var(--delay);opacity:calc(.35 + var(--scrollBoost,0) * .55);filter:blur(calc((1 - var(--scrollBoost,0)) * .15px));will-change:transform}.itt-clean__rail--left .itt-clean__brandfall:nth-child(odd){left:14%}.itt-clean__rail--left .itt-clean__brandfall:nth-child(even){left:54%}.itt-clean__rail--right .itt-clean__brandfall:nth-child(odd){right:14%}.itt-clean__rail--right .itt-clean__brandfall:nth-child(even){right:54%}.itt-clean__brandfall:nth-child(3n){color:rgba(215,181,108,.68);font-family:Georgia,serif;font-style:italic;font-size:clamp(.56rem,.9vw,.78rem)}@keyframes ittBrandFall{to{transform:translate3d(0,125svh,0) rotate(.001deg)}}
    .itt-clean__dust{position:absolute;inset:0;z-index:4;pointer-events:none;overflow:hidden}.itt-clean__dust i{position:absolute;width:2px;height:2px;background:rgba(247,242,232,.72);opacity:0;transform:translate3d(0,0,0) rotate(0);box-shadow:0 0 8px rgba(215,181,108,.25);will-change:transform,opacity}
    .itt-clean__copy{position:absolute;z-index:6;left:clamp(1.2rem,4.5vw,5rem);right:clamp(1.2rem,4.5vw,5rem);bottom:clamp(2rem,5vw,4.8rem);display:grid;grid-template-columns:1fr auto;align-items:end;gap:2rem}.itt-clean__kicker{font-size:.58rem;letter-spacing:.27em;text-transform:uppercase;opacity:.72}.itt-clean__copy p{max-width:510px;margin:.7rem 0 0;color:rgba(247,242,232,.72);font-size:clamp(.82rem,1vw,1rem);line-height:1.55}.itt-clean__actions{display:flex;gap:.55rem}.itt-clean__cta{display:inline-flex;align-items:center;min-height:44px;border-bottom:1px solid rgba(247,242,232,.6);padding:.65rem .1rem;font-size:.58rem;letter-spacing:.17em;text-transform:uppercase;backdrop-filter:blur(5px);-webkit-tap-highlight-color:transparent}
    .itt-clean__edit{background:var(--paper);color:#111;padding:clamp(3rem,6vw,6rem) clamp(1rem,5vw,5rem)}.itt-clean__edit-head{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:2rem}.itt-clean__edit h2{margin:.35rem 0 0;font-size:clamp(2.7rem,6vw,6.6rem);font-weight:500;letter-spacing:-.06em;line-height:.86;text-transform:uppercase}.itt-clean__view{font-size:.62rem;letter-spacing:.13em;text-transform:uppercase;white-space:nowrap}.itt-clean__products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.itt-clean__product{display:block;min-width:0}.itt-clean__media{overflow:hidden;background:#d7cfc1;aspect-ratio:4/5}.itt-clean__media img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .5s ease}.itt-clean__product:hover .itt-clean__media img{transform:scale(1.025)}.itt-clean__meta{display:flex;justify-content:space-between;gap:.8rem;padding-top:.72rem;font-size:.64rem;line-height:1.25;letter-spacing:.035em;text-transform:uppercase}.itt-clean__meta span:first-child{max-width:74%}
    @media(max-width:900px){.itt-clean__products{grid-template-columns:repeat(2,1fr)}.itt-clean__copy{grid-template-columns:1fr}.itt-clean__actions{justify-self:start}.itt-clean__rail{width:54px}.itt-clean__brandfall{font-size:.48rem}}
    @media(max-width:560px){.itt-clean__hero{height:76svh;min-height:620px}.itt-clean__hero-media{inset:-3% -18%}.itt-clean__hero-media img{object-position:58% center}.itt-clean__brand{top:42%;left:18px;right:18px}.itt-clean__mark{font-size:24vw}.itt-clean__thought{margin-left:.2rem;font-size:.52rem;letter-spacing:.22em;max-width:72%}.itt-clean__copy{left:18px;right:18px;bottom:1.25rem}.itt-clean__copy p{max-width:86%;font-size:.78rem}.itt-clean__actions{flex-wrap:wrap}.itt-clean__edit{padding:2.6rem 1rem}.itt-clean__edit-head{align-items:start;flex-direction:column;gap:.8rem}.itt-clean__products{gap:.65rem}.itt-clean__meta{font-size:.57rem}.itt-clean__fall:nth-child(2n){display:none}.itt-clean__rail{width:40px}.itt-clean__rail--left{left:-4px}.itt-clean__rail--right{right:-4px}.itt-clean__brandfall{font-size:.43rem;letter-spacing:.16em}.itt-clean__tm{font-size:.58rem}}
    @media(prefers-reduced-motion:reduce){.itt-clean__fall,.itt-clean__brandfall{animation:none;display:none}.itt-clean__hero-media{transform:none!important}.itt-clean__char,.itt-clean__char:before,.itt-clean__char:after{transform:none!important;opacity:1!important}.itt-clean__dust{display:none}}
  </style>
  <div class="itt-clean__hero" data-itt-parallax>
    <div class="itt-clean__hero-media" data-itt-depth=".12">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2600 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_alt }}{% endif %}</div>
    <div class="itt-clean__matrix" aria-hidden="true">
      <span class="itt-clean__fall" style="left:5%;--dur:18s;--delay:-8s">I TOLD ’EM · ONE OF ONE ·</span><span class="itt-clean__fall" style="left:14%;--dur:24s;--delay:-19s">ittoldem™ · 313 ·</span><span class="itt-clean__fall" style="left:24%;--dur:21s;--delay:-4s">TAILORING · SPORTSWEAR ·</span><span class="itt-clean__fall" style="left:36%;--dur:27s;--delay:-14s">CUT / PRESS / MAKE ·</span><span class="itt-clean__fall" style="left:48%;--dur:19s;--delay:-11s">MAISON · EAST SIDE ·</span><span class="itt-clean__fall" style="left:59%;--dur:25s;--delay:-6s">I TOLD ’EM ·</span><span class="itt-clean__fall" style="left:69%;--dur:22s;--delay:-17s">ONE OF FEW · CUSTOM ·</span><span class="itt-clean__fall" style="left:79%;--dur:29s;--delay:-9s">IDEAS BECOME OBJECTS ·</span><span class="itt-clean__fall" style="left:90%;--dur:20s;--delay:-2s">ittoldem™ ·</span><span class="itt-clean__fall" style="left:96%;--dur:26s;--delay:-21s">ALTER / WEAR / REPEAT ·</span>
    </div>
    <div class="itt-clean__rails" aria-hidden="true">
      <div class="itt-clean__rail itt-clean__rail--left"><span class="itt-clean__brandfall" style="--dur:16s;--delay:-4s">FLAGLINE</span><span class="itt-clean__brandfall" style="--dur:22s;--delay:-14s">L’ATELIER</span><span class="itt-clean__brandfall" style="--dur:19s;--delay:-9s">LE LABORATOIRE</span><span class="itt-clean__brandfall" style="--dur:25s;--delay:-20s">LA MAISON</span><span class="itt-clean__brandfall" style="--dur:18s;--delay:-2s">CUSTOM</span></div>
      <div class="itt-clean__rail itt-clean__rail--right"><span class="itt-clean__brandfall" style="--dur:21s;--delay:-12s">ITTELIER</span><span class="itt-clean__brandfall" style="--dur:17s;--delay:-7s">FLAGLINE</span><span class="itt-clean__brandfall" style="--dur:24s;--delay:-18s">THE LAB</span><span class="itt-clean__brandfall" style="--dur:20s;--delay:-5s">TAILORING</span><span class="itt-clean__brandfall" style="--dur:27s;--delay:-23s">ONE OF ONE</span></div>
    </div>
    <div class="itt-clean__dust" aria-hidden="true"></div>
    <div class="itt-clean__brand" data-itt-depth=".3"><div class="itt-clean__mark" aria-label="ittoldem trademark"><span class="itt-clean__char" data-char="i">i</span><span class="itt-clean__char" data-char="t">t</span><span class="itt-clean__char" data-char="t">t</span><span class="itt-clean__char" data-char="o">o</span><span class="itt-clean__char" data-char="l">l</span><span class="itt-clean__char" data-char="d">d</span><span class="itt-clean__char" data-char="e">e</span><span class="itt-clean__char" data-char="m">m</span><span class="itt-clean__tm">™</span></div><div class="itt-clean__thought">I TOLD ’EM · SAME THOUGHT / DIFFERENT LEVELS</div></div>
    <div class="itt-clean__copy"><div><div class="itt-clean__kicker">{{ section.settings.hero_kicker | escape }}</div><p>{{ section.settings.hero_copy | escape }}</p></div><div class="itt-clean__actions"><a class="itt-clean__cta" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}">{{ section.settings.hero_primary_label | escape }} →</a><a class="itt-clean__cta" href="#HouseEdit-{{ section.id }}">{{ section.settings.hero_secondary_label | escape }} ↓</a></div></div>
  </div>
  <section class="itt-clean__edit" id="HouseEdit-{{ section.id }}"><div class="itt-clean__edit-head"><div><div class="itt-clean__kicker">CURRENT RELEASE</div><h2>THE HOUSE EDIT</h2></div><a class="itt-clean__view" href="{{ section.settings.featured_collection.url | default: routes.all_products_collection_url }}">VIEW THE COLLECTION →</a></div><div class="itt-clean__products">{% assign featured = section.settings.featured_collection %}{% if featured != blank %}{% for product in featured.products limit: 4 %}{% if product.featured_image != blank %}<a class="itt-clean__product" href="{{ product.url }}"><div class="itt-clean__media">{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}</div><div class="itt-clean__meta"><span>{{ product.title }}</span><span>{{ product.price | money }}</span></div></a>{% endif %}{% endfor %}{% endif %}</div></section>
  <script>
    (()=>{const root=document.getElementById('IttClean-{{ section.id }}'),hero=root?.querySelector('[data-itt-parallax]');if(!hero||matchMedia('(prefers-reduced-motion: reduce)').matches)return;const layers=[...hero.querySelectorAll('[data-itt-depth]')],chars=[...hero.querySelectorAll('.itt-clean__char')],dust=hero.querySelector('.itt-clean__dust'),brandDrops=[...hero.querySelectorAll('.itt-clean__brandfall')];chars.forEach((c,i)=>{const s=i%2?-1:1;c.style.setProperty('--bx',`${s*(7+i*2)}px`);c.style.setProperty('--fallY',`${58+i*15}px`);c.style.setProperty('--rot',`${s*(3+i*1.6)}deg`);c.style.setProperty('--fx1',`${s*(18+i*4)}px`);c.style.setProperty('--fy1',`${72+i*18}px`);c.style.setProperty('--fr1',`${s*(12+i*3)}deg`);c.style.setProperty('--fx2',`${-s*(13+i*3)}px`);c.style.setProperty('--fy2',`${106+i*22}px`);c.style.setProperty('--fr2',`${-s*(10+i*2.4)}deg`)});if(dust){for(let i=0;i<26;i++){const p=document.createElement('i');p.style.left=`${18+Math.random()*64}%`;p.style.top=`${34+Math.random()*23}%`;p.dataset.drift=(Math.random()*2-1).toFixed(2);p.dataset.fall=(70+Math.random()*250).toFixed(0);p.dataset.delay=Math.random().toFixed(2);dust.appendChild(p)}}const particles=dust?[...dust.children]:[];let ticking=false;const draw=()=>{const r=hero.getBoundingClientRect(),vh=innerHeight,progress=Math.max(0,Math.min(1,(0-r.top)/(Math.max(1,r.height-vh*.18)))),breakP=Math.max(0,Math.min(1,(progress-.06)/.72));hero.style.setProperty('--scrollBoost',breakP.toFixed(3));layers.forEach(l=>l.style.transform=`translate3d(0,${(vh/2-(r.top+r.height/2))*Number(l.dataset.ittDepth)}px,0)`);chars.forEach((c,i)=>c.style.setProperty('--break',Math.max(0,Math.min(1,breakP*1.18-i*.028)).toFixed(3)));particles.forEach((p,i)=>{const local=Math.max(0,Math.min(1,(breakP-Number(p.dataset.delay)*.42)*1.9)),x=Number(p.dataset.drift)*52*local,y=Number(p.dataset.fall)*local;p.style.opacity=(local*.72).toFixed(2);p.style.transform=`translate3d(${x}px,${y}px,0) rotate(${(i%2?-1:1)*local*170}deg)`});brandDrops.forEach((b,i)=>{b.style.animationDuration=`${Math.max(8,Number.parseFloat(getComputedStyle(b).getPropertyValue('--dur'))*(1-breakP*.38))}s`});ticking=false};const queue=()=>{if(!ticking){requestAnimationFrame(draw);ticking=true}};addEventListener('scroll',queue,{passive:true});addEventListener('resize',queue,{passive:true});queue()})();
  </script>
</section>
{% schema %}{"name":"ITT House Clean","settings":[{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"text","id":"hero_alt","label":"Hero image alt text","default":"ittoldem atelier campaign"},{"type":"text","id":"hero_kicker","label":"Hero kicker","default":"MAISON · DÉTROIT — EAST SIDE"},{"type":"textarea","id":"hero_heading","label":"Hero heading","default":"I TOLD ’EM."},{"type":"textarea","id":"hero_copy","label":"Hero copy","default":"Fashion, tailoring, sportswear and objects. Limited pieces, custom work and ideas made to be worn."},{"type":"text","id":"hero_primary_label","label":"Primary button","default":"ENTER THE HOUSE"},{"type":"text","id":"hero_secondary_label","label":"Secondary button","default":"VIEW THE HOUSE EDIT"},{"type":"url","id":"hero_link","label":"Hero link"},{"type":"collection","id":"featured_collection","label":"Featured collection"}],"presets":[{"name":"ITT House Clean"}]}{% endschema %}