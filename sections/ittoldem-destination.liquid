{{ 'ittoldem-destination.css' | asset_url | stylesheet_tag }}

{% liquid
  assign destination_image = 'itt-final-apparel.webp'
  case section.settings.world
    when 'gvo'
      assign destination_image = 'itt-final-gvo.webp'
    when 'flagline'
      assign destination_image = 'itt-final-flagline.webp'
    when 'wehair'
      assign destination_image = 'itt-final-wehair.webp'
    when 'lab'
      assign destination_image = 'itt-final-lab.webp'
    when 'custom'
      assign destination_image = 'itt-final-denim.webp'
  endcase
%}

<section class="itt-destination" aria-labelledby="IttDestinationTitle-{{ section.id }}">
  <img class="itt-destination__media" src="{{ destination_image | asset_url }}" loading="eager" fetchpriority="high" alt="{{ section.settings.title | escape }}">
  <div class="itt-destination__panel">
    <div class="itt-destination__eyebrow">{{ section.settings.eyebrow }}</div>
    <h1 id="IttDestinationTitle-{{ section.id }}" class="itt-destination__title">{{ section.settings.title }}</h1>
    <p class="itt-destination__copy">{{ section.settings.copy }}</p>
    <div class="itt-destination__meta">{{ section.settings.meta }}</div>
    <a class="itt-destination__back" href="{{ routes.root_url }}">← BACK TO THE HOUSE</a>
  </div>
</section>

{% if search.performed %}
  {% paginate search.results by 24 %}
    {% if search.results_count > 0 %}
      <section class="itt-destination-products" aria-label="{{ section.settings.title | escape }} products">
        <div class="itt-destination-products__head">
          <h2>{{ section.settings.results_heading }}</h2>
          <div class="itt-destination-products__count">{{ search.results_count }} RESULTS</div>
        </div>
        <div class="itt-destination-products__grid">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              <a class="itt-destination-product" href="{{ item.url }}">
                <div class="itt-destination-product__image">
                  {% if item.featured_image %}
                    {{ item.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: item.title }}
                  {% else %}
                    {{ 'product-apparel-1' | placeholder_svg_tag }}
                  {% endif %}
                </div>
                <div class="itt-destination-product__meta">
                  <span class="itt-destination-product__title">{{ item.title }}</span>
                  <span class="itt-destination-product__price">{{ item.price | money }}</span>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}<div class="itt-destination-pagination">{{ paginate | default_pagination }}</div>{% endif %}
      </section>
    {% else %}
      <section class="itt-destination-empty">
        <h2>THE WORLD IS BEING BUILT.</h2>
        <p>Nothing matched this house world yet. The full store is still available while this destination fills out.</p>
        <a href="{{ routes.all_products_collection_url }}">SHOP THE HOUSE →</a>
      </section>
    {% endif %}
  {% endpaginate %}
{% endif %}

{% schema %}
{
  "name": "ITT Destination",
  "tag": "section",
  "settings": [
    {"type":"select","id":"world","label":"House world","default":"gvo","options":[{"value":"gvo","label":"GVO"},{"value":"flagline","label":"FLAGLINE"},{"value":"wehair","label":"WE HAIR"},{"value":"lab","label":"THE LAB"},{"value":"custom","label":"CUSTOM"},{"value":"apparel","label":"APPAREL"}]},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"ITT TOLD’EM · HOUSE WORLD"},
    {"type":"text","id":"title","label":"Title","default":"GVO"},
    {"type":"textarea","id":"copy","label":"Copy","default":"Sport, training and culture through the ITT TOLD’EM point of view."},
    {"type":"text","id":"meta","label":"Meta","default":"DETROIT · SPORT · CULTURE"},
    {"type":"text","id":"results_heading","label":"Results heading","default":"AVAILABLE NOW"}
  ],
  "presets": [{"name":"ITT Destination"}]
}
{% endschema %}