<section class="itt-field" id="IttField-{{ section.id }}">
  <style>
    .itt-v3__cinema,.itt-v3__archive,.section-itt-watch-four{display:none!important}
    #IttField-{{ section.id }}{--ink:#050505;--paper:#f2eadc;position:relative;background:var(--ink);color:#f7f2e8;min-height:165svh;overflow:clip;isolation:isolate}
    #IttField-{{ section.id }} *{box-sizing:border-box}
    .itt-field__sticky{position:sticky;top:0;height:100svh;min-height:720px;overflow:hidden;padding:clamp(2rem,5vw,4.8rem) clamp(1rem,4vw,4rem);touch-action:pan-y;background:radial-gradient(circle at 54% 52%,rgba(255,255,255,.035),transparent 33%),#050505}
    .itt-field__grain{position:absolute;inset:0;pointer-events:none;z-index:20;opacity:.16;background-image:radial-gradient(circle,rgba(255,255,255,.55) .55px,transparent .7px);background-size:4px 4px;mix-blend-mode:soft-light;mask-image:linear-gradient(115deg,#000,transparent 42%,#000)}
    .itt-field__head{position:absolute;z-index:12;left:clamp(1rem,4vw,4rem);top:clamp(2.2rem,6vw,5.8rem);max-width:78vw}.itt-field__kicker{font-size:.58rem;letter-spacing:.28em;text-transform:uppercase;opacity:.58}.itt-field__title{margin:.55rem 0 0;font-size:clamp(4.2rem,11vw,11.5rem);font-weight:500;letter-spacing:-.09em;line-height:.7;text-transform:uppercase;white-space:nowrap;transform-origin:left center;will-change:transform,filter}.itt-field__title span{display:inline-block;will-change:transform,opacity}.itt-field__note{position:absolute;z-index:12;right:4vw;top:12%;max-width:20rem;font-size:.72rem;line-height:1.55;color:rgba(247,242,232,.5);transform:translateY(calc(var(--p,0) * -50px))}
    .itt-field__stage{position:absolute;inset:0;z-index:4}.itt-field__piece{position:absolute;overflow:hidden;background:#111;box-shadow:0 36px 90px rgba(0,0,0,.58);will-change:transform,filter,opacity;transform-origin:center;backface-visibility:hidden}.itt-field__piece video{width:100%;height:100%;display:block;object-fit:cover;filter:saturate(.92) contrast(1.08) brightness(.82);transform:scale(1.04)}
    .itt-field__piece:before{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(135deg,rgba(0,0,0,.05),transparent 45%,rgba(0,0,0,.55)),radial-gradient(circle at center,transparent 28%,rgba(0,0,0,.52) 100%)}
    .itt-field__one{left:-6vw;top:27%;width:min(58vw,760px);height:54vh;min-height:390px;clip-path:polygon(0 7%,89% 0,100% 82%,8% 100%);transform:translate3d(calc(var(--p,0) * 8vw),calc(var(--p,0) * -3vh),0) rotate(calc(-4deg + var(--p,0) * 7deg)) scale(calc(1 + var(--p,0) * .08))}
    .itt-field__two{right:6vw;top:25%;width:min(27vw,380px);height:40vh;min-height:280px;clip-path:polygon(12% 0,100% 8%,91% 100%,0 87%);transform:translate3d(calc(var(--p,0) * -7vw),calc(var(--p,0) * 10vh),0) rotate(calc(5deg - var(--p,0) * 11deg)) scale(calc(.94 + var(--p,0) * .12))}
    .itt-field__three{right:12vw;bottom:1%;width:min(44vw,610px);height:36vh;min-height:260px;clip-path:polygon(4% 18%,94% 0,100% 88%,14% 100%);transform:translate3d(calc(var(--p,0) * -10vw),calc(var(--p,0) * -12vh),0) rotate(calc(-3deg + var(--p,0) * 8deg)) scale(calc(.95 + var(--p,0) * .16))}
    .itt-field__label{position:absolute;z-index:5;left:1rem;bottom:1rem;max-width:17rem;text-shadow:0 2px 14px #000}.itt-field__label span{font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;opacity:.7}.itt-field__label h3{margin:.28rem 0 0;font-size:clamp(1.2rem,2.3vw,2.5rem);line-height:.88;text-transform:uppercase;letter-spacing:-.04em}
    .itt-field__slash{position:absolute;z-index:8;left:-10vw;top:55%;width:120vw;height:1px;background:linear-gradient(90deg,transparent,rgba(238,229,213,.85) 22%,rgba(215,181,108,.55) 52%,transparent 84%);transform:rotate(calc(-9deg + var(--p,0) * 13deg)) scaleX(calc(.45 + var(--p,0) * .8));transform-origin:center;box-shadow:0 0 18px rgba(215,181,108,.22)}
    .itt-field__ghost{position:absolute;z-index:3;left:50%;top:54%;font-family:Georgia,serif;font-style:italic;font-size:clamp(5rem,16vw,17rem);letter-spacing:-.08em;line-height:.7;color:rgba(238,229,213,.065);white-space:nowrap;transform:translate3d(calc(-50% + var(--p,0) * -8vw),calc(-50% + var(--p,0) * 7vh),0) rotate(calc(-8deg + var(--p,0) * 10deg));pointer-events:none}
    .itt-field__echo{position:absolute;z-index:2;font-size:clamp(3rem,8vw,8rem);font-weight:600;letter-spacing:-.08em;text-transform:uppercase;color:transparent;-webkit-text-stroke:1px rgba(247,242,232,.08);white-space:nowrap;pointer-events:none}.itt-field__echo--a{left:8%;bottom:8%;transform:translateX(calc(var(--p,0) * 24vw))}.itt-field__echo--b{right:-8%;top:49%;transform:translateX(calc(var(--p,0) * -22vw)) rotate(90deg)}
    .itt-field__veil{position:absolute;inset:0;z-index:10;pointer-events:none;background:linear-gradient(180deg,#050505 0,transparent 14%,transparent 83%,#050505 100%)}
    @media(max-width:900px){#IttField-{{ section.id }}{min-height:155svh}.itt-field__sticky{min-height:680px}.itt-field__head{top:6%;max-width:90vw}.itt-field__title{font-size:clamp(4rem,14vw,8rem)}.itt-field__note{top:19%;right:5%;max-width:15rem}.itt-field__one{left:-14vw;top:31%;width:78vw;height:48vh}.itt-field__two{right:-4vw;top:29%;width:38vw;height:34vh}.itt-field__three{right:-3vw;bottom:2%;width:62vw;height:31vh}}
    @media(max-width:560px){#IttField-{{ section.id }}{min-height:150svh}.itt-field__sticky{min-height:620px;padding:20px 0}.itt-field__head{left:18px;top:5%}.itt-field__kicker{font-size:.5rem}.itt-field__title{font-size:18vw;line-height:.72}.itt-field__note{left:18px;right:auto;top:20%;max-width:72%;font-size:.64rem}.itt-field__one{left:-25vw;top:31%;width:104vw;height:44vh;min-height:300px}.itt-field__two{right:-13vw;top:31%;width:53vw;height:28vh;min-height:210px}.itt-field__three{right:-18vw;bottom:3%;width:82vw;height:29vh;min-height:220px}.itt-field__label{left:.8rem;bottom:.75rem}.itt-field__label h3{font-size:1.1rem}.itt-field__ghost{font-size:24vw}.itt-field__echo{font-size:16vw}}
    @media(prefers-reduced-motion:reduce){#IttField-{{ section.id }}{min-height:auto}.itt-field__sticky{position:relative;height:auto;min-height:900px}.itt-field__piece,.itt-field__title,.itt-field__ghost,.itt-field__note,.itt-field__slash{transform:none!important}}
  </style>
  <div class="itt-field__sticky">
    <div class="itt-field__grain"></div><div class="itt-field__veil"></div>
    <div class="itt-field__head"><div class="itt-field__kicker">MAISON · DÉTROIT — EAST SIDE / PROCESS AS IMAGE</div><h2 class="itt-field__title" aria-label="The work leaks through"><span>THE</span> <span>WORK</span><br><span>LEAKS</span> <span>THROUGH.</span></h2></div>
    <p class="itt-field__note">The house does not sit still. Process, garment and machine collide as you move through it.</p>
    <div class="itt-field__stage">
      <div class="itt-field__ghost">made / worn / altered</div><div class="itt-field__echo itt-field__echo--a">ITTOLDEM / PROCESS</div><div class="itt-field__echo itt-field__echo--b">ONE OF ONE</div><div class="itt-field__slash"></div>
      <article class="itt-field__piece itt-field__one"><video autoplay muted loop playsinline preload="auto" src="https://cdn.shopify.com/videos/c/o/v/87040c4ea6db4c80927dc1f729b4444f.mov"></video><div class="itt-field__label"><span>01 / BODY</span><h3>THE GARMENT MOVES FIRST.</h3></div></article>
      <article class="itt-field__piece itt-field__two"><video autoplay muted loop playsinline preload="auto" src="https://cdn.shopify.com/videos/c/o/v/829da22df9ae4c89ad7479a2440de5fe.mov"></video><div class="itt-field__label"><span>02 / SURFACE</span><h3>PRINT BECOMES RELIEF.</h3></div></article>
      <article class="itt-field__piece itt-field__three"><video autoplay muted loop playsinline preload="auto" src="https://cdn.shopify.com/videos/c/o/v/cbb48a13846a47ed964d127d0d92947c.mov"></video><div class="itt-field__label"><span>03 / MACHINE</span><h3>PATTERN CUTS INTO MATERIAL.</h3></div></article>
    </div>
  </div>
  <script>(()=>{const root=document.getElementById('IttField-{{ section.id }}');if(!root)return;const sticky=root.querySelector('.itt-field__sticky');const title=[...root.querySelectorAll('.itt-field__title span')];const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;root.querySelectorAll('video').forEach(v=>{v.muted=true;v.defaultMuted=true;v.playsInline=true;const play=()=>v.play().catch(()=>{});if(v.readyState>=2)play();else v.addEventListener('canplay',play,{once:true})});if(reduced)return;let ticking=false;const draw=()=>{const r=root.getBoundingClientRect();const max=Math.max(1,root.offsetHeight-innerHeight);const p=Math.max(0,Math.min(1,-r.top/max));sticky.style.setProperty('--p',p.toFixed(4));title.forEach((s,i)=>{const x=(i%2?1:-1)*p*(18+i*8);const y=p*(i*5);const rot=(i%2?1:-1)*p*(2+i*.7);s.style.transform=`translate3d(${x}px,${y}px,0) rotate(${rot}deg)`;s.style.opacity=String(1-p*.12)});ticking=false};const on=()=>{if(!ticking){requestAnimationFrame(draw);ticking=true}};addEventListener('scroll',on,{passive:true});addEventListener('resize',on,{passive:true});draw()})();</script>
</section>
