    <div class="itt-hero__content">
      <div class="itt-systemline"><span>PROVERBS 16:3</span><span>COMMIT THY WORKS.</span></div>
      <div class="itt-kicker">MAISON · DÉTROIT — EAST SIDE</div>
      <h1 class="itt-display itt-hero__title">ENTER<br>THE<br>HOUSE.</h1>
      <p class="itt-hero__sub">“Write the vision, and make it plain.” · Habakkuk 2:2</p>
      <div class="itt-hero__actions">
        <a class="itt-btn itt-btn--solid" href="#itt-worlds">SELECT A WORLD <span class="itt-arrow">↓</span></a>
        <a class="itt-textlink" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}">ENTER STORE <span class="itt-arrow">→</span></a>
      </div>
    </div>
    <div class="itt-script">“Commit thy works<br>unto the Lord.”<small>PROVERBS 16:3</small></div>
    <div class="itt-hero__index">ECCLESIASTES 9:10 · WITH THY MIGHT</div>
  </div>

  <nav class="itt-command" aria-label="House worlds">
    <a href="#itt-worlds"><b>01</b><span>WORLDS</span></a>
    <a href="{{ section.settings.category_link_1 | default: routes.all_products_collection_url }}"><b>02</b><span>STORE</span></a>
    <a href="{{ section.settings.gvo_link | default: routes.all_products_collection_url }}"><b>03</b><span>SPORT</span></a>
    <a href="{{ section.settings.lab_link | default: routes.all_products_collection_url }}"><b>04</b><span>LAB</span></a>
    <a href="{{ section.settings.story_link | default: routes.root_url }}"><b>05</b><span>HOUSE FILE</span></a>
  </nav>

  <div class="itt-marquee" aria-hidden="true">
    <div class="itt-marquee__track">
      <span>5E · WRITE THE VISION · MAISON DÉTROIT · ITT TOLD’EM · COMMIT THY WORKS ·</span>
      <span>5E · WRITE THE VISION · MAISON DÉTROIT · ITT TOLD’EM · COMMIT THY WORKS ·</span>
    </div>
  </div>

  <div class="itt-world-intro" id="itt-worlds">
