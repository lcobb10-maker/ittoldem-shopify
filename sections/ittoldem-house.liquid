      <source src="https://cdn.shopify.com/videos/c/vp/ccf55ce803e54a2ea550225b2635dfab/ccf55ce803e54a2ea550225b2635dfab.HD-1080p-7.2Mbps-93972433.mp4" type="video/mp4">
    </video>
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2400 | image_tag: class: 'itt-hero__media itt-hero__fallback', loading: 'eager', fetchpriority: 'high', alt: "ITT TOLD’EM campaign" }}
    {% endif %}

    <div class="itt-code-rain" aria-hidden="true">
      <span class="itt-code itt-code--1">5E<br>ITT<br>05<br>DET<br>5E<br>22:2</span>
      <span class="itt-code itt-code--2">5E<br>16:3<br>ITT<br>5E<br>LAB<br>DET</span>
      <span class="itt-code itt-code--3">22:1<br>5E<br>ITT<br>05<br>5E<br>EAST</span>
      <span class="itt-code itt-code--4">ITT<br>5E<br>35:35<br>LAB<br>5E<br>05</span>
      <span class="itt-code itt-code--5">5E<br>DET<br>ITT<br>9:10<br>5E<br>HOUSE</span>
      <span class="itt-code itt-code--6">05<br>5E<br>ITT<br>27:17<br>5E<br>LAB</span>
      <span class="itt-code itt-code--7">5E<br>EAST<br>16:3<br>ITT<br>05<br>5E</span>
      <span class="itt-code itt-code--8">ITT<br>5E<br>22:2<br>DET<br>5E<br>05</span>
    </div>
    <div class="itt-scan" aria-hidden="true"></div>

